-- 25_tuples.pk64
-- Demonstrates: tuple types, tuple literals, tuple element access (.0, .1),
-- functions returning tuples, storing different tuple types.
-- Status: [PARTIAL] — tuple types are parsed and code-generated.

-- Function returning a tuple of (min, max)
fn min_max(a: i32, b: i32) -> (i32, i32) {
    if a < b {
        return (a, b)
    }
    return (b, a)
}

-- Function returning a tuple of (quotient, remainder)
fn div_rem(a: i32, b: i32) -> (i32, i32) {
    let q: i32 = a / b
    let r: i32 = a - (q * b)
    return (q, r)
}

-- Function taking a tuple parameter and returning its sum
fn pair_sum(t: (i32, i32)) -> i32 {
    return t.0 + t.1
}

static sink_i: i32 = 0
static sink_f: f32 = 0.0

entry {
    -- Tuple literal: two-element (i32, f32)
    let t: (i32, f32) = (42, 3.14)
    sink_i = t.0              -- 42
    sink_f = t.1              -- 3.14

    -- Tuple literal: (bool, i32)
    let flag_pair: (bool, i32) = (true, 7)
    sink_i = flag_pair.1      -- 7

    -- Function returning a tuple
    let bounds = min_max(15, 3)
    sink_i = bounds.0         -- 3  (min)
    sink_i = bounds.1         -- 15 (max)

    -- Explicit type annotation on returned tuple
    let mm: (i32, i32) = min_max(100, 200)
    sink_i = mm.0             -- 100
    sink_i = mm.1             -- 200

    -- div_rem example
    let dr = div_rem(17, 5)
    sink_i = dr.0             -- 3 (quotient)
    sink_i = dr.1             -- 2 (remainder)

    -- Pass tuple to a function
    let p: (i32, i32) = (10, 32)
    sink_i = pair_sum(p)      -- 42

    -- Nested access — element of a tuple stored in a let
    let result = min_max(99, 1)
    let lo = result.0
    let hi = result.1
    sink_i = hi - lo          -- 98
}
