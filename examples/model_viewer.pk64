-- model_viewer.pk64
-- A Tiny3D model on a turntable: load a .t3dm, spin it with the stick.
--
-- Tiny3D is RSP microcode, so this is a libdragon-backend program. `pak check
-- --backend mips` reports E010 on every t3d.* call: the standalone HAL has no
-- 3D pipeline. Build it with the default backend.

use n64.display
use n64.controller
use n64.rdpq
use n64.timer
use t3d

asset character_model: Model from "character.t3dm"

entry {
    display.init(0, 2, 3, 0, 1)
    rdpq.init()
    controller.init()
    timer.init()
    t3d.init()

    -- The viewport carries the projection and the camera, so it is built once
    -- and reused; t3d.viewport_create takes no arguments and the projection is
    -- set separately.
    let mut viewport = t3d.viewport_create()
    t3d.viewport_set_projection(&viewport, 70.0, 1.0, 200.0)

    let mut eye: Vec3 = Vec3 { x: 0.0, y: 25.0, z: -50.0 }
    let mut target: Vec3 = Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    let mut up: Vec3 = Vec3 { x: 0.0, y: 1.0, z: 0.0 }

    -- The RSP reads the matrix by DMA, so it is 16-byte aligned and lives in
    -- its fixed-point form.
    @aligned(16)
    let mut model_mat: Mat4 = undefined

    let mut rotation: f32 = 0.0

    loop {
        controller.poll()
        let input = controller.read(0)
        let dt: f32 = timer.delta()

        rotation = rotation + (input.stick_x as f32) * 2.0 * dt

        t3d.mat4_identity(&model_mat)
        t3d.mat4_rotate_y(&model_mat, rotation)

        let disp = display.get()
        rdpq.attach_clear(disp, 0x101828FF)

        t3d.frame_start()
        t3d.viewport_attach(&viewport)
        t3d.look_at(&viewport, &eye, &target, &up)

        t3d.light_set_count(1)
        t3d.light_set_ambient(40, 40, 50)
        t3d.light_set_directional(0, 255, 255, 255, 1.0, 1.0, 1.0)

        t3d.model_draw(character_model)
        t3d.frame_end()

        rdpq.detach_show()
    }
}
