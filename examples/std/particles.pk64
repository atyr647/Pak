-- particles.pk64
-- Self-contained fixed-capacity particle system for Pak games.
--
-- A ParticleSystem owns a flat [MAX_PARTICLES]Particle pool plus a live count.
-- This is a manual pool: there is no heap allocation, which suits the N64. spawn()
-- appends a particle with a randomized velocity spread (via math.rand_f), update()
-- advances every live particle and ages it, and compact() removes dead particles
-- by swapping the last live one into the freed slot (order is not preserved, which
-- is fine for visual effects).
--
-- The Vec3 here is redeclared locally so this file checks standalone; it is
-- field-compatible with vec.pk64's Vec3.
--
-- Usage:
--     let mut ps = particles_new()
--     spawn(&mut ps, Vec3 { x: 0.0, y: 0.0, z: 0.0 }, Vec3 { x: 0.0, y: 5.0, z: 0.0 }, 2.0, 3.0)
--     update(&mut ps, 0.016)
--     compact(&mut ps)

use n64.math

const MAX_PARTICLES: i32 = 256

struct Vec3 {
    x: f32
    y: f32
    z: f32
}

struct Particle {
    pos: Vec3
    vel: Vec3
    life: f32      -- seconds of life remaining; <= 0 means dead
    age: f32       -- seconds elapsed since spawn (handy for fading)
}

struct ParticleSystem {
    pool: [256]Particle
    count: i32
}

-- Start an empty system.
fn particles_new() -> ParticleSystem {
    return ParticleSystem {
        pool: undefined,
        count: 0,
    }
}

-- Random value in [-spread, spread].
fn rand_spread(spread: f32) -> f32 {
    return (math.rand_f() * 2.0 - 1.0) * spread
}

-- Emit one particle at pos with base velocity, randomly perturbed by `spread`
-- on each axis. life is its lifetime in seconds. Returns false if the pool is
-- full (the particle is dropped).
fn spawn(ps: *mut ParticleSystem, pos: Vec3, vel: Vec3, spread: f32, life: f32) -> bool {
    if ps.count >= MAX_PARTICLES {
        return false
    }
    let idx = ps.count
    ps.pool[idx] = Particle {
        pos: pos,
        vel: Vec3 {
            x: vel.x + rand_spread(spread),
            y: vel.y + rand_spread(spread),
            z: vel.z + rand_spread(spread),
        },
        life: life,
        age: 0.0,
    }
    ps.count += 1
    return true
}

-- Advance every live particle: move by velocity, age it, and tick its life down.
-- Dead particles are left in place for compact() to reclaim.
fn update(ps: *mut ParticleSystem, dt: f32) {
    let mut i: i32 = 0
    while i < ps.count {
        ps.pool[i].pos.x += ps.pool[i].vel.x * dt
        ps.pool[i].pos.y += ps.pool[i].vel.y * dt
        ps.pool[i].pos.z += ps.pool[i].vel.z * dt
        ps.pool[i].age += dt
        ps.pool[i].life -= dt
        i += 1
    }
}

-- Remove dead particles (life <= 0) by swapping the last live particle into each
-- freed slot, then shrinking the count. O(n), no allocation, order not preserved.
fn compact(ps: *mut ParticleSystem) {
    let mut i: i32 = 0
    while i < ps.count {
        if ps.pool[i].life <= 0.0 {
            let last = ps.count - 1
            ps.pool[i] = ps.pool[last]
            ps.count -= 1
        } else {
            i += 1
        }
    }
}

-- Number of currently live particles.
fn particles_count(ps: *ParticleSystem) -> i32 {
    return ps.count
}

static sink_i: i32 = 0
static sink_f: f32 = 0.0

-- Usage demo / self-test. A library file with free functions needs an entry
-- block to satisfy `pak check`; delete it when you `use` this as a module.
entry {
    math.rand_seed(1)
    let mut ps = particles_new()

    let origin = Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    let up = Vec3 { x: 0.0, y: 5.0, z: 0.0 }

    let mut n: i32 = 0
    while n < 16 {
        sink_i = spawn(&mut ps, origin, up, 2.0, 1.0) as i32
        n += 1
    }

    update(&mut ps, 0.5)
    update(&mut ps, 0.6)   -- pushes life negative for the 1.0s particles
    compact(&mut ps)

    sink_i = particles_count(&ps)
    sink_f = ps.pool[0].pos.y
}
