-- pak/runtime/runtime.pk64 — N64 runtime HAL, written entirely in Pak.
--
-- Replaces the C runtime (vi.c, pak_hal.c) so a ROM can be built with no
-- external MIPS toolchain: this file is compiled by the Pak MIPS backend,
-- assembled by tcl/n64enc.tcl, and linked by pak/tools/n64_link.py.
--
-- Free functions emit bare symbol names (display_init, rdpq_fill_rectangle,
-- memset, ...) matching the calls the codegen lowers game code into.
--
-- Framebuffers live in uncached RDRAM (KSEG1, 0xA02.....) so CPU writes are
-- immediately visible to the Video Interface with no cache writeback.

-- ── VI registers (uncached MMIO) ──────────────────────────────────────────
const VI_CTRL: u32      = 0xA4400000
const VI_ORIGIN: u32    = 0xA4400004
const VI_WIDTH: u32     = 0xA4400008
const VI_V_INTR: u32    = 0xA440000C
const VI_V_CURRENT: u32 = 0xA4400010
const VI_BURST: u32     = 0xA4400014
const VI_V_SYNC: u32    = 0xA4400018
const VI_H_SYNC: u32    = 0xA440001C
const VI_LEAP: u32      = 0xA4400020
const VI_H_START: u32   = 0xA4400024
const VI_V_START: u32   = 0xA4400028
const VI_V_BURST: u32   = 0xA440002C
const VI_X_SCALE: u32   = 0xA4400030
const VI_Y_SCALE: u32   = 0xA4400034

-- ── MI (MIPS Interface): the RCP's interrupt controller ───────────────────
-- MI_INTERRUPT reads which of the six RCP sources is asserting. MI_MASK is
-- write-only and takes a pair of bits per source -- clear then set -- so
-- enabling one source never disturbs the others.
const MI_MODE: u32      = 0xA4300000
const MI_INTERRUPT: u32 = 0xA4300008
const MI_MASK: u32      = 0xA430000C

const MI_INTR_SP: u32 = 0x01
const MI_INTR_SI: u32 = 0x02
const MI_INTR_AI: u32 = 0x04
const MI_INTR_VI: u32 = 0x08
const MI_INTR_PI: u32 = 0x10
const MI_INTR_DP: u32 = 0x20

const MI_MASK_SET_VI: u32   = 0x0080
const MI_MASK_CLEAR_VI: u32 = 0x0040
const MI_MASK_SET_AI: u32   = 0x0020
const MI_MASK_SET_PI: u32   = 0x0200
const MI_MASK_SET_SI: u32   = 0x0008
const MI_MASK_SET_DP: u32   = 0x0800
const MI_MASK_CLEAR_ALL: u32 = 0x0555

-- ── SP (RSP) registers ────────────────────────────────────────────────────
-- SP_MEM_ADDR names a location inside the RSP's own 8 KiB: bit 12 picks IMEM
-- (1) over DMEM (0), bits 11..0 the offset. RD_LEN moves RDRAM -> SP and
-- WR_LEN moves SP -> RDRAM, both taking length-1 and both requiring the two
-- addresses and the length to be 8-byte aligned.
const SP_MEM_ADDR:  u32 = 0xA4040000
const SP_DRAM_ADDR: u32 = 0xA4040004
const SP_RD_LEN:    u32 = 0xA4040008
const SP_WR_LEN:    u32 = 0xA404000C
const SP_STATUS:    u32 = 0xA4040010
const SP_DMA_FULL:  u32 = 0xA4040014
const SP_DMA_BUSY:  u32 = 0xA4040018
const SP_SEMAPHORE: u32 = 0xA404001C
const SP_PC:        u32 = 0xA4080000

const SP_IMEM: u32 = 0x1000       -- SP_MEM_ADDR bit 12

-- SP_STATUS reads one set of bits and writes another. Reading: bit 0 halted,
-- bit 1 broke, bit 2 DMA busy, bit 3 DMA full. Writing: each control is a
-- clear/set pair, so touching one never disturbs another.
const SP_ST_HALT:      u32 = 0x0001
const SP_ST_BROKE:     u32 = 0x0002
const SP_ST_DMA_BUSY:  u32 = 0x0004
const SP_ST_DMA_FULL:  u32 = 0x0008

const SP_SET_CLR_HALT:     u32 = 0x00001
const SP_SET_SET_HALT:     u32 = 0x00002
const SP_SET_CLR_BROKE:    u32 = 0x00004
const SP_SET_CLR_INTR:     u32 = 0x00008
const SP_SET_CLR_SSTEP:    u32 = 0x00020
const SP_SET_CLR_INTBRK:   u32 = 0x00080
const SP_SET_SET_INTBRK:   u32 = 0x00100

-- The halfline VI_V_INTR fires at. vi_program parks it at 0x200, past the end
-- of the frame, so a ROM that never calls interrupt.init sees no interrupts at
-- all. 0x200 is also what a game sets it back to in order to turn VI
-- interrupts off without touching the MI mask.
const VI_INTR_OFF: u32  = 0x00000200
const VI_INTR_LINE: u32 = 0x00000002

const VI_CTRL_BLANK: u32 = 0x00000000
const VI_CTRL_16BPP: u32 = 0x00003202   -- 16bpp RGBA5551, AA off, non-interlaced

-- ── Framebuffers (uncached KSEG1; phys = addr & 0x00FFFFFF) ────────────────
-- 320 x 240 x 2 bytes = 153600 (0x25800) bytes each.
const SCREEN_W: i32  = 320
const SCREEN_H: i32  = 240
const FB_PIXELS: i32 = 76800            -- 320 * 240
const FB0: u32 = 0xA0200000
const FB1: u32 = 0xA0225800
const FB2: u32 = 0xA024B000
const ZB:  u32 = 0xA0271000        -- 320×240×16-bit Z, after FB2
const MAX_BUFS: i32 = 3        -- FB0..FB2; the map has room for no more

static g_draw: i32       = 1
static g_shown: i32      = 0
-- How many of FB0..FB2 display.init asked for. 3 until it says otherwise.
static g_nbufs: i32      = 3
-- The VI_CTRL word display.init assembled from its gamma/filters arguments.
static g_vi_ctrl: u32    = 0x00003202

-- ── interrupt state ───────────────────────────────────────────────────────
-- Bumped by the VI interrupt, once per frame. vi_wait_vblank watches it
-- instead of polling VI_V_CURRENT once interrupts are running, which is the
-- difference between a spin loop that owns the CPU and one that does not.
static g_vi_count: u32   = 0
static g_irq_on: i32     = 0
-- Sources seen since interrupt.init, so a ROM can tell "the ISR never ran"
-- from "the ISR ran and it was not the VI".
static g_irq_seen: u32   = 0
-- The MI sources interrupt.init armed. MI_INTERRUPT reports every source that
-- is asserting, masked or not, so the handler filters by this rather than
-- acknowledging -- and so discarding -- a flag nobody asked it to touch.
static g_irq_mask: u32   = 0

-- ── CP0, which Pak cannot name ─────────────────────────────────────────────
-- Status.IE and Status.IM2 live in a coprocessor register, and there is no
-- syntax for mfc0/mtc0. runtime/standalone/boot.S provides these three; they
-- are part of the standalone HAL, not libdragon.
extern "C" {
    fn __pak_irq_enable()
    fn __pak_irq_disable() -> u32
    fn __pak_irq_restore(status: u32)
}

-- ── MMIO helpers ───────────────────────────────────────────────────────────
fn vi_write(reg: u32, val: u32) {
    let p: *volatile u32 = reg as *volatile u32
    *p = val
}

fn vi_read(reg: u32) -> u32 {
    let p: *volatile u32 = reg as *volatile u32
    return *p
}

fn fb_addr(idx: i32) -> u32 {
    if idx == 0 { return FB0 }
    if idx == 1 { return FB1 }
    return FB2
}

-- RGBA8888 -> RGBA5551 (matches the C runtime's color32_to_16).
fn color32_to_16(c: u32) -> u16 {
    let r5: u32 = (c >> 27) & 0x1F
    let g5: u32 = (c >> 19) & 0x1F
    let b5: u32 = (c >> 11) & 0x1F
    return ((r5 << 11) | (g5 << 6) | (b5 << 1) | 1) as u16
}

fn fb_fill(base: u32, px: u16) {
    let mut i: i32 = 0
    while i < FB_PIXELS {
        let p: *volatile u16 = (base + (i * 2) as u32) as *volatile u16
        *p = px
        i = i + 1
    }
}

-- RGBA5551 crash fill: full red, alpha 1. Visible against a black hang.
const CRASH_RED: u16 = 0xF801

-- ── VI core ────────────────────────────────────────────────────────────────
-- Register program only. Used by vi_init (then black-fill) and by
-- exception_paint (then red-fill) so a crash before display.init still shows.
fn vi_program() {
    vi_write(VI_CTRL,    VI_CTRL_BLANK)
    vi_write(VI_ORIGIN,  FB0 & 0x00FFFFFF)
    vi_write(VI_WIDTH,   SCREEN_W as u32)
    vi_write(VI_V_INTR,  0x00000200)
    vi_write(VI_V_CURRENT, 0x00000000)
    vi_write(VI_BURST,   0x03E52239)
    vi_write(VI_V_SYNC,  0x0000020D)
    vi_write(VI_H_SYNC,  0x00000C15)
    vi_write(VI_LEAP,    0x0C150C15)
    vi_write(VI_H_START, 0x006C02EC)
    vi_write(VI_V_START, 0x002501FF)
    vi_write(VI_V_BURST, 0x000E0204)
    vi_write(VI_X_SCALE, 0x00000200)
    vi_write(VI_Y_SCALE, 0x00000400)
    vi_write(VI_CTRL,    g_vi_ctrl)
}

fn vi_init() {
    vi_program()
    fb_fill(FB0, 0x0000 as u16)
    if g_nbufs > 1 { fb_fill(FB1, 0x0000 as u16) }
    if g_nbufs > 2 { fb_fill(FB2, 0x0000 as u16) }
}

fn vi_wait_vblank() {
    if g_irq_on != 0 {
        -- Interrupt-driven: sit on the counter the ISR bumps. The read has to
        -- happen each time round rather than once into a local, or the
        -- optimizer is free to hoist it and the loop never ends.
        let start: u32 = g_vi_count
        loop {
            if g_vi_count != start { break }
        }
        return
    }
    -- No interrupts: poll. Wait until past the active region (line >= 480),
    -- then for the new frame.
    loop {
        let line: u32 = vi_read(VI_V_CURRENT) & 0x3FF
        if line >= 0x1E0 { break }
    }
    loop {
        let line: u32 = vi_read(VI_V_CURRENT) & 0x3FF
        if line < 0x1E0 { break }
    }
}

fn vi_show(fb: u32) {
    vi_wait_vblank()
    vi_write(VI_ORIGIN, fb & 0x00FFFFFF)
    -- Advance the draw index, skipping the buffer now on screen.
    if fb == FB0 { g_shown = 0 }
    elif fb == FB1 { g_shown = 1 }
    else { g_shown = 2 }
    g_draw = (g_shown + 1) % g_nbufs
}

-- ── display API (called by generated game code) ────────────────────────────
-- VI_CTRL fields. aa_mode lives in bits 8-9, the gamma pair in bits 2-3, and
-- the dither filter in bit 16. pixel_advance (bits 12-15) is 3 for RDRAM.
const VI_CTRL_BASE: u32       = 0x00003000   -- pixel_advance = 3
const VI_CTRL_TYPE_16BPP: u32 = 0x00000002
const VI_CTRL_GAMMA: u32      = 0x00000008
const VI_CTRL_GAMMA_DITHER: u32 = 0x00000004
const VI_CTRL_DITHER_FILTER: u32 = 0x00010000

-- filters -> aa_mode. 0 = AA + resample always fetch, 1 = AA + resample fetch
-- when needed, 2 = resample only, 3 = neither (replicate pixels).
fn vi_aa_mode(filters: i32) -> u32 {
    if filters == 0 { return 3 }        -- FILTERS_DISABLED
    if filters == 1 { return 2 }        -- FILTERS_RESAMPLE
    if filters == 2 { return 3 }        -- FILTERS_DEDITHER
    if filters == 3 { return 1 }        -- FILTERS_RESAMPLE_ANTIALIAS
    return 0                            -- ..._ANTIALIAS_DEDITHER
}

-- The standalone HAL carves three fixed 320x240x16 framebuffers out of RDRAM
-- (FB0..FB2, then the Z buffer and the display list). Another resolution or
-- bit depth would move every one of those addresses, so it is refused rather
-- than silently ignored -- rendering a 640x480 scene into a 320x240 buffer
-- produces garbage that looks like a game bug.
fn display_init(res: i32, bpp: i32, bufs: i32, gamma: i32, filters: i32) {
    if res != 0 { __pak_panic() }
    if bpp != 2 { __pak_panic() }
    if bufs < 1 or bufs > MAX_BUFS { __pak_panic() }

    g_nbufs = bufs
    -- Draw into the buffer the VI is not showing. With one buffer there is no
    -- other one, so drawing and scanout share it.
    g_shown = 0
    g_draw  = 0
    if bufs > 1 { g_draw = 1 }

    let mut ctrl: u32 = VI_CTRL_BASE | VI_CTRL_TYPE_16BPP
    ctrl = ctrl | (vi_aa_mode(filters) << 8)
    if filters == 2 or filters == 4 { ctrl = ctrl | VI_CTRL_DITHER_FILTER }
    if gamma != 0 { ctrl = ctrl | VI_CTRL_GAMMA }
    if gamma >= 2 { ctrl = ctrl | VI_CTRL_GAMMA_DITHER }
    g_vi_ctrl = ctrl

    vi_init()
}

fn display_get() -> u32 {
    return fb_addr(g_draw)
}

fn display_show(fb: u32) {
    vi_show(fb)
}

fn display_close() {
}

-- ── SI (Serial Interface) controller ─────────────────────────────────────────
const SI_DRAM_ADDR:      u32 = 0xA4800000
const SI_PIF_ADDR_RD64B: u32 = 0xA4800004
-- SI_STATUS is at 0x04800018. 0x0480000C is a reserved register that reads
-- back zero, so si_wait() returned immediately and every Joybus transaction --
-- controller polling and EEPROM alike -- raced the SI instead of waiting for
-- it. ares' PIF is strict enough to notice; mupen64plus was not.
const SI_STATUS:         u32 = 0xA4800018
const SI_PIF_ADDR_WR64B: u32 = 0xA4800010
const PIF_RAM_PHYS:      u32 = 0x1FC007C0

-- PIF command buffer: 64 bytes, 16-byte aligned so DMA is valid (E202).
static g_pif_buf: [64]u8 @aligned(16)

fn pif_addr() -> u32 {
    return &g_pif_buf as u32
}

-- Byte poke/peek through a u32 address. Used when the destination is a
-- computed offset (EEPROM payload copy), not a static array index.
fn poke8(addr: u32, val: u32) {
    let p: *volatile u8 = addr as *volatile u8
    *p = val as u8
}

fn peek8(addr: u32) -> u32 {
    let p: *volatile u8 = addr as *volatile u8
    return (*p) as u32
}

fn pif_zero() {
    let mut i: i32 = 0
    while i < 64 {
        g_pif_buf[i] = 0
        i = i + 1
    }
}

-- Button + controller state for port 0.
struct ButtonState {
    a:      bool
    b:      bool
    z:      bool
    start:  bool
    up:     bool
    down:   bool
    left:   bool
    right:  bool
    l:      bool
    r:      bool
    c_up:   bool
    c_down: bool
    c_left: bool
    c_right: bool
}

struct ControllerState {
    held:     *ButtonState
    pressed:  *ButtonState
    released: *ButtonState
    stick_x:  i32
    stick_y:  i32
}

-- One block per port. controller.read is documented for ports 0-3, so all
-- four are polled and all four have their own state; the HAL used to poll
-- channel 0 only and hand every port port 0's buttons.
static g_held_0:     ButtonState
static g_pressed_0:  ButtonState
static g_released_0: ButtonState
static g_cs_0:       ControllerState
static g_held_1:     ButtonState
static g_pressed_1:  ButtonState
static g_released_1: ButtonState
static g_cs_1:       ControllerState
static g_held_2:     ButtonState
static g_pressed_2:  ButtonState
static g_released_2: ButtonState
static g_cs_2:       ControllerState
static g_held_3:     ButtonState
static g_pressed_3:  ButtonState
static g_released_3: ButtonState
static g_cs_3:       ControllerState

-- D-cache helpers — inline asm uses $a0/$a1 directly (avoids the parameter
-- save/load offset bug; prologue does not clobber argument registers).
fn data_cache_hit_writeback(ptr: *u8, sz: i32) {
    asm {
        ".Ldcwb_1:"
        "cache 0x19, 0($a0)"
        "addiu $a0, $a0, 16"
        "addiu $a1, $a1, -16"
        "bgtz $a1, .Ldcwb_1"
        "nop"
        "sync"
    }
}

-- Hit_Invalidate_D is (4 << 2) | 1 = 0x11. 0x14 is (5 << 2) | 0 --
-- Hit_Writeback_Invalidate on the INSTRUCTION cache -- so this invalidated
-- nothing in the D-cache and every DMA destination kept reading whatever the
-- CPU had cached: dma.read, EEPROM reads, controller polling, SP reads.
fn data_cache_hit_invalidate(ptr: *u8, sz: i32) {
    asm {
        ".Ldciv_1:"
        "cache 0x11, 0($a0)"
        "addiu $a0, $a0, 16"
        "addiu $a1, $a1, -16"
        "bgtz $a1, .Ldciv_1"
        "nop"
    }
}

fn si_wait() {
    loop {
        let p: *volatile u32 = SI_STATUS as *volatile u32
        let v: u32 = *p
        if (v & 3) == 0 { break }
    }
}

-- Write g_pif_buf to PIF RAM, run the transaction, read the 64-byte response
-- back. Caller has already filled the command bytes. EEPROM and the joypad
-- both talk Joybus over the SI; they share this path and g_pif_buf.
fn si_exec() {
    let b: u32 = pif_addr()
    data_cache_hit_writeback(b as *u8, 64)
    let phys: u32 = b & 0x1FFFFFFF
    let p_dram: *volatile u32 = SI_DRAM_ADDR      as *volatile u32; *p_dram = phys
    let p_wr:   *volatile u32 = SI_PIF_ADDR_WR64B as *volatile u32; *p_wr   = PIF_RAM_PHYS
    si_wait()
    let p_rd: *volatile u32 = SI_PIF_ADDR_RD64B as *volatile u32; *p_rd = PIF_RAM_PHYS
    si_wait()
    data_cache_hit_invalidate(b as *u8, 64)
}

-- Per-port state block addresses. Four separate statics rather than an array
-- so each address stays a link-time constant.
fn held_addr(port: i32) -> u32 {
    if port == 1 { return &g_held_1 as u32 }
    if port == 2 { return &g_held_2 as u32 }
    if port == 3 { return &g_held_3 as u32 }
    return &g_held_0 as u32
}

fn pressed_addr(port: i32) -> u32 {
    if port == 1 { return &g_pressed_1 as u32 }
    if port == 2 { return &g_pressed_2 as u32 }
    if port == 3 { return &g_pressed_3 as u32 }
    return &g_pressed_0 as u32
}

fn released_addr(port: i32) -> u32 {
    if port == 1 { return &g_released_1 as u32 }
    if port == 2 { return &g_released_2 as u32 }
    if port == 3 { return &g_released_3 as u32 }
    return &g_released_0 as u32
}

fn cs_addr(port: i32) -> u32 {
    if port == 1 { return &g_cs_1 as u32 }
    if port == 2 { return &g_cs_2 as u32 }
    if port == 3 { return &g_cs_3 as u32 }
    return &g_cs_0 as u32
}

-- Point each port's ControllerState at its own three button blocks. Indexed
-- as *u32 (element size 4, which is what the pointer fields are).
fn joypad_init() {
    let mut p: i32 = 0
    while p < 4 {
        let cs: *u32 = cs_addr(p) as *u32
        cs[0] = held_addr(p)
        cs[1] = pressed_addr(p)
        cs[2] = released_addr(p)
        p = p + 1
    }
}

-- Fold one port's PIF response into its held/pressed/released blocks.
-- `cur` is the 16-bit button word; sx/sy are the already-signed stick axes.
fn joypad_store(port: i32, cur: u32, sx: i32, sy: i32) {
    let hb: u32 = held_addr(port)

    -- Read previous held state per-button (each field = one bool byte, 0 or 1).
    let prev_a:     u32 = (*((hb + 0)  as *volatile u8)) as u32
    let prev_b:     u32 = (*((hb + 1)  as *volatile u8)) as u32
    let prev_z:     u32 = (*((hb + 2)  as *volatile u8)) as u32
    let prev_start: u32 = (*((hb + 3)  as *volatile u8)) as u32
    let prev_up:    u32 = (*((hb + 4)  as *volatile u8)) as u32
    let prev_down:  u32 = (*((hb + 5)  as *volatile u8)) as u32
    let prev_left:  u32 = (*((hb + 6)  as *volatile u8)) as u32
    let prev_right: u32 = (*((hb + 7)  as *volatile u8)) as u32
    let prev_l:     u32 = (*((hb + 8)  as *volatile u8)) as u32
    let prev_r:     u32 = (*((hb + 9)  as *volatile u8)) as u32
    let prev_cup:   u32 = (*((hb + 10) as *volatile u8)) as u32
    let prev_cdn:   u32 = (*((hb + 11) as *volatile u8)) as u32
    let prev_clt:   u32 = (*((hb + 12) as *volatile u8)) as u32
    let prev_crt:   u32 = (*((hb + 13) as *volatile u8)) as u32

    -- Extract current button states as 0/1 values.
    let cur_a:     u32 = ((cur & 0x8000) != 0) as u32
    let cur_b:     u32 = ((cur & 0x4000) != 0) as u32
    let cur_z:     u32 = ((cur & 0x2000) != 0) as u32
    let cur_start: u32 = ((cur & 0x1000) != 0) as u32
    let cur_up:    u32 = ((cur & 0x0800) != 0) as u32
    let cur_down:  u32 = ((cur & 0x0400) != 0) as u32
    let cur_left:  u32 = ((cur & 0x0200) != 0) as u32
    let cur_right: u32 = ((cur & 0x0100) != 0) as u32
    let cur_l:     u32 = ((cur & 0x0020) != 0) as u32
    let cur_r:     u32 = ((cur & 0x0010) != 0) as u32
    let cur_cup:   u32 = ((cur & 0x0008) != 0) as u32
    let cur_cdn:   u32 = ((cur & 0x0004) != 0) as u32
    let cur_clt:   u32 = ((cur & 0x0002) != 0) as u32
    let cur_crt:   u32 = ((cur & 0x0001) != 0) as u32

    -- Write held.
    *((hb + 0)  as *volatile u8) = cur_a     as u8
    *((hb + 1)  as *volatile u8) = cur_b     as u8
    *((hb + 2)  as *volatile u8) = cur_z     as u8
    *((hb + 3)  as *volatile u8) = cur_start as u8
    *((hb + 4)  as *volatile u8) = cur_up    as u8
    *((hb + 5)  as *volatile u8) = cur_down  as u8
    *((hb + 6)  as *volatile u8) = cur_left  as u8
    *((hb + 7)  as *volatile u8) = cur_right as u8
    *((hb + 8)  as *volatile u8) = cur_l     as u8
    *((hb + 9)  as *volatile u8) = cur_r     as u8
    *((hb + 10) as *volatile u8) = cur_cup   as u8
    *((hb + 11) as *volatile u8) = cur_cdn   as u8
    *((hb + 12) as *volatile u8) = cur_clt   as u8
    *((hb + 13) as *volatile u8) = cur_crt   as u8

    -- Write pressed: pressed = (cur=1) & (prev=0) = cur & (1-prev).
    -- For single-bit 0/1 values this is equivalent to cur & ~prev.
    let pb: u32 = pressed_addr(port)
    *((pb + 0)  as *volatile u8) = (cur_a     & (1 - prev_a))     as u8
    *((pb + 1)  as *volatile u8) = (cur_b     & (1 - prev_b))     as u8
    *((pb + 2)  as *volatile u8) = (cur_z     & (1 - prev_z))     as u8
    *((pb + 3)  as *volatile u8) = (cur_start & (1 - prev_start)) as u8
    *((pb + 4)  as *volatile u8) = (cur_up    & (1 - prev_up))    as u8
    *((pb + 5)  as *volatile u8) = (cur_down  & (1 - prev_down))  as u8
    *((pb + 6)  as *volatile u8) = (cur_left  & (1 - prev_left))  as u8
    *((pb + 7)  as *volatile u8) = (cur_right & (1 - prev_right)) as u8
    *((pb + 8)  as *volatile u8) = (cur_l     & (1 - prev_l))     as u8
    *((pb + 9)  as *volatile u8) = (cur_r     & (1 - prev_r))     as u8
    *((pb + 10) as *volatile u8) = (cur_cup   & (1 - prev_cup))   as u8
    *((pb + 11) as *volatile u8) = (cur_cdn   & (1 - prev_cdn))   as u8
    *((pb + 12) as *volatile u8) = (cur_clt   & (1 - prev_clt))   as u8
    *((pb + 13) as *volatile u8) = (cur_crt   & (1 - prev_crt))   as u8

    -- Write released: released = (cur=0) & (prev=1) = (1-cur) & prev.
    let rbase: u32 = released_addr(port)
    *((rbase + 0)  as *volatile u8) = ((1 - cur_a)     & prev_a)     as u8
    *((rbase + 1)  as *volatile u8) = ((1 - cur_b)     & prev_b)     as u8
    *((rbase + 2)  as *volatile u8) = ((1 - cur_z)     & prev_z)     as u8
    *((rbase + 3)  as *volatile u8) = ((1 - cur_start) & prev_start) as u8
    *((rbase + 4)  as *volatile u8) = ((1 - cur_up)    & prev_up)    as u8
    *((rbase + 5)  as *volatile u8) = ((1 - cur_down)  & prev_down)  as u8
    *((rbase + 6)  as *volatile u8) = ((1 - cur_left)  & prev_left)  as u8
    *((rbase + 7)  as *volatile u8) = ((1 - cur_right) & prev_right) as u8
    *((rbase + 8)  as *volatile u8) = ((1 - cur_l)     & prev_l)     as u8
    *((rbase + 9)  as *volatile u8) = ((1 - cur_r)     & prev_r)     as u8
    *((rbase + 10) as *volatile u8) = ((1 - cur_cup)   & prev_cup)   as u8
    *((rbase + 11) as *volatile u8) = ((1 - cur_cdn)   & prev_cdn)   as u8
    *((rbase + 12) as *volatile u8) = ((1 - cur_clt)   & prev_clt)   as u8
    *((rbase + 13) as *volatile u8) = ((1 - cur_crt)   & prev_crt)   as u8

    -- Update stick axes in the ControllerState at offsets 12 and 16.
    let cs_base: u32 = cs_addr(port)
    let p_sx: *volatile i32 = (cs_base + 12) as *volatile i32; *p_sx = sx
    let p_sy: *volatile i32 = (cs_base + 16) as *volatile i32; *p_sy = sy
}

-- The stick axes are int8 on the wire. Reading them as unsigned made a
-- left push (0x80..0xFF) look like a hard right.
fn si_s8(v: u32) -> i32 {
    let b: i32 = (v & 0xFF) as i32
    if b > 127 { return b - 256 }
    return b
}

fn joypad_poll() {
    -- Build the PIF command buffer in g_pif_buf via poke8 (real `sb` to the
    -- buffer, not the stack). One read-controller command per port, back to
    -- back: [tx=1][rx=4][cmd=0x01][4 result bytes] is 7 bytes and advances
    -- one channel, so four of them cover ports 0-3 and end at byte 28.
    -- Byte 28: 0xFE (end channels). Byte 63: 0x01 (execute PIF).
    let b: u32 = pif_addr()
    let mut p: i32 = 0
    while p < 4 {
        let c: u32 = (p * 7) as u32
        poke8(b + c + 0, 0x01)
        poke8(b + c + 1, 0x04)
        poke8(b + c + 2, 0x01)
        poke8(b + c + 3, 0xFF)
        poke8(b + c + 4, 0xFF)
        poke8(b + c + 5, 0xFF)
        poke8(b + c + 6, 0xFF)
        p = p + 1
    }
    poke8(b + 28, 0xFE)
    poke8(b + 63, 0x01)

    si_exec()

    -- Response per port: bytes +3=buttons_hi, +4=buttons_lo, +5=stick_x,
    -- +6=stick_y. The PIF ORs an error code into the rx byte -- 0x80 for no
    -- device, 0x40 for a timeout -- and the result bytes are junk when it does,
    -- so an empty port reads as all-buttons-up rather than as noise.
    p = 0
    while p < 4 {
        let c: u32 = (p * 7) as u32
        let rx: u32 = peek8(b + c + 1)
        let mut cur: u32 = 0
        let mut sx: i32 = 0
        let mut sy: i32 = 0
        if (rx & 0xC0) == 0 {
            cur = (peek8(b + c + 3) << 8) | peek8(b + c + 4)
            sx = si_s8(peek8(b + c + 5))
            sy = si_s8(peek8(b + c + 6))
        }
        joypad_store(p, cur, sx, sy)
        p = p + 1
    }
}

fn joypad_get_status(port: i32) -> *ControllerState {
    return cs_addr(port) as *ControllerState
}

-- ── RDP (Display Processor) ─────────────────────────────────────────────────
-- Commands are built into a display list in uncached RDRAM and handed to the
-- DP by writing DPC_START/DPC_END. The CPU never touches pixels: fills, copies,
-- textured rectangles and triangles are all done by the rasterizer.
--
-- The list lives in KSEG1 so a CPU write lands in RDRAM immediately and the DP
-- reads exactly what was written, with no cache writeback step to get wrong.

const DPC_START:   u32 = 0xA4100000
const DPC_END:     u32 = 0xA4100004
const DPC_CURRENT: u32 = 0xA4100008
const DPC_STATUS:  u32 = 0xA410000C

-- DPC_STATUS write bits (clear/set pairs).
const DPC_CLR_XBUS:  u32 = 0x0001
const DPC_CLR_FREEZE: u32 = 0x0004
const DPC_CLR_FLUSH: u32 = 0x0010

-- DPC_STATUS read bits.
const DPC_PIPE_BUSY: u32 = 0x0020
const DPC_CMD_BUSY:  u32 = 0x0040
const DPC_DMA_BUSY:  u32 = 0x0100

-- Display list: 8 KiB of uncached RDRAM just past the Z buffer.
const DL_BASE:  u32 = 0xA0297000
const DL_PHYS:  u32 = 0x00297000
const DL_BYTES: u32 = 8192

static g_dl_off: u32 = 0        -- write cursor, bytes from DL_BASE

-- RDP command opcodes.
const RDP_TRI_FILL:        u32 = 0x08
const RDP_TRI_FILL_Z:      u32 = 0x09
const RDP_TRI_TEX:         u32 = 0x0A
const RDP_TRI_TEX_Z:       u32 = 0x0B
const RDP_TRI_SHADE:       u32 = 0x0C
const RDP_TRI_SHADE_Z:     u32 = 0x0D
const RDP_TRI_SHADE_TXTR:  u32 = 0x0E
const RDP_TRI_SHADE_TXTR_Z: u32 = 0x0F
const RDP_TEXTURE_RECT:    u32 = 0x24
const RDP_TEXTURE_RECT_FLIP: u32 = 0x25
const RDP_SYNC_LOAD:       u32 = 0x26
const RDP_SYNC_PIPE:       u32 = 0x27
const RDP_SYNC_TILE:       u32 = 0x28
const RDP_SYNC_FULL:       u32 = 0x29
const RDP_SET_KEY_GB:      u32 = 0x2A
const RDP_SET_KEY_R:       u32 = 0x2B
const RDP_SET_CONVERT:     u32 = 0x2C
const RDP_SET_SCISSOR:     u32 = 0x2D
const RDP_SET_PRIM_DEPTH:  u32 = 0x2E
const RDP_SET_OTHER_MODES: u32 = 0x2F
const RDP_LOAD_TLUT:       u32 = 0x30
const RDP_SET_TILE_SIZE:   u32 = 0x32
const RDP_LOAD_BLOCK:      u32 = 0x33
const RDP_LOAD_TILE:       u32 = 0x34
const RDP_SET_TILE:        u32 = 0x35
const RDP_FILL_RECT:       u32 = 0x36
const RDP_SET_FILL_COLOR:  u32 = 0x37
const RDP_SET_FOG_COLOR:   u32 = 0x38
const RDP_SET_BLEND_COLOR: u32 = 0x39
const RDP_SET_PRIM_COLOR:  u32 = 0x3A
const RDP_SET_ENV_COLOR:   u32 = 0x3B
const RDP_SET_COMBINE:     u32 = 0x3C
const RDP_SET_TEX_IMAGE:   u32 = 0x3D
const RDP_SET_Z_IMAGE:     u32 = 0x3E
const RDP_SET_COLOR_IMAGE: u32 = 0x3F

-- Cycle types, as they sit in SET_OTHER_MODES bits 53:52 (w0 bits 21:20).
const CYCLE_1CYCLE: u32 = 0
const CYCLE_2CYCLE: u32 = 1
const CYCLE_COPY:   u32 = 2
const CYCLE_FILL:   u32 = 3

-- The cycle type the last mode setter selected. texture_rectangle needs it:
-- in COPY the RDP retires four pixels per cycle and the S step is written 4x,
-- which is the convention every GBI blit uses. In 1- or 2-cycle the same value
-- advances S four texels per pixel, so a 32-texel page is consumed in eight
-- pixels and everything past that samples unloaded TMEM.
static g_cycle: u32 = 3

static g_current_fb: u32 = 0
static g_fill_color: u16 = 0xFFFF

-- Last SET_TEXTURE_IMAGE. LOAD_TILE / LOAD_BLOCK writeback this range so the
-- DP samples RDRAM, not stale dcache. KSEG1 sources skip the cache op.
static g_tex_addr:  u32 = 0
static g_tex_size:  u32 = 2
static g_tex_width: i32 = 1

-- ── display list plumbing ──────────────────────────────────────────────────

fn dl_reset() {
    g_dl_off = 0
}

-- Hand the pending commands to the DP and wait for it to drain. The DP reads
-- physical addresses, so the KSEG1 alias is masked off.
fn dl_submit() {
    if g_dl_off == 0 { return }
    let len: u32 = g_dl_off
    g_dl_off = 0

    -- Take the DP out of XBUS mode (it reads RDRAM, not RSP DMEM) and make
    -- sure it is neither frozen nor flushing before pointing it at the list.
    vi_write(DPC_STATUS, DPC_CLR_XBUS | DPC_CLR_FREEZE | DPC_CLR_FLUSH)
    vi_write(DPC_START, DL_PHYS)
    vi_write(DPC_END, DL_PHYS + len)

    loop {
        let st: u32 = vi_read(DPC_STATUS)
        if (st & (DPC_PIPE_BUSY | DPC_CMD_BUSY | DPC_DMA_BUSY)) == 0 { break }
    }
}

-- Append one 64-bit command. A full buffer is submitted first, which is safe
-- because every command is self-contained once the DP has seen it.
fn dl_cmd(w0: u32, w1: u32) {
    if g_dl_off + 8 > DL_BYTES { dl_submit() }
    let p0: *volatile u32 = (DL_BASE + g_dl_off) as *volatile u32
    *p0 = w0
    let p1: *volatile u32 = (DL_BASE + g_dl_off + 4) as *volatile u32
    *p1 = w1
    g_dl_off = g_dl_off + 8
}

fn dl_word(w: u32) {
    if g_dl_off + 4 > DL_BYTES { dl_submit() }
    let p: *volatile u32 = (DL_BASE + g_dl_off) as *volatile u32
    *p = w
    g_dl_off = g_dl_off + 4
}

-- Screen coordinate -> the RDP's 10.2 fixed point, clamped to the 12-bit
-- unsigned field. Correct for SET_SCISSOR and the rectangle commands, whose
-- corners are genuinely screen-space and unsigned. WRONG for a triangle's
-- YL/YM/YH -- see to_fx142 below.
fn to_fx102(v: i32) -> u32 {
    let mut x: i32 = v
    if x < 0 { x = 0 }
    if x > 1023 { x = 1023 }
    return (x * 4) as u32
}

-- A triangle's YL/YM/YH are a signed 14-bit field (11.2), not the unsigned
-- 12-bit field the scissor and rectangles use. A vertex above the top of the
-- screen has a real negative Y, and the RDP is meant to walk the edge down
-- from that Y at the given slope, relying on its own scissor test to clip
-- what falls outside 0..239 -- the X value at YH is only correct if YH is the
-- vertex's true Y, not a Y clamped to 0.
--
-- Using to_fx102 here clamped YH to 0 while leaving XH as the X at the real
-- (negative) Y, so the RDP started rasterizing at scanline 0 with the wrong
-- X: every triangle with an off-screen vertex came out sheared, missing a
-- third of its on-screen area and painting pixels outside its geometry.
fn to_fx142(v: i32) -> u32 {
    let mut x: i32 = v
    if x < -2048 { x = -2048 }
    if x > 2047 { x = 2047 }
    return ((x * 4) as u32) & 0x3FFF
}

-- ── surface + mode state ───────────────────────────────────────────────────

fn rdpq_init() {
    dl_reset()
    vi_write(DPC_STATUS, DPC_CLR_XBUS | DPC_CLR_FREEZE | DPC_CLR_FLUSH)
}

fn rdpq_close() {
    dl_submit()
}

-- SET_COLOR_IMAGE: format (RGBA=0), size (16bpp=2), width-1, physical address.
fn rdpq_set_color_image(addr: u32, fmt: u32, size: u32, width: i32) {
    let wm1: u32 = (width - 1) as u32 & 0x3FF
    let w0: u32 = (RDP_SET_COLOR_IMAGE << 24) | (fmt << 21) | (size << 19) | wm1
    dl_cmd(w0, addr & 0x00FFFFFF)
}

fn rdpq_set_z_image(addr: u32) {
    dl_cmd(RDP_SET_Z_IMAGE << 24, addr & 0x00FFFFFF)
}

fn rdpq_set_scissor(x0: i32, y0: i32, x1: i32, y1: i32) {
    let w0: u32 = (RDP_SET_SCISSOR << 24) | (to_fx102(x0) << 12) | to_fx102(y0)
    let w1: u32 = (to_fx102(x1) << 12) | to_fx102(y1)
    dl_cmd(w0, w1)
}

fn rdpq_set_other_modes_raw(hi: u32, lo: u32) {
    dl_cmd((RDP_SET_OTHER_MODES << 24) | (hi & 0x00FFFFFF), lo)
}

fn rdpq_set_combiner_raw(hi: u32, lo: u32) {
    dl_cmd((RDP_SET_COMBINE << 24) | (hi & 0x00FFFFFF), lo)
}

fn rdpq_attach(fb: u32) {
    g_current_fb = fb
    rdpq_set_color_image(fb, 0, 2, SCREEN_W)
    rdpq_set_z_image(ZB)
    rdpq_set_scissor(0, 0, SCREEN_W, SCREEN_H)
}

fn rdpq_attach_clear(fb: u32, color: u32) {
    rdpq_attach(fb)
    rdpq_set_mode_fill(color)
    rdpq_fill_rectangle(0, 0, SCREEN_W, SCREEN_H)
}

fn rdpq_detach() {
    dl_cmd(RDP_SYNC_FULL << 24, 0)
    dl_submit()
    g_current_fb = 0
}

fn rdpq_detach_show() {
    let fb: u32 = g_current_fb
    rdpq_detach()
    if fb != 0 {
        vi_show(fb)
    }
}

-- ── render modes ───────────────────────────────────────────────────────────

-- FILL cycle: the rasterizer writes the fill colour straight out, four bytes
-- (two 16bpp pixels) per cycle. This is what makes a clear cost microseconds
-- instead of a CPU loop over 76 800 uncached halfword stores.
fn rdpq_set_mode_fill(color: u32) {
    dl_cmd(RDP_SYNC_PIPE << 24, 0)
    g_cycle = CYCLE_FILL
    rdpq_set_other_modes_raw(CYCLE_FILL << 20, 0)
    rdpq_set_fill_color(color)
}

-- COPY cycle: four texels per cycle, no filtering or blending. The fast path
-- for opaque sprite blits.
fn rdpq_set_mode_copy() {
    dl_cmd(RDP_SYNC_PIPE << 24, 0)
    -- alpha_compare_en (bit 0) so fully transparent texels are dropped.
    g_cycle = CYCLE_COPY
    rdpq_set_other_modes_raw(CYCLE_COPY << 20, 0x00000001)
}

-- 1-cycle mode with the combiner passing the texel straight through and the
-- blender doing source-alpha over the framebuffer.
--
-- Blender: (P * A + M * B) / (A + B) with P = combined colour (0),
-- A = combined alpha (0), M = memory colour (1), B = 1-A (0). The pair of
-- fields is set for both blender cycles because 1-cycle mode still reads the
-- second cycle's mux on some paths.
--
-- zbuf: SET_OTHER_MODES z_compare_en (bit 4) + z_update_en (bit 5).
fn rdp_set_mode_1cycle(zbuf: i32) {
    dl_cmd(RDP_SYNC_PIPE << 24, 0)
    let blend: u32 = (1 << 22) | (1 << 20)
    let mut lo: u32 = blend | 0x00006040
    if zbuf != 0 { lo = lo | 0x30 }
    g_cycle = CYCLE_1CYCLE
    -- bi_lerp0 (bit 11) and bi_lerp1 (bit 10) put the texture filter unit in
    -- bilerp mode. With them clear the RDP runs every texel through the YUV
    -- colour-convert path instead, which returns black for an RGBA texture --
    -- so every textured triangle and every 1-cycle blit came out untextured.
    let filt: u32 = (1 << 11) | (1 << 10)
    rdpq_set_other_modes_raw((CYCLE_1CYCLE << 20) | filt, lo)
    -- Combiner (A-B)*C+D with A=B=C=0 and D=TEX0, for colour and alpha, in
    -- both cycles: sub_A=0, sub_B=0, mul=0, add=TEX0.
    rdpq_set_combiner_raw(0x00887F10, 0x88FCF279)
}

fn rdpq_set_mode_standard() {
    rdp_set_mode_1cycle(0)
}

fn rdpq_set_mode_standard_z() {
    rdp_set_mode_1cycle(1)
}

-- Fill the reserved Z buffer with 0xFFFC (libdragon's max 16-bit Z) by
-- briefly pointing SET_COLOR_IMAGE at it. Restores the colour target after.
fn rdpq_clear_z() {
    let fb: u32 = g_current_fb
    rdpq_set_color_image(ZB, 0, 2, SCREEN_W)
    dl_cmd(RDP_SYNC_PIPE << 24, 0)
    g_cycle = CYCLE_FILL
    rdpq_set_other_modes_raw(CYCLE_FILL << 20, 0)
    dl_cmd(RDP_SET_FILL_COLOR << 24, 0xFFFCFFFC)
    rdpq_fill_rectangle(0, 0, SCREEN_W, SCREEN_H)
    if fb != 0 {
        rdpq_set_color_image(fb, 0, 2, SCREEN_W)
    }
}

-- ── colour registers ───────────────────────────────────────────────────────

fn rdpq_set_fill_color(color: u32) {
    let px: u32 = color32_to_16(color) as u32
    g_fill_color = px as u16
    -- In 16bpp fill mode the 32-bit register supplies two adjacent pixels.
    dl_cmd(RDP_SET_FILL_COLOR << 24, (px << 16) | px)
}

fn rdpq_set_blend_color(color: u32) {
    dl_cmd(RDP_SET_BLEND_COLOR << 24, color)
}

fn rdpq_set_fog_color(color: u32) {
    dl_cmd(RDP_SET_FOG_COLOR << 24, color)
}

fn rdpq_set_env_color(color: u32) {
    dl_cmd(RDP_SET_ENV_COLOR << 24, color)
}

fn rdpq_set_prim_color(color: u32) {
    dl_cmd(RDP_SET_PRIM_COLOR << 24, color)
}

-- Primitive Z and delta-Z. Used when OTHER_MODES samples primitive depth
-- instead of the per-pixel interpolator. z/dz are 16-bit.
fn rdpq_set_prim_depth(z: u32, dz: u32) {
    dl_cmd(RDP_SET_PRIM_DEPTH << 24, (z << 16) | (dz & 0xFFFF))
}

-- Chroma-key red channel. width is 12-bit; center and scale are 8-bit.
fn rdpq_set_key_r(width: u32, center: u32, scale: u32) {
    dl_cmd(RDP_SET_KEY_R << 24,
           ((width & 0xFFF) << 16) | ((center & 0xFF) << 8) | (scale & 0xFF))
}

-- Chroma-key green and blue. Same layout as GBI gDPSetKeyGB.
fn rdpq_set_key_gb(width_g: u32, width_b: u32,
                   center_g: u32, scale_g: u32,
                   center_b: u32, scale_b: u32) {
    dl_cmd((RDP_SET_KEY_GB << 24) | ((width_g & 0xFFF) << 12) | (width_b & 0xFFF),
           ((center_g & 0xFF) << 24) | ((scale_g & 0xFF) << 16)
           | ((center_b & 0xFF) << 8) | (scale_b & 0xFF))
}

-- YUV-to-RGB convert coefficients. Each k is 9-bit two's complement
-- (libultra NTSC: 175, -43, -89, 222, 114, 42).
fn rdp_k9(v: i32) -> u32 {
    return (v as u32) & 0x1FF
}

fn rdpq_set_convert(k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32) {
    let a: u32 = rdp_k9(k0)
    let b: u32 = rdp_k9(k1)
    let c: u32 = rdp_k9(k2)
    let d: u32 = rdp_k9(k3)
    let e: u32 = rdp_k9(k4)
    let f: u32 = rdp_k9(k5)
    dl_cmd((RDP_SET_CONVERT << 24) | (a << 13) | (b << 4) | (c >> 5),
           ((c & 0x1F) << 27) | (d << 18) | (e << 9) | f)
}

-- ── primitives ─────────────────────────────────────────────────────────────

-- FILL_RECTANGLE takes an inclusive rectangle; the API bounds are exclusive,
-- so the lower-right corner is pulled in by one pixel.
fn rdpq_fill_rectangle(x0: i32, y0: i32, x1: i32, y1: i32) {
    if x1 <= x0 { return }
    if y1 <= y0 { return }
    let w0: u32 = (RDP_FILL_RECT << 24) | (to_fx102(x1 - 1) << 12) | to_fx102(y1 - 1)
    let w1: u32 = (to_fx102(x0) << 12) | to_fx102(y0)
    dl_cmd(w0, w1)
}

-- ── texturing ──────────────────────────────────────────────────────────────

-- KSEG1 (0xA0000000) is uncached; the DP already sees CPU stores.
fn rdp_is_uncached(addr: u32) -> bool {
    return (addr & 0x20000000) != 0
}

fn rdp_tex_bpp(size: u32) -> i32 {
    if size == 0 { return 0 }
    if size == 1 { return 1 }
    if size == 2 { return 2 }
    return 4
}

-- Writeback `nbytes` at `addr` so the RDP's uncached RDRAM read sees CPU stores.
fn rdp_tex_writeback(addr: u32, nbytes: i32) {
    if nbytes <= 0 { return }
    if rdp_is_uncached(addr) { return }
    data_cache_hit_writeback(addr as *u8, nbytes)
}

fn rdpq_set_texture_image(addr: u32, fmt: u32, size: u32, width: i32) {
    g_tex_addr = addr
    g_tex_size = size
    g_tex_width = width
    -- Conservative: one TMEM (4 KiB) covers any single LOAD_TILE/BLOCK. The
    -- load commands then writeback the exact rectangle once height is known.
    rdp_tex_writeback(addr, 4096)
    let wm1: u32 = (width - 1) as u32 & 0x3FF
    let w0: u32 = (RDP_SET_TEX_IMAGE << 24) | (fmt << 21) | (size << 19) | wm1
    dl_cmd(w0, addr & 0x00FFFFFF)
}

-- SET_TILE describes one of the eight tile descriptors: where in TMEM the
-- texels live, how wide a line is, and how the S/T axes wrap. Mask/shift/clamp
-- default to wrap (GBI G_TX_WRAP, mask 0).
fn rdpq_set_tile(tile: u32, fmt: u32, size: u32, line: u32, tmem_addr: u32, palette: u32) {
    rdpq_set_tile_mask(tile, fmt, size, line, tmem_addr, palette, 0, 0, 0, 0)
}

-- cms/cmt match GBI: 0=wrap, 1=mirror, 2=clamp, 3=mirror+clamp.
-- mask_s/mask_t are log2 of the clamp/wrap period (5 = 32 texels).
fn rdpq_set_tile_mask(tile: u32, fmt: u32, size: u32, line: u32, tmem_addr: u32, palette: u32,
                      cms: u32, cmt: u32, mask_s: u32, mask_t: u32) {
    let lt: u32 = ((line & 0x1FF) << 9) | (tmem_addr & 0x1FF)
    let w0: u32 = (RDP_SET_TILE << 24) | (fmt << 21) | (size << 19) | lt
    let cs: u32 = (cms >> 1) & 1
    let ms: u32 = cms & 1
    let ct: u32 = (cmt >> 1) & 1
    let mt: u32 = cmt & 1
    let w1: u32 = ((tile & 7) << 24) | ((palette & 0xF) << 20)
        | (ct << 19) | (mt << 18) | ((mask_t & 0xF) << 14)
        | (cs << 9) | (ms << 8) | ((mask_s & 0xF) << 4)
    dl_cmd(w0, w1)
}

fn rdpq_set_tile_size(tile: u32, s0: i32, t0: i32, s1: i32, t1: i32) {
    let w0: u32 = (RDP_SET_TILE_SIZE << 24) | (to_fx102(s0) << 12) | to_fx102(t0)
    let w1: u32 = ((tile & 7) << 24) | (to_fx102(s1 - 1) << 12) | to_fx102(t1 - 1)
    dl_cmd(w0, w1)
}

fn rdpq_load_tile(tile: u32, s0: i32, t0: i32, s1: i32, t1: i32) {
    -- Exact rectangle in the source image, now that height is known.
    let mut tw: i32 = s1 - s0
    let mut th: i32 = t1 - t0
    if tw < 0 { tw = 0 }
    if th < 0 { th = 0 }
    let bpp: i32 = rdp_tex_bpp(g_tex_size)
    let mut nbytes: i32 = 0
    let mut off: i32 = 0
    if bpp == 0 {
        nbytes = (tw * th + 1) / 2
        off = (t0 * g_tex_width + s0) / 2
    } else {
        nbytes = tw * th * bpp
        off = (t0 * g_tex_width + s0) * bpp
    }
    rdp_tex_writeback(g_tex_addr + (off as u32), nbytes)
    let w0: u32 = (RDP_LOAD_TILE << 24) | (to_fx102(s0) << 12) | to_fx102(t0)
    let w1: u32 = ((tile & 7) << 24) | (to_fx102(s1 - 1) << 12) | to_fx102(t1 - 1)
    dl_cmd(w0, w1)
}

fn rdpq_load_block(tile: u32, s0: u32, t0: u32, texels: u32, dxt: u32) {
    let bpp: i32 = rdp_tex_bpp(g_tex_size)
    let mut nbytes: i32 = texels as i32
    if bpp == 0 {
        nbytes = (texels as i32 + 1) / 2
    } elif bpp > 1 {
        nbytes = (texels as i32) * bpp
    }
    rdp_tex_writeback(g_tex_addr, nbytes)
    let w0: u32 = (RDP_LOAD_BLOCK << 24) | ((s0 & 0xFFF) << 12) | (t0 & 0xFFF)
    let w1: u32 = ((tile & 7) << 24) | (((texels - 1) & 0xFFF) << 12) | (dxt & 0xFFF)
    dl_cmd(w0, w1)
}

fn rdpq_load_tlut(tile: u32, first: u32, count: u32) {
    let w0: u32 = (RDP_LOAD_TLUT << 24) | ((first * 4) << 12)
    let w1: u32 = ((tile & 7) << 24) | (((first + count - 1) * 4) << 12)
    dl_cmd(w0, w1)
}

-- TEXTURE_RECTANGLE is four words: the rectangle, then the texture coordinate
-- at its top-left plus the per-pixel S and T steps, both s10.5.
fn rdpq_texture_rectangle_scaled(tile: u32, x0: i32, y0: i32, x1: i32, y1: i32,
                                 s: i32, t: i32, dsdx: i32, dtdy: i32) {
    if x1 <= x0 { return }
    if y1 <= y0 { return }
    -- XL/YL are the last pixel in COPY and FILL, but one past it in 1- and
    -- 2-cycle. Using the COPY form everywhere dropped the right column and the
    -- bottom row of every 1-cycle blit.
    let mut xl: i32 = x1
    let mut yl: i32 = y1
    if g_cycle == CYCLE_COPY { xl = x1 - 1; yl = y1 - 1 }
    let w0: u32 = (RDP_TEXTURE_RECT << 24) | (to_fx102(xl) << 12) | to_fx102(yl)
    let w1: u32 = ((tile & 7) << 24) | (to_fx102(x0) << 12) | to_fx102(y0)
    dl_cmd(w0, w1)
    let w2: u32 = (((s * 32) as u32 & 0xFFFF) << 16) | ((t * 32) as u32 & 0xFFFF)
    let w3: u32 = ((dsdx as u32 & 0xFFFF) << 16) | (dtdy as u32 & 0xFFFF)
    dl_cmd(w2, w3)
}

-- A 1:1 blit. The S step is s5.10 texels per pixel: 1024 is one texel, and
-- COPY wants it written 4x because the RDP retires four pixels per cycle
-- there. Hardcoding the COPY value made every 1-cycle blit walk S four times
-- too fast.
fn rdpq_texture_rectangle(tile: u32, x0: i32, y0: i32, x1: i32, y1: i32, s: i32, t: i32) {
    let mut dsdx: i32 = 1024
    if g_cycle == CYCLE_COPY { dsdx = 4096 }
    rdpq_texture_rectangle_scaled(tile, x0, y0, x1, y1, s, t, dsdx, 1024)
}

-- TEXTURE_RECTANGLE_FLIP (0x25): same 1:1 blit as texture_rectangle, but T
-- advances per scanline in the flipped direction the RDP uses for Y-flip.
fn rdpq_texture_rectangle_flip(tile: u32, x0: i32, y0: i32, x1: i32, y1: i32, s: i32, t: i32) {
    if x1 <= x0 { return }
    if y1 <= y0 { return }
    let w0: u32 = (RDP_TEXTURE_RECT_FLIP << 24) | (to_fx102(x1 - 1) << 12) | to_fx102(y1 - 1)
    let w1: u32 = ((tile & 7) << 24) | (to_fx102(x0) << 12) | to_fx102(y0)
    dl_cmd(w0, w1)
    let w2: u32 = (((s * 32) as u32 & 0xFFFF) << 16) | ((t * 32) as u32 & 0xFFFF)
    let mut step: u32 = 1024
    if g_cycle == CYCLE_COPY { step = 4096 }
    let w3: u32 = (step << 16) | 1024
    dl_cmd(w2, w3)
}

-- ── triangles ──────────────────────────────────────────────────────────────

-- Flat (edge-only) triangle. The RDP wants the three vertices sorted by Y and
-- described as three edges: the "major" edge spanning top to bottom, and the
-- two "minor" edges that meet at the middle vertex.
--
-- X positions and slopes are s15.16; Y positions are 11.2.
fn rdp_edge_slope(dx: i32, dy: i32) -> i32 {
    if dy == 0 { return 0 }
    return (dx * 65536) / dy
}

fn rdpq_triangle(x0: i32, y0: i32, x1: i32, y1: i32, x2: i32, y2: i32) {
    -- Sort the three vertices by Y (ya <= yb <= yc).
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut xc: i32 = x2
    let mut yc: i32 = y2

    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya
        xa = xb; ya = yb; xb = tx; yb = ty
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya
        xa = xc; ya = yc; xc = tx; yc = ty
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb
        xb = xc; yb = yc; xc = tx; yc = ty
    }

    -- Degenerate: no vertical extent, nothing to rasterize.
    if ya == yc { return }

    -- Which side the major edge falls on. Comparing the two cross-product
    -- terms avoids forming the product's sign separately.
    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }

    -- Major edge spans the full height; the minor edges meet at the middle.
    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)

    let w0: u32 = (RDP_TRI_FILL << 24) | (lft << 23) | to_fx142(yc)
    let w1: u32 = (to_fx142(yb) << 16) | to_fx142(ya)
    dl_cmd(w0, w1)
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)
}

-- TRIANGLE_Z (0x09): the 0x08 edges plus a Z coefficient block. Z is
-- 0..32767, same scale as triangle_shade_z.
fn rdpq_triangle_z(x0: i32, y0: i32, z0: i32,
                   x1: i32, y1: i32, z1: i32,
                   x2: i32, y2: i32, z2: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut za: i32 = z0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut zb: i32 = z1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut zc: i32 = z2

    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tz: i32 = za
        xa = xb; ya = yb; za = zb
        xb = tx; yb = ty; zb = tz
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tz: i32 = za
        xa = xc; ya = yc; za = zc
        xc = tx; yc = ty; zc = tz
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let tz: i32 = zb
        xb = xc; yb = yc; zb = zc
        xc = tx; yc = ty; zc = tz
    }
    if ya == yc { return }

    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }

    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)

    dl_cmd((RDP_TRI_FILL_Z << 24) | (lft << 23) | to_fx142(yc),
           (to_fx142(yb) << 16) | to_fx142(ya))
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)

    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    let nz: i32 = hx * my - hy * mx
    let zs: i32 = za << 16
    let dzdx: i32 = rdp_muldiv(0 - (hy * (zb - za) - my * (zc - za)), 65536, nz)
    let dzdy: i32 = rdp_muldiv(0 - (mx * (zc - za) - hx * (zb - za)), 65536, nz)
    rdp_z_coeffs(zs, dzdx, dzdy + rdp_muldiv(dzdx, hx, hy), dzdy)
}

-- a * m / d, toward-zero, without a 64-bit intermediate. Used for s15.16
-- attribute slopes: rdp_muldiv(num, 65536, den) == (num << 16) / den.
fn rdp_muldiv(a: i32, m: i32, d: i32) -> i32 {
    if d == 0 { return 0 }
    let q: i32 = a / d
    let r: i32 = a - q * d
    return q * m + (r * m) / d
}

-- Pack one (A,B,C) s15.16 triplet as the RDP wants it: integer halves, then
-- (later) fractional halves. See n64brew TRI_TEX coefficient layout.
fn rdp_tex_hi(a: i32, b: i32, c: i32) {
    let au: u32 = a as u32
    let bu: u32 = b as u32
    let cu: u32 = c as u32
    dl_cmd((au & 0xFFFF0000) | ((bu >> 16) & 0xFFFF), cu & 0xFFFF0000)
}

fn rdp_tex_lo(a: i32, b: i32, c: i32) {
    let au: u32 = a as u32
    let bu: u32 = b as u32
    let cu: u32 = c as u32
    dl_cmd((au << 16) | (bu & 0xFFFF), cu << 16)
}

-- Affine TRI_TEX (opcode 0x0A). S/T are texel units; 1/w is 1. Tile is the
-- SET_TILE slot. Edges are the same s15.16 setup as rdpq_triangle.
fn rdpq_triangle_tex(tile: u32,
                     x0: i32, y0: i32, s0: i32, t0: i32,
                     x1: i32, y1: i32, s1: i32, t1: i32,
                     x2: i32, y2: i32, s2: i32, t2: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut sa: i32 = s0
    let mut ta: i32 = t0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut sb: i32 = s1
    let mut tb: i32 = t1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut sc: i32 = s2
    let mut tc: i32 = t2

    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let ts: i32 = sa; let tt: i32 = ta
        xa = xb; ya = yb; sa = sb; ta = tb
        xb = tx; yb = ty; sb = ts; tb = tt
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let ts: i32 = sa; let tt: i32 = ta
        xa = xc; ya = yc; sa = sc; ta = tc
        xc = tx; yc = ty; sc = ts; tc = tt
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let ts: i32 = sb; let tt: i32 = tb
        xb = xc; yb = yc; sb = sc; tb = tc
        xc = tx; yc = ty; sc = ts; tc = tt
    }
    if ya == yc { return }

    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }

    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)

    let w0: u32 = (RDP_TRI_TEX << 24) | (lft << 23) | ((tile & 7) << 16) | to_fx142(yc)
    let w1: u32 = (to_fx142(yb) << 16) | to_fx142(ya)
    dl_cmd(w0, w1)
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)

    -- S/T in s10.5 (texel*32), then s15.16. Affine W = 0x7FFF (libdragon scale).
    let ss0: i32 = sa * 32
    let tt0: i32 = ta * 32
    let ss1: i32 = sb * 32
    let tt1: i32 = tb * 32
    let ss2: i32 = sc * 32
    let tt2: i32 = tc * 32

    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    let nz: i32 = hx * my - hy * mx
    let ms: i32 = ss1 - ss0
    let mt: i32 = tt1 - tt0
    let hs: i32 = ss2 - ss0
    let ht: i32 = tt2 - tt0
    let nxS: i32 = hy * ms - my * hs
    let nxT: i32 = hy * mt - my * ht
    let nyS: i32 = mx * hs - hx * ms
    let nyT: i32 = mx * ht - hx * mt

    -- DsDx = -nxS / nz in s15.16 of s10.5-per-pixel.
    let dsdx: i32 = rdp_muldiv(0 - nxS, 65536, nz)
    let dtdx: i32 = rdp_muldiv(0 - nxT, 65536, nz)
    let dsdy: i32 = rdp_muldiv(0 - nyS, 65536, nz)
    let dtdy: i32 = rdp_muldiv(0 - nyT, 65536, nz)
    let dsde: i32 = dsdy + rdp_muldiv(dsdx, hx, hy)
    let dtde: i32 = dtdy + rdp_muldiv(dtdx, hx, hy)

    let sfix: i32 = ss0 * 65536
    let tfix: i32 = tt0 * 65536
    let wfix: i32 = 0x7FFF0000
    rdp_tex_hi(sfix, tfix, wfix)
    rdp_tex_hi(dsdx, dtdx, 0)
    rdp_tex_lo(sfix, tfix, wfix)
    rdp_tex_lo(dsdx, dtdx, 0)
    rdp_tex_hi(dsde, dtde, 0)
    rdp_tex_hi(dsdy, dtdy, 0)
    rdp_tex_lo(dsde, dtde, 0)
    rdp_tex_lo(dsdy, dtdy, 0)
}

-- Pack one RGBA s15.16 quadruplet as the RDP shade block wants it: integer
-- halves, then (later) fractional halves. See n64brew TRI_SHADE layout.
fn rdp_rgba_hi(r: i32, g: i32, b: i32, a: i32) {
    let ru: u32 = r as u32
    let gu: u32 = g as u32
    let bu: u32 = b as u32
    let au: u32 = a as u32
    dl_cmd((ru & 0xFFFF0000) | ((gu >> 16) & 0xFFFF),
           (bu & 0xFFFF0000) | ((au >> 16) & 0xFFFF))
}

fn rdp_rgba_lo(r: i32, g: i32, b: i32, a: i32) {
    let ru: u32 = r as u32
    let gu: u32 = g as u32
    let bu: u32 = b as u32
    let au: u32 = a as u32
    dl_cmd((ru << 16) | (gu & 0xFFFF), (bu << 16) | (au & 0xFFFF))
}

fn rdp_ch(c: u32, sh: u32) -> i32 {
    return (((c >> sh) & 0xFF) as i32) << 16
}

-- Z coefficients: two 64-bit words, integer then fractional halves of
-- (Z, dZdX) and (dZdE, dZdY). libdragon writes 4 uint32; the RDP splits
-- each s15.16 the same way shade/tex do.
fn rdp_z_coeffs(z: i32, dzdx: i32, dzde: i32, dzdy: i32) {
    let zu: u32 = z as u32
    let dx: u32 = dzdx as u32
    let de: u32 = dzde as u32
    let dy: u32 = dzdy as u32
    dl_cmd((zu & 0xFFFF0000) | ((dx >> 16) & 0xFFFF), (zu << 16) | (dx & 0xFFFF))
    dl_cmd((de & 0xFFFF0000) | ((dy >> 16) & 0xFFFF), (de << 16) | (dy & 0xFFFF))
}

-- Gouraud TRI_SHADE (0x0C) or TRI_SHADE_Z (0x0D). Colours are RGBA8888;
-- Z is 0..32767 (15-bit, matching libdragon's 0x7FFF scale).
fn rdp_tri_shade(opcode: u32,
                 x0: i32, y0: i32, c0: u32, z0: i32,
                 x1: i32, y1: i32, c1: u32, z1: i32,
                 x2: i32, y2: i32, c2: u32, z2: i32,
                 do_z: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut ca: u32 = c0
    let mut za: i32 = z0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut cb: u32 = c1
    let mut zb: i32 = z1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut cc: u32 = c2
    let mut zc: i32 = z2

    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tc: u32 = ca; let tz: i32 = za
        xa = xb; ya = yb; ca = cb; za = zb
        xb = tx; yb = ty; cb = tc; zb = tz
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tc: u32 = ca; let tz: i32 = za
        xa = xc; ya = yc; ca = cc; za = zc
        xc = tx; yc = ty; cc = tc; zc = tz
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let tc: u32 = cb; let tz: i32 = zb
        xb = xc; yb = yc; cb = cc; zb = zc
        xc = tx; yc = ty; cc = tc; zc = tz
    }
    if ya == yc { return }

    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }

    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)

    let w0: u32 = (opcode << 24) | (lft << 23) | to_fx142(yc)
    let w1: u32 = (to_fx142(yb) << 16) | to_fx142(ya)
    dl_cmd(w0, w1)
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)

    let ra: i32 = rdp_ch(ca, 24)
    let ga: i32 = rdp_ch(ca, 16)
    let ba: i32 = rdp_ch(ca, 8)
    let aa: i32 = rdp_ch(ca, 0)
    let rb: i32 = rdp_ch(cb, 24)
    let gb: i32 = rdp_ch(cb, 16)
    let bb: i32 = rdp_ch(cb, 8)
    let ab: i32 = rdp_ch(cb, 0)
    let rc: i32 = rdp_ch(cc, 24)
    let gc: i32 = rdp_ch(cc, 16)
    let bc: i32 = rdp_ch(cc, 8)
    let ac: i32 = rdp_ch(cc, 0)

    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    let nz: i32 = hx * my - hy * mx

    let drdx: i32 = rdp_muldiv(0 - (hy * (rb - ra) - my * (rc - ra)), 65536, nz)
    let dgdx: i32 = rdp_muldiv(0 - (hy * (gb - ga) - my * (gc - ga)), 65536, nz)
    let dbdx: i32 = rdp_muldiv(0 - (hy * (bb - ba) - my * (bc - ba)), 65536, nz)
    let dadx: i32 = rdp_muldiv(0 - (hy * (ab - aa) - my * (ac - aa)), 65536, nz)
    let drdy: i32 = rdp_muldiv(0 - (mx * (rc - ra) - hx * (rb - ra)), 65536, nz)
    let dgdy: i32 = rdp_muldiv(0 - (mx * (gc - ga) - hx * (gb - ga)), 65536, nz)
    let dbdy: i32 = rdp_muldiv(0 - (mx * (bc - ba) - hx * (bb - ba)), 65536, nz)
    let dady: i32 = rdp_muldiv(0 - (mx * (ac - aa) - hx * (ab - aa)), 65536, nz)
    let drde: i32 = drdy + rdp_muldiv(drdx, hx, hy)
    let dgde: i32 = dgdy + rdp_muldiv(dgdx, hx, hy)
    let dbde: i32 = dbdy + rdp_muldiv(dbdx, hx, hy)
    let dade: i32 = dady + rdp_muldiv(dadx, hx, hy)

    rdp_rgba_hi(ra, ga, ba, aa)
    rdp_rgba_hi(drdx, dgdx, dbdx, dadx)
    rdp_rgba_lo(ra, ga, ba, aa)
    rdp_rgba_lo(drdx, dgdx, dbdx, dadx)
    rdp_rgba_hi(drde, dgde, dbde, dade)
    rdp_rgba_hi(drdy, dgdy, dbdy, dady)
    rdp_rgba_lo(drde, dgde, dbde, dade)
    rdp_rgba_lo(drdy, dgdy, dbdy, dady)

    if do_z != 0 {
        let zs: i32 = za << 16
        let dzdx: i32 = rdp_muldiv(0 - (hy * (zb - za) - my * (zc - za)), 65536, nz)
        let dzdy: i32 = rdp_muldiv(0 - (mx * (zc - za) - hx * (zb - za)), 65536, nz)
        let dzde: i32 = dzdy + rdp_muldiv(dzdx, hx, hy)
        rdp_z_coeffs(zs, dzdx, dzde, dzdy)
    }
}

fn rdpq_triangle_shade(x0: i32, y0: i32, c0: u32,
                       x1: i32, y1: i32, c1: u32,
                       x2: i32, y2: i32, c2: u32) {
    rdp_tri_shade(RDP_TRI_SHADE, x0, y0, c0, 0, x1, y1, c1, 0, x2, y2, c2, 0, 0)
}

fn rdpq_triangle_shade_z(x0: i32, y0: i32, c0: u32, z0: i32,
                         x1: i32, y1: i32, c1: u32, z1: i32,
                         x2: i32, y2: i32, c2: u32, z2: i32) {
    rdp_tri_shade(RDP_TRI_SHADE_Z, x0, y0, c0, z0, x1, y1, c1, z1, x2, y2, c2, z2, 1)
}

-- Z for TRI_TEX_Z / TRI_SHADE_TXTR_Z. Set before triangle_tex_z /
-- triangle_shade_tex_z. Same 0..32767 scale as triangle_shade_z.
static g_st_z0: i32 = 0
static g_st_z1: i32 = 0
static g_st_z2: i32 = 0

fn rdpq_set_tri_z(z0: i32, z1: i32, z2: i32) {
    g_st_z0 = z0
    g_st_z1 = z1
    g_st_z2 = z2
}

-- Shade + tex coefficients after the four edge words. Shared by 0x0E / 0x0F.
fn rdp_shade_tex_coeffs(ca: u32, cb: u32, cc: u32,
                        sa: i32, ta: i32, sb: i32, tb: i32, sc: i32, tc: i32,
                        hx: i32, hy: i32, mx: i32, my: i32, nz: i32) {
    let ra: i32 = rdp_ch(ca, 24)
    let ga: i32 = rdp_ch(ca, 16)
    let ba: i32 = rdp_ch(ca, 8)
    let aa: i32 = rdp_ch(ca, 0)
    let rb: i32 = rdp_ch(cb, 24)
    let gb: i32 = rdp_ch(cb, 16)
    let bb: i32 = rdp_ch(cb, 8)
    let ab: i32 = rdp_ch(cb, 0)
    let rc: i32 = rdp_ch(cc, 24)
    let gc: i32 = rdp_ch(cc, 16)
    let bc: i32 = rdp_ch(cc, 8)
    let ac: i32 = rdp_ch(cc, 0)
    let drdx: i32 = rdp_muldiv(0 - (hy * (rb - ra) - my * (rc - ra)), 65536, nz)
    let dgdx: i32 = rdp_muldiv(0 - (hy * (gb - ga) - my * (gc - ga)), 65536, nz)
    let dbdx: i32 = rdp_muldiv(0 - (hy * (bb - ba) - my * (bc - ba)), 65536, nz)
    let dadx: i32 = rdp_muldiv(0 - (hy * (ab - aa) - my * (ac - aa)), 65536, nz)
    let drdy: i32 = rdp_muldiv(0 - (mx * (rc - ra) - hx * (rb - ra)), 65536, nz)
    let dgdy: i32 = rdp_muldiv(0 - (mx * (gc - ga) - hx * (gb - ga)), 65536, nz)
    let dbdy: i32 = rdp_muldiv(0 - (mx * (bc - ba) - hx * (bb - ba)), 65536, nz)
    let dady: i32 = rdp_muldiv(0 - (mx * (ac - aa) - hx * (ab - aa)), 65536, nz)
    let drde: i32 = drdy + rdp_muldiv(drdx, hx, hy)
    let dgde: i32 = dgdy + rdp_muldiv(dgdx, hx, hy)
    let dbde: i32 = dbdy + rdp_muldiv(dbdx, hx, hy)
    let dade: i32 = dady + rdp_muldiv(dadx, hx, hy)
    rdp_rgba_hi(ra, ga, ba, aa)
    rdp_rgba_hi(drdx, dgdx, dbdx, dadx)
    rdp_rgba_lo(ra, ga, ba, aa)
    rdp_rgba_lo(drdx, dgdx, dbdx, dadx)
    rdp_rgba_hi(drde, dgde, dbde, dade)
    rdp_rgba_hi(drdy, dgdy, dbdy, dady)
    rdp_rgba_lo(drde, dgde, dbde, dade)
    rdp_rgba_lo(drdy, dgdy, dbdy, dady)

    let ss0: i32 = sa * 32
    let tt0: i32 = ta * 32
    let ss1: i32 = sb * 32
    let tt1: i32 = tb * 32
    let ss2: i32 = sc * 32
    let tt2: i32 = tc * 32
    let dsdx: i32 = rdp_muldiv(0 - (hy * (ss1 - ss0) - my * (ss2 - ss0)), 65536, nz)
    let dtdx: i32 = rdp_muldiv(0 - (hy * (tt1 - tt0) - my * (tt2 - tt0)), 65536, nz)
    let dsdy: i32 = rdp_muldiv(0 - (mx * (ss2 - ss0) - hx * (ss1 - ss0)), 65536, nz)
    let dtdy: i32 = rdp_muldiv(0 - (mx * (tt2 - tt0) - hx * (tt1 - tt0)), 65536, nz)
    let dsde: i32 = dsdy + rdp_muldiv(dsdx, hx, hy)
    let dtde: i32 = dtdy + rdp_muldiv(dtdx, hx, hy)
    let sfix: i32 = ss0 * 65536
    let tfix: i32 = tt0 * 65536
    let wfix: i32 = 0x7FFF0000
    rdp_tex_hi(sfix, tfix, wfix)
    rdp_tex_hi(dsdx, dtdx, 0)
    rdp_tex_lo(sfix, tfix, wfix)
    rdp_tex_lo(dsdx, dtdx, 0)
    rdp_tex_hi(dsde, dtde, 0)
    rdp_tex_hi(dsdy, dtdy, 0)
    rdp_tex_lo(dsde, dtde, 0)
    rdp_tex_lo(dsdy, dtdy, 0)
}

fn rdpq_triangle_shade_tex(tile: u32,
                           x0: i32, y0: i32, c0: u32, s0: i32, t0: i32,
                           x1: i32, y1: i32, c1: u32, s1: i32, t1: i32,
                           x2: i32, y2: i32, c2: u32, s2: i32, t2: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut ca: u32 = c0
    let mut sa: i32 = s0
    let mut ta: i32 = t0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut cb: u32 = c1
    let mut sb: i32 = s1
    let mut tb: i32 = t1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut cc: u32 = c2
    let mut sc: i32 = s2
    let mut tc: i32 = t2
    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tco: u32 = ca; let ts: i32 = sa; let tt: i32 = ta
        xa = xb; ya = yb; ca = cb; sa = sb; ta = tb
        xb = tx; yb = ty; cb = tco; sb = ts; tb = tt
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tco: u32 = ca; let ts: i32 = sa; let tt: i32 = ta
        xa = xc; ya = yc; ca = cc; sa = sc; ta = tc
        xc = tx; yc = ty; cc = tco; sc = ts; tc = tt
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let tco: u32 = cb; let ts: i32 = sb; let tt: i32 = tb
        xb = xc; yb = yc; cb = cc; sb = sc; tb = tc
        xc = tx; yc = ty; cc = tco; sc = ts; tc = tt
    }
    if ya == yc { return }
    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }
    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)
    dl_cmd((RDP_TRI_SHADE_TXTR << 24) | (lft << 23) | ((tile & 7) << 16) | to_fx142(yc),
           (to_fx142(yb) << 16) | to_fx142(ya))
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)
    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    rdp_shade_tex_coeffs(ca, cb, cc, sa, ta, sb, tb, sc, tc,
                         hx, hy, mx, my, hx * my - hy * mx)
}

fn rdpq_triangle_shade_tex_z(tile: u32,
                             x0: i32, y0: i32, c0: u32, s0: i32, t0: i32,
                             x1: i32, y1: i32, c1: u32, s1: i32, t1: i32,
                             x2: i32, y2: i32, c2: u32, s2: i32, t2: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut ca: u32 = c0
    let mut sa: i32 = s0
    let mut ta: i32 = t0
    let mut za: i32 = g_st_z0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut cb: u32 = c1
    let mut sb: i32 = s1
    let mut tb: i32 = t1
    let mut zb: i32 = g_st_z1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut cc: u32 = c2
    let mut sc: i32 = s2
    let mut tc: i32 = t2
    let mut zc: i32 = g_st_z2
    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tco: u32 = ca
        let ts: i32 = sa; let tt: i32 = ta; let tz: i32 = za
        xa = xb; ya = yb; ca = cb; sa = sb; ta = tb; za = zb
        xb = tx; yb = ty; cb = tco; sb = ts; tb = tt; zb = tz
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let tco: u32 = ca
        let ts: i32 = sa; let tt: i32 = ta; let tz: i32 = za
        xa = xc; ya = yc; ca = cc; sa = sc; ta = tc; za = zc
        xc = tx; yc = ty; cc = tco; sc = ts; tc = tt; zc = tz
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let tco: u32 = cb
        let ts: i32 = sb; let tt: i32 = tb; let tz: i32 = zb
        xb = xc; yb = yc; cb = cc; sb = sc; tb = tc; zb = zc
        xc = tx; yc = ty; cc = tco; sc = ts; tc = tt; zc = tz
    }
    if ya == yc { return }
    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }
    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)
    dl_cmd((RDP_TRI_SHADE_TXTR_Z << 24) | (lft << 23) | ((tile & 7) << 16) | to_fx142(yc),
           (to_fx142(yb) << 16) | to_fx142(ya))
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)
    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    let nz: i32 = hx * my - hy * mx
    rdp_shade_tex_coeffs(ca, cb, cc, sa, ta, sb, tb, sc, tc, hx, hy, mx, my, nz)
    let zs: i32 = za << 16
    let dzdx: i32 = rdp_muldiv(0 - (hy * (zb - za) - my * (zc - za)), 65536, nz)
    let dzdy: i32 = rdp_muldiv(0 - (mx * (zc - za) - hx * (zb - za)), 65536, nz)
    rdp_z_coeffs(zs, dzdx, dzdy + rdp_muldiv(dzdx, hx, hy), dzdy)
}

-- Affine TRI_TEX_Z (0x0B). Same ST as triangle_tex; Z from rdpq.set_tri_z.
fn rdpq_triangle_tex_z(tile: u32,
                       x0: i32, y0: i32, s0: i32, t0: i32,
                       x1: i32, y1: i32, s1: i32, t1: i32,
                       x2: i32, y2: i32, s2: i32, t2: i32) {
    let mut xa: i32 = x0
    let mut ya: i32 = y0
    let mut sa: i32 = s0
    let mut ta: i32 = t0
    let mut za: i32 = g_st_z0
    let mut xb: i32 = x1
    let mut yb: i32 = y1
    let mut sb: i32 = s1
    let mut tb: i32 = t1
    let mut zb: i32 = g_st_z1
    let mut xc: i32 = x2
    let mut yc: i32 = y2
    let mut sc: i32 = s2
    let mut tc: i32 = t2
    let mut zc: i32 = g_st_z2

    if yb < ya {
        let tx: i32 = xa; let ty: i32 = ya; let ts: i32 = sa; let tt: i32 = ta; let tz: i32 = za
        xa = xb; ya = yb; sa = sb; ta = tb; za = zb
        xb = tx; yb = ty; sb = ts; tb = tt; zb = tz
    }
    if yc < ya {
        let tx: i32 = xa; let ty: i32 = ya; let ts: i32 = sa; let tt: i32 = ta; let tz: i32 = za
        xa = xc; ya = yc; sa = sc; ta = tc; za = zc
        xc = tx; yc = ty; sc = ts; tc = tt; zc = tz
    }
    if yc < yb {
        let tx: i32 = xb; let ty: i32 = yb; let ts: i32 = sb; let tt: i32 = tb; let tz: i32 = zb
        xb = xc; yb = yc; sb = sc; tb = tc; zb = zc
        xc = tx; yc = ty; sc = ts; tc = tt; zc = tz
    }
    if ya == yc { return }

    let mut lft: u32 = 0
    if (yc - ya) * (xb - xa) > (xc - xa) * (yb - ya) { lft = 1 }

    let dxhdy: i32 = rdp_edge_slope(xc - xa, yc - ya)
    let dxmdy: i32 = rdp_edge_slope(xb - xa, yb - ya)
    let dxldy: i32 = rdp_edge_slope(xc - xb, yc - yb)

    dl_cmd((RDP_TRI_TEX_Z << 24) | (lft << 23) | ((tile & 7) << 16) | to_fx142(yc),
           (to_fx142(yb) << 16) | to_fx142(ya))
    dl_cmd((xb * 65536) as u32, dxldy as u32)
    dl_cmd((xa * 65536) as u32, dxhdy as u32)
    dl_cmd((xa * 65536) as u32, dxmdy as u32)

    let ss0: i32 = sa * 32
    let tt0: i32 = ta * 32
    let ss1: i32 = sb * 32
    let tt1: i32 = tb * 32
    let ss2: i32 = sc * 32
    let tt2: i32 = tc * 32
    let hx: i32 = xc - xa
    let hy: i32 = yc - ya
    let mx: i32 = xb - xa
    let my: i32 = yb - ya
    let nz: i32 = hx * my - hy * mx
    let dsdx: i32 = rdp_muldiv(0 - (hy * (ss1 - ss0) - my * (ss2 - ss0)), 65536, nz)
    let dtdx: i32 = rdp_muldiv(0 - (hy * (tt1 - tt0) - my * (tt2 - tt0)), 65536, nz)
    let dsdy: i32 = rdp_muldiv(0 - (mx * (ss2 - ss0) - hx * (ss1 - ss0)), 65536, nz)
    let dtdy: i32 = rdp_muldiv(0 - (mx * (tt2 - tt0) - hx * (tt1 - tt0)), 65536, nz)
    let dsde: i32 = dsdy + rdp_muldiv(dsdx, hx, hy)
    let dtde: i32 = dtdy + rdp_muldiv(dtdx, hx, hy)
    let sfix: i32 = ss0 * 65536
    let tfix: i32 = tt0 * 65536
    let wfix: i32 = 0x7FFF0000
    rdp_tex_hi(sfix, tfix, wfix)
    rdp_tex_hi(dsdx, dtdx, 0)
    rdp_tex_lo(sfix, tfix, wfix)
    rdp_tex_lo(dsdx, dtdx, 0)
    rdp_tex_hi(dsde, dtde, 0)
    rdp_tex_hi(dsdy, dtdy, 0)
    rdp_tex_lo(dsde, dtde, 0)
    rdp_tex_lo(dsdy, dtdy, 0)

    let zs: i32 = za << 16
    let dzdx: i32 = rdp_muldiv(0 - (hy * (zb - za) - my * (zc - za)), 65536, nz)
    let dzdy: i32 = rdp_muldiv(0 - (mx * (zc - za) - hx * (zb - za)), 65536, nz)
    rdp_z_coeffs(zs, dzdx, dzdy + rdp_muldiv(dzdx, hx, hy), dzdy)
}

-- ── syncs ──────────────────────────────────────────────────────────────────

-- SYNC_FULL is the only sync that also drains the pipe, so it submits.
fn rdpq_sync_full() {
    dl_cmd(RDP_SYNC_FULL << 24, 0)
    dl_submit()
}

fn rdpq_sync_pipe() {
    dl_cmd(RDP_SYNC_PIPE << 24, 0)
}

fn rdpq_sync_tile() {
    dl_cmd(RDP_SYNC_TILE << 24, 0)
}

fn rdpq_sync_load() {
    dl_cmd(RDP_SYNC_LOAD << 24, 0)
}

-- ── libc-style memory helpers (no libc in the standalone build) ─────────────
fn memset(dst: *u8, val: i32, n: i32) -> *u8 {
    let b: u8 = (val & 0xFF) as u8
    let mut i: i32 = 0
    while i < n {
        dst[i] = b
        i = i + 1
    }
    return dst
}

fn memcpy(dst: *u8, src: *u8, n: i32) -> *u8 {
    let mut i: i32 = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
    return dst
}

-- ── Timer (COP0 Count) ──────────────────────────────────────────────────────
-- The VR4300's Count register increments at half the CPU clock: 93.75 MHz / 2.
-- Reading it needs `mfc0`, which Pak cannot express, so the asm block parks the
-- value in a static and the function returns that.
const TICKS_PER_SECOND: u32 = 46875000

static g_ticks_tmp: u32 = 0
static g_last_ticks: u32 = 0

fn timer_init() {
    -- Count runs from reset; nothing to set up. Seed the delta baseline.
    g_last_ticks = get_ticks()
}

fn get_ticks() -> u32 {
    asm {
        "mfc0 $t0, $9"
        "la $t1, g_ticks_tmp"
        "sw $t0, 0($t1)"
    }
    return g_ticks_tmp
}

-- Seconds since the previous call. Count wraps every ~91 s; unsigned
-- subtraction gives the right delta across the wrap.
fn _pak_delta_time() -> f32 {
    let now: u32 = get_ticks()
    let delta: u32 = now - g_last_ticks
    g_last_ticks = now
    return (delta as f32) / (TICKS_PER_SECOND as f32)
}

-- ── PI DMA (cartridge <-> RDRAM) ────────────────────────────────────────────
const PI_DRAM_ADDR: u32 = 0xA4600000
const PI_CART_ADDR: u32 = 0xA4600004
const PI_RD_LEN:    u32 = 0xA4600008
const PI_WR_LEN:    u32 = 0xA460000C
const PI_STATUS:    u32 = 0xA4600010

const PI_STATUS_DMA_BUSY: u32 = 0x01
const PI_STATUS_IO_BUSY:  u32 = 0x02
const PI_STATUS_CLR_INTR: u32 = 0x02

fn dma_wait() {
    loop {
        let st: u32 = vi_read(PI_STATUS)
        if (st & (PI_STATUS_DMA_BUSY | PI_STATUS_IO_BUSY)) == 0 { break }
    }
}

fn data_cache_hit_writeback_invalidate(ptr: *u8, sz: i32) {
    data_cache_hit_writeback(ptr, sz)
    data_cache_hit_invalidate(ptr, sz)
}

-- Cartridge -> RDRAM. PI_WR_LEN is the one that writes *to* RDRAM; the length
-- register takes one less than the byte count. The caller is responsible for
-- cache maintenance around this (the checker enforces it: E201/E202).
fn dma_read(dst: *u8, cart: u32, len: i32) {
    dma_wait()
    vi_write(PI_STATUS, PI_STATUS_CLR_INTR)
    vi_write(PI_DRAM_ADDR, (dst as u32) & 0x00FFFFFF)
    vi_write(PI_CART_ADDR, cart)
    vi_write(PI_WR_LEN, (len - 1) as u32)
    dma_wait()
}

-- RDRAM -> cartridge (SRAM / FlashRAM carts). PI_RD_LEN reads *from* RDRAM.
fn dma_write(src: *u8, cart: u32, len: i32) {
    dma_wait()
    vi_write(PI_STATUS, PI_STATUS_CLR_INTR)
    vi_write(PI_DRAM_ADDR, (src as u32) & 0x00FFFFFF)
    vi_write(PI_CART_ADDR, cart)
    vi_write(PI_RD_LEN, (len - 1) as u32)
    dma_wait()
}

-- ── EEPROM (SI / PIF Joybus channel 4) ──────────────────────────────────────
-- Cartridge EEPROM is not on the PI. Identify / read / write go through the
-- same SI DMA as the controllers, with channels 0–3 skipped (0x00) and
-- channel 4 holding the command. Byte 63 of PIF RAM is 0x01 to run; 0xFE
-- ends the channel list.
--
-- Identify (cmd 0x00) replies 00 80 00 (4 Kbit) or 00 C0 00 (16 Kbit).
-- Read    (cmd 0x04 + block) replies 8 data bytes.
-- Write   (cmd 0x05 + block + 8 data) replies 1 status byte.
-- There is no EEPROM in the simulator, so present() is 0 unless PIF RAM
-- actually replies. Command bytes and SI MMIO are still the real sequence.
const EEPROM_NONE: i32 = 0
const EEPROM_4K:   i32 = 1
const EEPROM_16K:  i32 = 2

static g_eeprom_probed: i32 = 0
static g_eeprom_type:   i32 = 0

fn eeprom_probe() -> i32 {
    if g_eeprom_probed != 0 { return g_eeprom_type }
    pif_zero()
    let b: u32 = pif_addr()
    -- skip ch0–3 (already 0); ch4 identify: tx=1 rx=3 cmd=0x00
    poke8(b + 4, 0x01)
    poke8(b + 5, 0x03)
    poke8(b + 10, 0xFE)
    poke8(b + 63, 0x01)
    si_exec()
    let r0: i32 = peek8(b + 7) as i32
    let r1: i32 = peek8(b + 8) as i32
    let r2: i32 = peek8(b + 9) as i32
    let t: i32 = 0
    if r0 == 0 and r2 == 0 {
        if r1 == 0x80 { t = EEPROM_4K }
        if r1 == 0xC0 { t = EEPROM_16K }
    }
    g_eeprom_type = t
    g_eeprom_probed = 1
    return t
}

fn eeprom_init() {
    g_eeprom_probed = 0
    g_eeprom_type = 0
    eeprom_probe()
}

fn eeprom_present() -> i32 {
    if eeprom_probe() == 0 { return 0 }
    return 1
}

fn eeprom_type_detect() -> i32 {
    return eeprom_probe()
}

fn eeprom_read(block: i32, dst: *u8) {
    pif_zero()
    let b: u32 = pif_addr()
    poke8(b + 4, 0x02)
    poke8(b + 5, 0x08)
    poke8(b + 6, 0x04)
    poke8(b + 7, block)
    poke8(b + 16, 0xFE)
    poke8(b + 63, 0x01)
    si_exec()
    let d: u32 = dst as u32
    let mut i: i32 = 0
    while i < 8 {
        poke8(d + i as u32, peek8(b + (8 + i) as u32))
        i = i + 1
    }
}

fn eeprom_write(block: i32, src: *u8) {
    pif_zero()
    let b: u32 = pif_addr()
    poke8(b + 4, 0x0A)
    poke8(b + 5, 0x01)
    poke8(b + 6, 0x05)
    poke8(b + 7, block)
    let s: u32 = src as u32
    let mut i: i32 = 0
    while i < 8 {
        poke8(b + (8 + i) as u32, peek8(s + i as u32))
        i = i + 1
    }
    poke8(b + 17, 0xFE)
    poke8(b + 63, 0x01)
    si_exec()
}

-- ── Audio Interface (16-bit stereo PCM) ─────────────────────────────────────
-- AI DMA streams interleaved L/R i16 samples from RDRAM to the DAC. Buffers
-- live in cached KSEG0 just after the display list; we writeback before each
-- kick. Two slots can be queued (STATUS.FULL); get_buffer returns none when
-- both are occupied. A fill-only loop (get_buffer, write samples, repeat)
-- auto-submits the previous buffer so audio.write is optional.
const AI_DRAM_ADDR: u32 = 0xA4500000
const AI_LEN:       u32 = 0xA4500004
const AI_CONTROL:   u32 = 0xA4500008
const AI_STATUS:    u32 = 0xA450000C
const AI_DACRATE:   u32 = 0xA4500010
const AI_BITRATE:   u32 = 0xA4500014
const AI_FULL:      u32 = 0x80000000
const AI_NTSC_CLOCK: i32 = 48681818
const AUDIO_BASE:    u32 = 0x80299000   -- after DL, before heap
const AUDIO_SPAN:    i32 = 0x7000       -- 28 KB until HEAP_BASE
const AUDIO_MAX_BUFS: i32 = 8

static g_audio_freq:  i32 = 0
static g_audio_nbuf:  i32 = 0
static g_audio_bytes: i32 = 0
static g_audio_next:  i32 = 0
static g_audio_have:  i32 = 0

fn audio_ai_full() -> i32 {
    if (vi_read(AI_STATUS) & AI_FULL) != 0 { return 1 }
    return 0
}

fn audio_buf_addr(i: i32) -> u32 {
    return AUDIO_BASE + (i * g_audio_bytes) as u32
}

fn audio_kick(i: i32) {
    let addr: u32 = audio_buf_addr(i)
    data_cache_hit_writeback(addr as *u8, g_audio_bytes)
    vi_write(AI_DRAM_ADDR, addr & 0x00FFFFFF)
    vi_write(AI_LEN, g_audio_bytes as u32)
    vi_write(AI_CONTROL, 1)
}

fn audio_init(frequency: i32, buffers: i32) {
    let mut freq: i32 = frequency
    if freq != 22050 {
        if freq != 32000 { freq = 44100 }
    }
    let mut n: i32 = buffers
    if n < 2 { n = 2 }
    if n > AUDIO_MAX_BUFS { n = AUDIO_MAX_BUFS }

    -- One 1/60 s of stereo i16, length a multiple of 8 (AI) and 16 (cache).
    let mut frames: i32 = (freq + 59) / 60
    if (frames & 1) != 0 { frames = frames + 1 }
    let mut bytes: i32 = frames * 4
    bytes = (bytes + 15) & 0xFFFFFFF0
    if n * bytes > AUDIO_SPAN { n = AUDIO_SPAN / bytes }

    let dacrate: i32 = ((2 * AI_NTSC_CLOCK / freq) + 1) / 2
    let mut bitrate: i32 = dacrate / 66
    if bitrate > 16 { bitrate = 16 }
    if bitrate < 1 { bitrate = 1 }

    vi_write(AI_CONTROL, 0)
    vi_write(AI_DACRATE, (dacrate - 1) as u32)
    vi_write(AI_BITRATE, (bitrate - 1) as u32)
    vi_write(AI_STATUS, 0)
    vi_write(AI_CONTROL, 1)

    g_audio_freq = freq
    g_audio_nbuf = n
    g_audio_bytes = bytes
    g_audio_next = 0
    g_audio_have = 0

    let mut i: i32 = 0
    while i < n {
        memset(audio_buf_addr(i) as *u8, 0, bytes)
        i = i + 1
    }
}

fn audio_close() {
    vi_write(AI_CONTROL, 0)
    vi_write(AI_DACRATE, 0)
    vi_write(AI_BITRATE, 0)
    g_audio_freq = 0
    g_audio_nbuf = 0
    g_audio_bytes = 0
    g_audio_next = 0
    g_audio_have = 0
}

fn audio_get_frequency() -> i32 {
    return g_audio_freq
}

fn audio_can_write() -> i32 {
    if g_audio_freq == 0 { return 0 }
    if audio_ai_full() != 0 { return 0 }
    return 1
}

fn audio_get_buffer() -> *i16 {
    if g_audio_freq == 0 { return 0 as *i16 }
    if g_audio_have != 0 {
        if audio_ai_full() != 0 { return 0 as *i16 }
        audio_kick(g_audio_next)
        g_audio_next = (g_audio_next + 1) % g_audio_nbuf
        g_audio_have = 0
    }
    if audio_ai_full() != 0 { return 0 as *i16 }
    g_audio_have = 1
    return audio_buf_addr(g_audio_next) as *i16
}

fn audio_write(buf: *i16) {
    if g_audio_freq == 0 { return }
    loop {
        if audio_ai_full() == 0 { break }
    }
    let mut i: i32 = 0
    let want: u32 = buf as u32
    while i < g_audio_nbuf {
        if audio_buf_addr(i) == want {
            audio_kick(i)
            g_audio_next = (i + 1) % g_audio_nbuf
            g_audio_have = 0
            return
        }
        i = i + 1
    }
    audio_kick(g_audio_next)
    g_audio_next = (g_audio_next + 1) % g_audio_nbuf
    g_audio_have = 0
}

fn audio_write_silence() {
    if g_audio_freq == 0 { return }
    let buf: *i16 = audio_get_buffer()
    if buf == none { return }
    memset(buf as *u8, 0, g_audio_bytes)
    audio_write(buf)
}

fn audio_set_buffer_num(n: i32) {
    if g_audio_freq == 0 { return }
    let mut b: i32 = n
    if b < 2 { b = 2 }
    if b > AUDIO_MAX_BUFS { b = AUDIO_MAX_BUFS }
    if b * g_audio_bytes > AUDIO_SPAN { b = AUDIO_SPAN / g_audio_bytes }
    g_audio_nbuf = b
    g_audio_next = 0
    g_audio_have = 0
}


-- ── Heap (bump allocator) ───────────────────────────────────────────────────
-- Cached RDRAM above the framebuffers, Z, display list and audio PCM, below
-- the stack. Freeing is a no-op: a game that needs reuse should use an arena.
const HEAP_BASE:  u32 = 0x802A0000
const HEAP_LIMIT: u32 = 0x803C0000

static g_heap_ptr: u32 = 0

fn __pak_alloc(size: i32) -> *u8 {
    if g_heap_ptr == 0 { g_heap_ptr = HEAP_BASE }
    let aligned: u32 = ((size as u32) + 7) & 0xFFFFFFF8
    if g_heap_ptr + aligned > HEAP_LIMIT { return 0 as *u8 }
    let p: u32 = g_heap_ptr
    g_heap_ptr = g_heap_ptr + aligned
    return p as *u8
}

fn __pak_free(p: *u8) {
}

-- ── Fixed point ─────────────────────────────────────────────────────────────
-- fix16.16 divide: (a << 16) / b, with the shift done in 64-bit-free steps so
-- the intermediate does not overflow for the usual operand ranges.
fn __pak_fix16_div(a: i32, b: i32) -> i32 {
    if b == 0 { return 0 }
    return (a * 65536) / b
}

-- ── CPU exceptions ──────────────────────────────────────────────────────────
-- crt0 copies a trampoline to 0x80000000/80/100/180 and jal's exception_paint
-- on a crash (or jalr's g_exc_handler if the game installed one). Paint fills
-- every framebuffer solid red and points the VI at FB0 so a crash is visible
-- even if display.init never ran. Does not hang: boot.S hangs after the jal.
static g_exc_handler: u32 = 0

fn exception_set_handler(h: *u8) {
    g_exc_handler = h as u32
}

fn exception_get_handler() -> *u8 {
    return g_exc_handler as *u8
}

fn exception_paint() {
    vi_program()
    fb_fill(FB0, CRASH_RED)
    fb_fill(FB1, CRASH_RED)
    fb_fill(FB2, CRASH_RED)
    vi_write(VI_ORIGIN, FB0 & 0x00FFFFFF)
}

fn __pak_panic() {
    exception_paint()
    loop { }
}

fn assert(cond: i32) {
    if cond == 0 { __pak_panic() }
}

-- No ISViewer on a bare cartridge; debug output is a no-op rather than a
-- link error.
fn debugf(fmt: *u8) {
}

-- ── libc-style string helpers ───────────────────────────────────────────────
fn strlen(s: *u8) -> i32 {
    let mut i: i32 = 0
    while s[i] != 0 as u8 {
        i = i + 1
    }
    return i
}

fn strcmp(a: *u8, b: *u8) -> i32 {
    let mut i: i32 = 0
    loop {
        let ca: u8 = a[i]
        let cb: u8 = b[i]
        if ca != cb { return (ca as i32) - (cb as i32) }
        if ca == 0 as u8 { return 0 }
        i = i + 1
    }
}

fn strncmp(a: *u8, b: *u8, n: i32) -> i32 {
    let mut i: i32 = 0
    while i < n {
        let ca: u8 = a[i]
        let cb: u8 = b[i]
        if ca != cb { return (ca as i32) - (cb as i32) }
        if ca == 0 as u8 { return 0 }
        i = i + 1
    }
    return 0
}

fn memcmp(a: *u8, b: *u8, n: i32) -> i32 {
    let mut i: i32 = 0
    while i < n {
        if a[i] != b[i] { return (a[i] as i32) - (b[i] as i32) }
        i = i + 1
    }
    return 0
}

fn strstr(hay: *u8, needle: *u8) -> *u8 {
    let nlen: i32 = strlen(needle)
    if nlen == 0 { return hay }
    let hlen: i32 = strlen(hay)
    let mut i: i32 = 0
    while i + nlen <= hlen {
        let mut j: i32 = 0
        let mut same: i32 = 1
        while j < nlen {
            if hay[i + j] != needle[j] { same = 0; break }
            j = j + 1
        }
        if same == 1 { return (hay as u32 + i as u32) as *u8 }
        i = i + 1
    }
    return 0 as *u8
}

-- ── the interrupt handler ─────────────────────────────────────────────────
-- boot.S jal's this from the general exception vector once it has established
-- that the exception is an interrupt on IP2 and saved the caller-saved state.
-- It must acknowledge every source it finds asserting: the RCP holds the line
-- high until the device is told to drop it, so a source left unacknowledged
-- re-enters this handler forever.
--
-- Do not call anything here that waits on hardware. Status.EXL is set for the
-- whole of it, so nothing else can be serviced until it returns.
fn __pak_irq() {
    -- MI_INTERRUPT shows every source asserting, including ones whose mask
    -- bit is clear and whose flag therefore belongs to nobody here.
    let pending: u32 = vi_read(MI_INTERRUPT) & g_irq_mask
    g_irq_seen = g_irq_seen | pending

    if (pending & MI_INTR_VI) != 0 {
        -- Any write to VI_V_CURRENT drops the VI's line.
        vi_write(VI_V_CURRENT, 0)
        g_vi_count = g_vi_count + 1
    }
    if (pending & MI_INTR_PI) != 0 {
        -- PI_STATUS bit 1 is "clear interrupt".
        vi_write(PI_STATUS, 0x02)
    }
    if (pending & MI_INTR_SI) != 0 {
        vi_write(SI_STATUS, 0)
    }
    if (pending & MI_INTR_AI) != 0 {
        vi_write(AI_STATUS, 0)
    }
    if (pending & MI_INTR_SP) != 0 {
        -- SP_STATUS bit 3 clears the RSP's interrupt.
        vi_write(SP_STATUS, 0x08)
    }
    if (pending & MI_INTR_DP) != 0 {
        -- MI_MODE bit 11 clears the DP interrupt.
        vi_write(MI_MODE, 0x0800)
    }
}

-- ── interrupt API (called by generated game code) ─────────────────────────
fn interrupt_init() {
    if g_irq_on != 0 { return }
    -- Start from a clean slate: mask everything off, then arm just the VI.
    vi_write(MI_MASK, MI_MASK_CLEAR_ALL)
    vi_write(VI_V_CURRENT, 0)
    vi_write(VI_V_INTR, VI_INTR_LINE)
    vi_write(MI_MASK, MI_MASK_SET_VI)
    g_irq_mask = MI_INTR_VI
    g_irq_on = 1
    __pak_irq_enable()
}

fn interrupt_disable() -> u32 {
    return __pak_irq_disable()
}

fn interrupt_restore(status: u32) {
    __pak_irq_restore(status)
}

fn interrupt_vi_count() -> u32 {
    return g_vi_count
}

fn interrupt_pending() -> u32 {
    return g_irq_seen
}

fn interrupt_enabled() -> i32 {
    return g_irq_on
}

-- ── RSP (Reality Signal Processor) ────────────────────────────────────────
-- Enough to load a microcode task, run it, and get its results back. Pak does
-- not compile to the RSP -- it is a different instruction set with a vector
-- unit -- so a task's words come from somewhere else and this moves them.
--
-- The scalar half of the RSP is a MIPS I subset, which means tcl/n64enc.tcl
-- can assemble a task: see tcl/tests/ares/rsp_add.S and the gate that keeps
-- its listing and the words a program ships in step.

fn sp_wait_dma() {
    loop {
        let st: u32 = vi_read(SP_STATUS)
        if (st & (SP_ST_DMA_BUSY | SP_ST_DMA_FULL)) == 0 { break }
    }
}

-- One SP DMA. `mem` is an SP_MEM_ADDR value (add SP_IMEM for instruction
-- memory), `ram` a cached or uncached RDRAM pointer, `len` a byte count.
-- Both addresses and the length must be multiples of 8; a misaligned transfer
-- is silently truncated by the hardware rather than refused, so it is checked
-- here instead.
fn sp_dma(mem: u32, ram: u32, len: u32, to_rsp: i32) {
    if (mem & 7) != 0 { __pak_panic() }
    if (ram & 7) != 0 { __pak_panic() }
    if (len & 7) != 0 { __pak_panic() }
    if len == 0 { return }
    sp_wait_dma()
    let p_mem: *volatile u32 = SP_MEM_ADDR as *volatile u32
    *p_mem = mem
    let p_ram: *volatile u32 = SP_DRAM_ADDR as *volatile u32
    *p_ram = ram & 0x1FFFFFFF
    if to_rsp != 0 {
        let p_rd: *volatile u32 = SP_RD_LEN as *volatile u32
        *p_rd = len - 1
    } else {
        let p_wr: *volatile u32 = SP_WR_LEN as *volatile u32
        *p_wr = len - 1
    }
    sp_wait_dma()
}

fn pak_sp_init() {
    -- Park the RSP: halted, no pending break, no single step, and no
    -- interrupt on break. A task that wants the interrupt asks for it.
    let p: *volatile u32 = SP_STATUS as *volatile u32
    let park: u32 = SP_SET_SET_HALT | SP_SET_CLR_BROKE | SP_SET_CLR_INTR
    *p = park | SP_SET_CLR_SSTEP | SP_SET_CLR_INTBRK
    sp_wait_dma()
}

-- Copy a microcode image from RDRAM into IMEM. `src` must be writeback-clean:
-- the SP DMA reads RDRAM directly and does not see the CPU's data cache.
fn pak_sp_load_ucode(src: u32, len: u32) {
    data_cache_hit_writeback(src as *u8, len as i32)
    sp_dma(SP_IMEM, src, len, 1)
}

fn pak_sp_load_data(src: u32, dmem_off: u32, len: u32) {
    data_cache_hit_writeback(src as *u8, len as i32)
    sp_dma(dmem_off, src, len, 1)
}

fn pak_sp_read_data(dst: u32, dmem_off: u32, len: u32) {
    sp_dma(dmem_off, dst, len, 0)
    data_cache_hit_invalidate(dst as *u8, len as i32)
}

-- Start the task at an IMEM byte offset. SP_PC only takes a write while the
-- RSP is halted, so this sets halt, points it, and then releases it.
fn pak_sp_run(pc: u32) {
    let p_st: *volatile u32 = SP_STATUS as *volatile u32
    *p_st = SP_SET_SET_HALT | SP_SET_CLR_BROKE
    let p_pc: *volatile u32 = SP_PC as *volatile u32
    *p_pc = pc & 0xFFC
    *p_st = SP_SET_CLR_HALT
}

fn pak_sp_done() -> i32 {
    let st: u32 = vi_read(SP_STATUS)
    if (st & (SP_ST_HALT | SP_ST_BROKE)) != 0 { return 1 }
    return 0
}

fn pak_sp_wait() {
    loop {
        if pak_sp_done() != 0 { break }
    }
    sp_wait_dma()
}

fn pak_sp_status() -> u32 {
    return vi_read(SP_STATUS)
}

-- ── math ──────────────────────────────────────────────────────────────────
-- The whole n64.math surface, in Pak. On the libdragon backend these lower to
-- <math.h>; there is no libm here, so the standalone HAL has to be the
-- implementation. Everything below is f32 -- the VR4300's FPU is
-- single-precision for the codegen's purposes and Pak has no f64.
--
-- Accuracy: sin/cos are a six-term Taylor series on a quadrant-reduced
-- argument (error under 1e-7, at f32's own resolution); atan2 is a
-- five-coefficient minimax (about 1e-5); sqrt is Newton-Raphson from a scaled
-- seed, which reaches f32 precision in four steps. Good enough for a game,
-- and none of it allocates or waits.

const PAK_PI: f32      = 3.14159265
const PAK_TWO_PI: f32  = 6.28318531
const PAK_HALF_PI: f32 = 1.57079633
const PAK_LN2: f32     = 0.69314718

fn math_abs_i32(x: i32) -> i32 {
    if x < 0 { return 0 - x }
    return x
}

fn math_min_i32(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn math_max_i32(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn math_clamp_i32(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn math_abs_f(x: f32) -> f32 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn math_min_f(a: f32, b: f32) -> f32 {
    if a < b { return a }
    return b
}

fn math_max_f(a: f32, b: f32) -> f32 {
    if a > b { return a }
    return b
}

fn math_clamp_f(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn math_lerp_f(a: f32, b: f32, t: f32) -> f32 {
    return a + (b - a) * t
}

-- `as i32` truncates toward zero, so the negative cases need the extra step.
-- Valid for |x| < 2^31; beyond that the cast itself is undefined.
fn math_floor_f(x: f32) -> f32 {
    let t: f32 = (x as i32) as f32
    if x < 0.0 and t != x { return t - 1.0 }
    return t
}

fn math_ceil_f(x: f32) -> f32 {
    let t: f32 = (x as i32) as f32
    if x > 0.0 and t != x { return t + 1.0 }
    return t
}

fn math_fix_to_f(v: i32) -> f32 {
    return (v as f32) / 65536.0
}

fn math_f_to_fix(v: f32) -> i32 {
    return (v * 65536.0) as i32
}

-- ── sqrt ──────────────────────────────────────────────────────────────────
-- Scale into [1, 4) by powers of four, Newton there, then scale the answer by
-- the matching power of two. The scaling is what makes four iterations enough
-- whatever the magnitude: Pak has no way to reinterpret a float's bits, so
-- the usual exponent hack for the seed is not available.
fn math_sqrt_f(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    let mut m: f32 = x
    let mut k: i32 = 0
    while m >= 4.0 {
        m = m * 0.25
        k = k + 1
    }
    while m < 1.0 {
        m = m * 4.0
        k = k - 1
    }
    let mut y: f32 = 0.5 * (m + 1.0)
    y = 0.5 * (y + m / y)
    y = 0.5 * (y + m / y)
    y = 0.5 * (y + m / y)
    y = 0.5 * (y + m / y)
    while k > 0 {
        y = y * 2.0
        k = k - 1
    }
    while k < 0 {
        y = y * 0.5
        k = k + 1
    }
    return y
}

-- ── sin / cos / tan ───────────────────────────────────────────────────────
-- Fold into [0, PI/2] using sin(-t) = -sin(t) and sin(PI - t) = sin(t), then
-- Taylor. Six terms over a quarter turn is past f32's own resolution; over the
-- whole turn it would not be, which is why the folding comes first.
fn math_sin_f(x: f32) -> f32 {
    let mut t: f32 = x
    while t > PAK_PI { t = t - PAK_TWO_PI }
    while t < 0.0 - PAK_PI { t = t + PAK_TWO_PI }
    let mut sign: f32 = 1.0
    if t < 0.0 {
        t = 0.0 - t
        sign = 0.0 - 1.0
    }
    if t > PAK_HALF_PI { t = PAK_PI - t }
    let t2: f32 = t * t
    -- Horner on t * (1 - t2/6 + t2^2/120 - t2^3/5040 + t2^4/362880
    --                - t2^5/39916800)
    let mut s: f32 = 0.0 - 0.000000025052108
    s = s * t2 + 0.0000027557319
    s = s * t2 - 0.00019841270
    s = s * t2 + 0.0083333333
    s = s * t2 - 0.16666667
    s = s * t2 + 1.0
    return sign * t * s
}

fn math_cos_f(x: f32) -> f32 {
    return math_sin_f(x + PAK_HALF_PI)
}

fn math_tan_f(x: f32) -> f32 {
    let c: f32 = math_cos_f(x)
    if c == 0.0 { return 0.0 }
    return math_sin_f(x) / c
}

-- ── atan2 ─────────────────────────────────────────────────────────────────
-- Minimax on |z| <= 1, then the octant fixup. Accurate to about 1e-5, which
-- is what a five-coefficient fit buys.
fn math_atan_unit(z: f32) -> f32 {
    let z2: f32 = z * z
    let mut p: f32 = 0.0208351
    p = p * z2 - 0.0851330
    p = p * z2 + 0.1801410
    p = p * z2 - 0.3302995
    p = p * z2 + 0.9998660
    return z * p
}

fn math_atan2_f(y: f32, x: f32) -> f32 {
    if x == 0.0 and y == 0.0 { return 0.0 }
    let ax: f32 = math_abs_f(x)
    let ay: f32 = math_abs_f(y)
    let mut a: f32 = 0.0
    if ax >= ay {
        a = math_atan_unit(y / x)
        if x < 0.0 {
            if y >= 0.0 { a = a + PAK_PI } else { a = a - PAK_PI }
        }
        return a
    }
    -- |y| > |x|: reflect through the diagonal so the polynomial keeps its
    -- argument inside [-1, 1].
    a = math_atan_unit(x / y)
    if y >= 0.0 { return PAK_HALF_PI - a }
    return (0.0 - PAK_HALF_PI) - a
}

-- ── exp / log / pow ───────────────────────────────────────────────────────
-- ln by the atanh series on a mantissa scaled into [1, 2); exp by the same
-- power-of-two split in reverse. pow is exp(y * ln x), so it inherits both.
fn math_ln_f(x: f32) -> f32 {
    if x <= 0.0 { return 0.0 }
    let mut m: f32 = x
    let mut k: i32 = 0
    while m >= 2.0 {
        m = m * 0.5
        k = k + 1
    }
    while m < 1.0 {
        m = m * 2.0
        k = k - 1
    }
    let s: f32 = (m - 1.0) / (m + 1.0)
    let s2: f32 = s * s
    let mut p: f32 = 0.11111111
    p = p * s2 + 0.14285714
    p = p * s2 + 0.2
    p = p * s2 + 0.33333333
    p = p * s2 + 1.0
    return 2.0 * s * p + (k as f32) * PAK_LN2
}

fn math_exp_f(x: f32) -> f32 {
    -- Split into 2^k * e^r with |r| <= ln2/2, where six Taylor terms are past
    -- f32's resolution.
    let mut k: i32 = (x / PAK_LN2) as i32
    if x < 0.0 and ((k as f32) * PAK_LN2) > x { k = k - 1 }
    let r: f32 = x - (k as f32) * PAK_LN2
    let mut e: f32 = 0.0013888889
    e = e * r + 0.0083333333
    e = e * r + 0.041666667
    e = e * r + 0.16666667
    e = e * r + 0.5
    e = e * r + 1.0
    e = e * r + 1.0
    let mut n: i32 = k
    while n > 0 {
        e = e * 2.0
        n = n - 1
    }
    while n < 0 {
        e = e * 0.5
        n = n + 1
    }
    return e
}

fn math_pow_f(x: f32, y: f32) -> f32 {
    if y == 0.0 { return 1.0 }
    if x == 0.0 { return 0.0 }
    if x > 0.0 { return math_exp_f(y * math_ln_f(x)) }
    -- A negative base is only defined for an integer exponent; anything else
    -- has no real answer, so it comes back as zero rather than a NaN nobody
    -- checks for.
    let iy: i32 = y as i32
    if (iy as f32) != y { return 0.0 }
    let m: f32 = math_exp_f(y * math_ln_f(0.0 - x))
    if (iy & 1) != 0 { return 0.0 - m }
    return m
}

-- ── fixed-point wrappers ──────────────────────────────────────────────────
fn math_fix_sin(a: i32) -> i32 {
    return math_f_to_fix(math_sin_f(math_fix_to_f(a)))
}

fn math_fix_cos(a: i32) -> i32 {
    return math_f_to_fix(math_cos_f(math_fix_to_f(a)))
}

fn math_fix_sqrt(a: i32) -> i32 {
    return math_f_to_fix(math_sqrt_f(math_fix_to_f(a)))
}

-- ── PRNG ──────────────────────────────────────────────────────────────────
-- xorshift32, the same generator and the same default seed as runtime/
-- pak_rand.h, so a program seeded identically produces the same stream on
-- both backends.
static g_rng: u32 = 0x2545F491

fn math_rand_seed(seed: u32) {
    if seed == 0 {
        g_rng = 0x2545F491
    } else {
        g_rng = seed
    }
}

fn math_rand() -> u32 {
    let mut x: u32 = g_rng
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    g_rng = x
    return x
}

fn math_rand_range(lo: i32, hi: i32) -> i32 {
    if hi <= lo { return lo }
    let span: u32 = (hi - lo) as u32
    return lo + (math_rand() % span) as i32
}

fn math_rand_f() -> f32 {
    -- 24 bits, the most an f32 mantissa holds exactly.
    return ((math_rand() >> 8) as f32) / 16777216.0
}

-- ── constants a program can declare `extern const` ─────────────────────────
-- These are libdragon macros on the C backend, so nothing there defines a
-- symbol for them; a standalone link needs one. Both are hardware facts
-- rather than libdragon inventions, which is why they belong here:
--
--   TICKS_PER_SECOND   the VR4300's COP0 count rate, CPU_FREQUENCY / 2, and
--                      93.75 MHz is the retail N64's clock.
--   RDPQ_COMBINER_FLAT the colour combiner set to pass the primitive colour
--                      through unchanged. libdragon's macro is 64 bits
--                      (0x00887F1088FDF6FB); a `u32` reference to it takes
--                      the low half on either backend, so that is what this
--                      is, and a program wanting the whole word should build
--                      it with rdpq.set_combiner_raw.
--
-- They are `static`, not `const`, because an `extern const` in a program
-- lowers to a symbol reference and a Pak `const` has no address.
static TICKS_PER_SECOND: u32   = 46875000
static RDPQ_COMBINER_FLAT: u32 = 0x88FDF6FB

-- ── FixedMap / Pool helpers ────────────────────────────────────────────────
-- The MIPS backend lowers FixedMap and Pool methods into calls on these. They
-- are the standalone counterpart of runtime/pak_containers.h: one helper has
-- to serve every K and V, so the element sizes travel with the call and the
-- key and value are passed by address rather than by value.
--
-- FixedMap(K, V, N) is laid out
--     keys[N] @ 0            values[N] @ vals_off
--     occupied[N] @ occ      len @ (occ + N) rounded up to 4
-- `vals_off` travels with the call because the backend pads keys[] up to the
-- wider of align(K) and align(V) -- a value load has to stay aligned -- and
-- that padding cannot be recovered from N * key_sz alone.
--
-- Pool(T, N) is data[N] @ 0 and len @ (N * elem_sz) rounded up to 4.

fn pak_align4(n: i32) -> i32 {
    return ((n + 3) / 4) * 4
}

fn pak_bytes_equal(a: u32, b: u32, n: i32) -> i32 {
    let mut i: i32 = 0
    while i < n {
        let pa: *u8 = (a + i as u32) as *u8
        let pb: *u8 = (b + i as u32) as *u8
        if *pa != *pb { return 0 }
        i = i + 1
    }
    return 1
}

fn pak_bytes_copy(dst: u32, src: u32, n: i32) {
    let mut i: i32 = 0
    while i < n {
        let ps: *u8 = (src + i as u32) as *u8
        let pd: *u8 = (dst + i as u32) as *u8
        *pd = *ps
        i = i + 1
    }
}

fn pak_bytes_zero(dst: u32, n: i32) {
    let mut i: i32 = 0
    while i < n {
        let pd: *u8 = (dst + i as u32) as *u8
        *pd = 0
        i = i + 1
    }
}

fn pak_bytes_swap(a: u32, b: u32, n: i32) {
    let mut i: i32 = 0
    while i < n {
        let pa: *u8 = (a + i as u32) as *u8
        let pb: *u8 = (b + i as u32) as *u8
        let t: u8 = *pa
        *pa = *pb
        *pb = t
        i = i + 1
    }
}

-- Address of occupied[0].
fn pak_map_occ(map: u32, cap: i32, val_sz: i32, vals_off: i32) -> u32 {
    return map + (vals_off + cap * val_sz) as u32
}

-- Address of len.
fn pak_map_lenp(occ: u32, cap: i32) -> u32 {
    return occ + pak_align4(cap) as u32
}

-- Index of the slot holding `key`, or -1.
fn pak_map_find(map: u32, cap: i32, key_ptr: u32, key_sz: i32, occ: u32) -> i32 {
    let mut i: i32 = 0
    while i < cap {
        let o: *u8 = (occ + i as u32) as *u8
        if *o != 0 {
            if pak_bytes_equal(map + (i * key_sz) as u32, key_ptr, key_sz) != 0 {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn pak_map_set_raw(map: u32, cap: i32, key_ptr: u32, val_ptr: u32,
                   key_sz: i32, val_sz: i32, vals_off: i32) -> i32 {
    let occ: u32 = pak_map_occ(map, cap, val_sz, vals_off)
    let hit: i32 = pak_map_find(map, cap, key_ptr, key_sz, occ)
    if hit >= 0 {
        pak_bytes_copy(map + (vals_off + hit * val_sz) as u32, val_ptr, val_sz)
        return 1
    }
    let mut i: i32 = 0
    while i < cap {
        let o: *u8 = (occ + i as u32) as *u8
        if *o == 0 {
            pak_bytes_copy(map + (i * key_sz) as u32, key_ptr, key_sz)
            pak_bytes_copy(map + (vals_off + i * val_sz) as u32, val_ptr, val_sz)
            *o = 1
            let lp: *i32 = pak_map_lenp(occ, cap) as *i32
            *lp = *lp + 1
            return 1
        }
        i = i + 1
    }
    return 0
}

-- Returns the address of the value slot, or 0 (`none`) when absent.
fn pak_map_get_raw(map: u32, cap: i32, key_ptr: u32,
                   key_sz: i32, val_sz: i32, vals_off: i32) -> u32 {
    let occ: u32 = pak_map_occ(map, cap, val_sz, vals_off)
    let hit: i32 = pak_map_find(map, cap, key_ptr, key_sz, occ)
    if hit < 0 { return 0 }
    return map + (vals_off + hit * val_sz) as u32
}

fn pak_map_has_raw(map: u32, cap: i32, key_ptr: u32,
                   key_sz: i32, val_sz: i32, vals_off: i32) -> i32 {
    if pak_map_get_raw(map, cap, key_ptr, key_sz, val_sz, vals_off) != 0 { return 1 }
    return 0
}

fn pak_map_remove_raw(map: u32, cap: i32, key_ptr: u32,
                      key_sz: i32, val_sz: i32, vals_off: i32) -> i32 {
    let occ: u32 = pak_map_occ(map, cap, val_sz, vals_off)
    let hit: i32 = pak_map_find(map, cap, key_ptr, key_sz, occ)
    if hit < 0 { return 0 }
    let o: *u8 = (occ + hit as u32) as *u8
    *o = 0
    let lp: *i32 = pak_map_lenp(occ, cap) as *i32
    *lp = *lp - 1
    return 1
}

-- Returns the address of a zeroed slot, or 0 (`none`) when the pool is full.
fn pak_pool_acquire_raw(pool: u32, cap: i32, elem_sz: i32) -> u32 {
    let lp: *i32 = (pool + pak_align4(cap * elem_sz) as u32) as *i32
    let n: i32 = *lp
    if n >= cap { return 0 }
    let slot: u32 = pool + (n * elem_sz) as u32
    pak_bytes_zero(slot, elem_sz)
    *lp = n + 1
    return slot
}

-- Swap the released slot with the last live one so data[0..len) stays dense.
fn pak_pool_release_raw(pool: u32, cap: i32, elem_sz: i32, item: u32) {
    let lp: *i32 = (pool + pak_align4(cap * elem_sz) as u32) as *i32
    let n: i32 = *lp
    if n <= 0 { return }
    let last: u32 = pool + ((n - 1) * elem_sz) as u32
    *lp = n - 1
    if item != last {
        pak_bytes_swap(item, last, elem_sz)
    }
}

-- ── Vec helpers ─────────────────────────────────────────────────────────────
-- Vec(T) is {data, len, cap} with the storage on the heap. Everything that
-- only reads the header is inlined by the backend; these three are the ones
-- that can move the storage. As with the map helpers, one helper serves every
-- T, so the element size travels with the call.
--
-- The heap here is the bump allocator above: growing leaks the old block. A
-- Vec that grows every frame will exhaust it, which is why a game should
-- reserve once (or use FixedList).

fn pak_vec_grow(vec: u32, elem_sz: i32, want: i32) -> i32 {
    let cap_p: *i32 = (vec + 8) as *i32
    if want <= *cap_p { return 1 }
    let mut ncap: i32 = *cap_p
    if ncap == 0 { ncap = 8 }
    while ncap < want { ncap = ncap * 2 }
    let np: *u8 = __pak_alloc(ncap * elem_sz)
    if (np as u32) == 0 { return 0 }
    let data_p: *u32 = vec as *u32
    let len_p: *i32 = (vec + 4) as *i32
    if *data_p != 0 { pak_bytes_copy(np as u32, *data_p, (*len_p) * elem_sz) }
    *data_p = np as u32
    *cap_p = ncap
    return 1
}

fn pak_vec_push_raw(vec: u32, elem_sz: i32, val_ptr: u32) -> i32 {
    let len_p: *i32 = (vec + 4) as *i32
    if pak_vec_grow(vec, elem_sz, *len_p + 1) == 0 { return 0 }
    let data_p: *u32 = vec as *u32
    pak_bytes_copy(*data_p + ((*len_p) * elem_sz) as u32, val_ptr, elem_sz)
    *len_p = *len_p + 1
    return 1
}

fn pak_vec_reserve_raw(vec: u32, elem_sz: i32, n: i32) -> i32 {
    return pak_vec_grow(vec, elem_sz, n)
}

fn pak_vec_free_raw(vec: u32) {
    let data_p: *u32 = vec as *u32
    __pak_free(*data_p as *u8)
    *data_p = 0
    let len_p: *i32 = (vec + 4) as *i32
    *len_p = 0
    let cap_p: *i32 = (vec + 8) as *i32
    *cap_p = 0
}

-- ── PakFS: assets in the ROM ────────────────────────────────────────────────
-- `pak link --fs <archive>` appends a PakFS archive to the ROM past the end of
-- the payload and patches its ROM offset and length into the two statics
-- below. Both stay zero in a ROM built without --fs, which is how pakfs_init
-- tells "this ROM has no assets" from "I could not read the ones it has".
--
-- Archive layout (little-endian, written by tcl/pakfs.tcl):
--   0    "PKFS"
--   4    version    u16  (1)
--   6    num_files  u16
--   8    index_off  u32  (always 12)
--   12   index      per file: name_len u16, name, data_off u32,
--                   data_size u32, flags u16
--   ...  data       16-byte aligned within the archive
--
-- The VR4300 is big-endian, so every field is assembled from bytes rather than
-- loaded as a word.

static g_pakfs_rom:   u32 = 0   -- ROM offset of the archive; patched at link
static g_pakfs_len:   u32 = 0   -- archive length in bytes; patched at link
static g_pakfs_idx:   u32 = 0   -- RDRAM copy of the header + index
static g_pakfs_n:     i32 = 0
static g_pakfs_state: i32 = 0   -- 0 = untried, 1 = mounted, -1 = failed
static g_pakfs_size:  i32 = 0   -- size of the file the last lookup found

fn pakfs_le16(p: u32) -> i32 {
    let a: *u8 = p as *u8
    let b: *u8 = (p + 1) as *u8
    return (*a as i32) | ((*b as i32) << 8)
}

fn pakfs_le32(p: u32) -> u32 {
    let a: *u8 = p as *u8
    let b: *u8 = (p + 1) as *u8
    let c: *u8 = (p + 2) as *u8
    let d: *u8 = (p + 3) as *u8
    return (*a as u32) | ((*b as u32) << 8) | ((*c as u32) << 16) | ((*d as u32) << 24)
}

fn pakfs_be16(p: u32) -> i32 {
    let a: *u8 = p as *u8
    let b: *u8 = (p + 1) as *u8
    return ((*a as i32) << 8) | (*b as i32)
}

-- PI DMA wants a 16-byte-aligned destination and a length that is a multiple
-- of 16; __pak_alloc only promises 8, so take the next 16 inside a larger
-- block. Returns 0 when the heap is exhausted.
fn pakfs_alloc16(n: i32) -> u32 {
    let p: *u8 = __pak_alloc(n + 16)
    if (p as u32) == 0 { return 0 }
    return ((p as u32) + 15) & 0xFFFFFFF0
}

fn pakfs_round16(n: i32) -> i32 {
    return (n + 15) & 0x7FFFFFF0
}

-- Reads the header and the whole index into RDRAM. Returns 1 mounted,
-- -1 failed. Safe to call repeatedly: it only does the work once.
fn pakfs_init() -> i32 {
    if g_pakfs_state != 0 { return g_pakfs_state }
    g_pakfs_state = -1
    if g_pakfs_len < 12 { return -1 }

    -- The index length is not in the header: it ends where the first file's
    -- data begins. Read a block big enough for the header plus a first entry,
    -- learn the data offset from it, then re-read if the index is longer.
    let mut blk: i32 = 512
    if (g_pakfs_len as i32) < blk { blk = g_pakfs_len as i32 }
    blk = pakfs_round16(blk)
    let buf: u32 = pakfs_alloc16(blk)
    if buf == 0 { return -1 }
    dma_read(buf as *u8, g_pakfs_rom, blk)
    if pakfs_le32(buf) != 0x53464B50 { return -1 }      -- "PKFS"
    if pakfs_le16(buf + 4) != 1 { return -1 }           -- version
    if pakfs_le32(buf + 8) != 12 { return -1 }          -- index_off

    g_pakfs_n = pakfs_le16(buf + 6)
    g_pakfs_idx = buf
    if g_pakfs_n == 0 {
        g_pakfs_state = 1
        return 1
    }
    let nlen: i32 = pakfs_le16(buf + 12)
    let dstart: i32 = pakfs_le32(buf + 14 + (nlen as u32)) as i32
    if dstart > blk {
        let want: i32 = pakfs_round16(dstart)
        let b2: u32 = pakfs_alloc16(want)
        if b2 == 0 { return -1 }
        dma_read(b2 as *u8, g_pakfs_rom, want)
        g_pakfs_idx = b2
    }
    g_pakfs_state = 1
    return 1
}

-- The index name is length-counted; the one a program passes is NUL-
-- terminated. Equal means same length and same bytes.
fn pakfs_name_eq(name: u32, stored: u32, nlen: i32) -> i32 {
    let mut i: i32 = 0
    while i < nlen {
        let a: *u8 = (name + i as u32) as *u8
        let b: *u8 = (stored + i as u32) as *u8
        if *a != *b { return 0 }
        i = i + 1
    }
    let last: *u8 = (name + nlen as u32) as *u8
    if *last != 0 { return 0 }
    return 1
}

-- Generated asset paths carry the "pak:/" scheme the libdragon backend needs;
-- the archive names do not.
fn pakfs_strip_scheme(p: u32) -> u32 {
    let a: *u8 = p as *u8
    let b: *u8 = (p + 1) as *u8
    let c: *u8 = (p + 2) as *u8
    let d: *u8 = (p + 3) as *u8
    let e: *u8 = (p + 4) as *u8
    if *a != 112 { return p }   -- 'p'
    if *b != 97  { return p }   -- 'a'
    if *c != 107 { return p }   -- 'k'
    if *d != 58  { return p }   -- ':'
    if *e != 47  { return p }   -- '/'
    return p + 5
}

-- ROM offset of a file, or 0. Its size lands in g_pakfs_size.
fn pakfs_find(path: *c_char) -> u32 {
    g_pakfs_size = 0
    if pakfs_init() != 1 { return 0 }
    let name: u32 = pakfs_strip_scheme(path as u32)
    let mut p: u32 = g_pakfs_idx + 12
    let mut i: i32 = 0
    while i < g_pakfs_n {
        let nlen: i32 = pakfs_le16(p)
        let nptr: u32 = p + 2
        if pakfs_name_eq(name, nptr, nlen) != 0 {
            g_pakfs_size = pakfs_le32(nptr + (nlen as u32) + 4) as i32
            return g_pakfs_rom + pakfs_le32(nptr + (nlen as u32))
        }
        p = nptr + (nlen as u32) + 10
        i = i + 1
    }
    return 0
}

fn pakfs_size(path: *c_char) -> i32 {
    if pakfs_find(path) == 0 { return 0 }
    return g_pakfs_size
}

-- Read a whole file out of the ROM into fresh RDRAM. Returns none when the
-- archive has no such file or the heap is full.
fn pakfs_read(path: *c_char) -> *u8 {
    let off: u32 = pakfs_find(path)
    if off == 0 { return 0 as *u8 }
    let n: i32 = pakfs_round16(g_pakfs_size)
    let p: u32 = pakfs_alloc16(n)
    if p == 0 { return 0 as *u8 }
    dma_read(p as *u8, off, n)
    return p as *u8
}

-- ── Sprites ─────────────────────────────────────────────────────────────────
-- A .sprite file is libdragon's, written by mksprite with --compress 0:
--   0  width   u16 (big-endian)
--   2  height  u16
--   4  bitdepth u8   (deprecated, ignored)
--   5  flags    u8   -- the texture format is the low 5 bits
--   6  hslices  u8
--   7  vslices  u8
--   8  texels
-- The format code is (rdp_format << 2) | rdp_size, which is exactly the pair
-- SET_TEXTURE_IMAGE and SET_TILE want. A compressed sprite starts with the
-- "DCA3" container instead and is rejected: nothing here decompresses.

fn sprite_load(path: *c_char) -> *u8 {
    return pakfs_read(path)
}

fn sprite_width(spr: *u8) -> i32 {
    if (spr as u32) == 0 { return 0 }
    return pakfs_be16(spr as u32)
}

fn sprite_height(spr: *u8) -> i32 {
    if (spr as u32) == 0 { return 0 }
    return pakfs_be16((spr as u32) + 2)
}

-- Draw a sprite 1:1 at (x, y). Call rdpq.set_mode_copy() first for an opaque
-- blit, or set_mode_standard() to blend.
--
-- TMEM is 4 KiB, so anything bigger is drawn as horizontal strips: each strip
-- is loaded on its own and drawn where it belongs. `flags` is accepted for
-- signature parity with libdragon and is not used.
fn rdpq_sprite_blit(spr: *u8, x: i32, y: i32, flags: u32) {
    if (spr as u32) == 0 { return }
    let base: u32 = spr as u32
    let w: i32 = pakfs_be16(base)
    let h: i32 = pakfs_be16(base + 2)
    if w <= 0 { return }
    if h <= 0 { return }
    let fb: *u8 = (base + 5) as *u8
    let code: i32 = (*fb as i32) & 0x1F
    let fmt: u32 = (code >> 2) as u32
    let size: u32 = (code & 3) as u32
    -- CI4/CI8 need their palette loaded into TMEM first, which this does not
    -- do; drawing them would show index bytes as colours.
    if fmt == 2 { return }
    -- 4-bit formats (I4, IA4) pack two texels per byte, which the whole-byte
    -- row arithmetic below does not model.
    if size == 0 { return }
    let bpp: i32 = rdp_tex_bpp(size)
    let data: u32 = base + 8

    -- Bytes per row in TMEM, and how many whole rows of them fit in 4 KiB.
    let row: i32 = w * bpp
    if row <= 0 { return }
    let mut strip: i32 = 4096 / row
    if strip <= 0 { return }
    if strip > h { strip = h }

    rdpq_set_texture_image(data, fmt, size, w)
    rdpq_set_tile(0, fmt, size, ((row + 7) / 8) as u32, 0, 0)
    let mut t0: i32 = 0
    while t0 < h {
        let mut t1: i32 = t0 + strip
        if t1 > h { t1 = h }
        rdpq_set_tile_size(0, 0, t0, w, t1)
        rdpq_load_tile(0, 0, t0, w, t1)
        rdpq_texture_rectangle(0, x, y + t0, x + w, y + t1, 0, t0)
        t0 = t1
    }
}
