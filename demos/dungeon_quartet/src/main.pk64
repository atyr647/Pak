-- demos/dungeon_quartet/src/main.pk64
-- Dungeon Quartet
--
-- A 4-player local co-op, turn-based dungeon crawler rendered in 3D.
-- Each player controls one fixed role -- Tank, Healer, Melee DPS, Ranged DPS
-- -- sharing a single screen. Turn order is P1 -> P2 -> P3 -> P4 -> Enemies,
-- repeating until the party wipes or every enemy in the dungeon is dead.
--
-- Controls (each hero acts on their own turn, using their own controller port):
--   D-pad      -- move one tile (movement points vary by role)
--   A          -- primary action (melee attack / ranged shot / heal)
--   B          -- role ability (limited by a per-round cooldown)
--   Start      -- end turn early / advance title & end screens
--
-- Rendering: the world is real 3D geometry drawn through Tiny3D with a
-- chase camera that frames the living party; the HUD is a 2D RDP overlay
-- using an in-code 3x5 bitmap font (no font asset needed).
--
-- Models come from tools/gen_dungeon_models.py, which writes .glb files into
-- assets/models/. The build converts them to .t3dm via $(T3D_GLTF), so
-- pak.toml must set  [dependencies] tiny3d = true.

use n64.display
use n64.controller
use n64.rdpq
use n64.timer
use n64.math
use t3d

extern "C" {
    fn t3d_matrix_push(mat: *T3DMat4FP)
    fn t3d_matrix_pop(count: i32)
    fn t3d_mat4fp_from_srt_euler(mat: *T3DMat4FP, scale: *f32, rot: *f32, translate: *f32)
}

-- ============================================================
-- Constants
-- ============================================================
const GRID_W: i32 = 16
const GRID_H: i32 = 12

const TILE_WALL:  u8 = 0
const TILE_FLOOR: u8 = 1

const MAX_HEROES:  i32 = 4
const MAX_ENEMIES: i32 = 12

const HUD_Y: i32 = 200

-- role tuning
const TANK_HP:     i32 = 30
const TANK_ATK:    i32 = 3
const TANK_MOVE:   i32 = 1
const TANK_CD:     i32 = 3
const TAUNT_TURNS: i32 = 2

const HEAL_HP:      i32 = 14
const HEAL_AMT:     i32 = 6
const HEAL_GROUP:   i32 = 4
const HEAL_RADIUS:  i32 = 4
const HEAL_MOVE:    i32 = 2
const HEAL_CD:      i32 = 4

const MELEE_HP:    i32 = 20
const MELEE_ATK:   i32 = 6
const MELEE_WHIRL: i32 = 4
const MELEE_MOVE:  i32 = 3
const MELEE_CD:    i32 = 3

const RANGED_HP:     i32 = 16
const RANGED_ATK:    i32 = 4
const RANGED_VOLLEY: i32 = 3
const RANGED_RANGE:  i32 = 4
const RANGED_MOVE:   i32 = 2
const RANGED_CD:     i32 = 3

-- enemy tuning
const SKEL_HP:  i32 = 10
const SKEL_ATK: i32 = 3
const SLIME_HP:  i32 = 6
const SLIME_ATK: i32 = 2
const BOSS_HP:  i32 = 40
const BOSS_ATK: i32 = 5

const ENEMY_PHASE_TIME: f32 = 0.7

-- 3D world layout: one grid tile = one world unit, grid centered on origin.
--   world x = gx - (GRID_W-1)/2      world z = gy - (GRID_H-1)/2
const WORLD_OX: f32 = 7.5
const WORLD_OZ: f32 = 5.5

-- Models are authored facing -Z, so a Y rotation of 0 looks "north" (gy-1).
const FACE_NORTH: f32 =  0.0
const FACE_SOUTH: f32 =  3.14159265
const FACE_EAST:  f32 = -1.57079633
const FACE_WEST:  f32 =  1.57079633

-- Camera framing
const CAM_H:      f32 = 7.0     -- height above the focus point
const CAM_BACK:   f32 = 8.5     -- distance behind (+Z of) the focus point
const CAM_SMOOTH: f32 = 4.0     -- exponential follow rate
const CAM_CLAMP_X: f32 = 5.0
const CAM_CLAMP_Z: f32 = 3.5

-- Units are drawn oversized relative to a 1-unit tile so they stay readable
-- at 320x240 -- the usual trick in grid tactics games.
const UNIT_SCALE: f32 = 1.5
const BOSS_SCALE: f32 = 1.8

-- ============================================================
-- Types
-- ============================================================
enum Role: u8 { tank, healer, melee, ranged }
enum EnemyKind: u8 { skeleton, slime, boss }
enum Phase: u8 { title, hero_turn, enemy_turn, victory, defeat }

struct Hero {
    gx:          i32
    gy:          i32
    hp:          i32
    hp_max:      i32
    role:        Role
    move_left:   i32
    alive:       bool
    ability_cd:  i32
    taunt_turns: i32
    facing:      f32   -- Y rotation of the model, radians
}

struct Enemy {
    gx:    i32
    gy:    i32
    hp:    i32
    hp_max: i32
    kind:  EnemyKind
    alive: bool
    facing: f32
}

-- ============================================================
-- Globals
-- ============================================================
static level: [192]u8 = undefined   -- GRID_W * GRID_H, row-major (gy * GRID_W + gx)

static heroes:  [4]Hero    = undefined
static enemies: [12]Enemy  = undefined
static enemies_alive: i32  = 0

static phase:             Phase = Phase.title
static active_hero:       i32   = 0
static enemy_phase_timer: f32   = 0.0
static frame_counter:     i32   = 0
static round_num:         i32   = 0

-- ============================================================
-- Dungeon layout
-- ============================================================
fn tile_index(gx: i32, gy: i32) -> i32 {
    return gy * GRID_W + gx
}

fn tile_at(gx: i32, gy: i32) -> u8 {
    if gx < 0 or gx >= GRID_W or gy < 0 or gy >= GRID_H {
        return TILE_WALL
    }
    return level[tile_index(gx, gy)]
}

fn carve_room(x0: i32, y0: i32, x1: i32, y1: i32) {
    for gy in y0..(y1 + 1) {
        for gx in x0..(x1 + 1) {
            level[tile_index(gx, gy)] = TILE_FLOOR
        }
    }
}

fn carve_h_corridor(x0: i32, x1: i32, gy: i32) {
    for gx in x0..(x1 + 1) {
        level[tile_index(gx, gy)] = TILE_FLOOR
    }
}

fn carve_v_corridor(y0: i32, y1: i32, gx: i32) {
    for gy in y0..(y1 + 1) {
        level[tile_index(gx, gy)] = TILE_FLOOR
    }
}

fn build_level() {
    for i in 0..192 {
        level[i] = TILE_WALL
    }

    -- Room A: start room (top-left)
    carve_room(1, 1, 4, 4)
    -- Room B: top-right
    carve_room(7, 1, 10, 3)
    -- Room C: center hub
    carve_room(6, 5, 9, 8)
    -- Room D: bottom-left
    carve_room(1, 6, 4, 9)
    -- Room E: right
    carve_room(11, 5, 14, 8)
    -- Room F: boss room (bottom-right)
    carve_room(10, 9, 14, 11)

    -- Corridors
    carve_h_corridor(4, 7, 2)     -- A -> B
    carve_v_corridor(4, 6, 2)     -- A -> D
    carve_v_corridor(3, 5, 8)     -- B -> C
    carve_h_corridor(4, 6, 7)     -- D -> C
    carve_h_corridor(9, 11, 6)    -- C -> E
    carve_v_corridor(8, 9, 12)    -- E -> F (boss)
}

-- ============================================================
-- Occupancy queries
-- ============================================================
fn hero_at(gx: i32, gy: i32) -> i32 {
    for i in 0..MAX_HEROES {
        if heroes[i].alive and heroes[i].gx == gx and heroes[i].gy == gy {
            return i
        }
    }
    return -1
}

fn enemy_at(gx: i32, gy: i32) -> i32 {
    for i in 0..MAX_ENEMIES {
        if enemies[i].alive and enemies[i].gx == gx and enemies[i].gy == gy {
            return i
        }
    }
    return -1
}

fn tile_walkable(gx: i32, gy: i32) -> bool {
    if tile_at(gx, gy) != TILE_FLOOR { return false }
    if hero_at(gx, gy) >= 0 { return false }
    if enemy_at(gx, gy) >= 0 { return false }
    return true
}

fn manhattan(ax: i32, ay: i32, bx: i32, by: i32) -> i32 {
    return math.abs_i32(ax - bx) + math.abs_i32(ay - by)
}

-- ============================================================
-- Role tuning lookups
-- ============================================================
fn role_move_points(r: Role) -> i32 {
    match r {
        .tank   => { return TANK_MOVE }
        .healer => { return HEAL_MOVE }
        .melee  => { return MELEE_MOVE }
        .ranged => { return RANGED_MOVE }
    }
    return 1
}

fn role_ability_cd(r: Role) -> i32 {
    match r {
        .tank   => { return TANK_CD }
        .healer => { return HEAL_CD }
        .melee  => { return MELEE_CD }
        .ranged => { return RANGED_CD }
    }
    return 1
}

-- ============================================================
-- Setup
-- ============================================================
fn init_hero(h: *Hero, gx: i32, gy: i32, role: Role, hp: i32) {
    h.gx = gx
    h.gy = gy
    h.hp = hp
    h.hp_max = hp
    h.role = role
    h.move_left = 0
    h.alive = true
    h.ability_cd = 0
    h.taunt_turns = 0
    h.facing = FACE_SOUTH
}

fn init_enemy(e: *Enemy, gx: i32, gy: i32, kind: EnemyKind, hp: i32) {
    e.gx = gx
    e.gy = gy
    e.hp = hp
    e.hp_max = hp
    e.kind = kind
    e.alive = true
    e.facing = FACE_NORTH
}

fn spawn_enemies() {
    for i in 0..MAX_ENEMIES {
        enemies[i].alive = false
    }
    init_enemy(&enemies[0],  8,  2, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[1],  9,  1, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[2],  7,  6, EnemyKind.slime,    SLIME_HP)
    init_enemy(&enemies[3],  8,  7, EnemyKind.slime,    SLIME_HP)
    init_enemy(&enemies[4],  6,  7, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[5],  2,  7, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[6],  3,  8, EnemyKind.slime,    SLIME_HP)
    init_enemy(&enemies[7], 12,  6, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[8], 13,  7, EnemyKind.skeleton, SKEL_HP)
    init_enemy(&enemies[9], 12,  7, EnemyKind.slime,    SLIME_HP)
    init_enemy(&enemies[10], 12, 10, EnemyKind.boss,    BOSS_HP)
    enemies_alive = 11
}

fn start_level() {
    build_level()

    init_hero(&heroes[0], 1, 1, Role.tank,   TANK_HP)
    init_hero(&heroes[1], 2, 1, Role.melee,  MELEE_HP)
    init_hero(&heroes[2], 1, 2, Role.healer, HEAL_HP)
    init_hero(&heroes[3], 2, 2, Role.ranged, RANGED_HP)

    spawn_enemies()

    round_num = 0
    phase = Phase.hero_turn
    active_hero = next_alive_hero(0)
    if active_hero < MAX_HEROES {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

-- ============================================================
-- Turn sequencing
-- ============================================================
fn next_alive_hero(start: i32) -> i32 {
    let i: i32 = start
    loop {
        if i >= MAX_HEROES { break }
        if heroes[i].alive { break }
        i = i + 1
    }
    return i
}

fn any_hero_alive() -> bool {
    for i in 0..MAX_HEROES {
        if heroes[i].alive { return true }
    }
    return false
}

fn begin_hero_phase() {
    round_num = round_num + 1
    -- tick cooldowns / taunt once per round
    for i in 0..MAX_HEROES {
        if heroes[i].ability_cd > 0 { heroes[i].ability_cd -= 1 }
        if heroes[i].taunt_turns > 0 { heroes[i].taunt_turns -= 1 }
    }
    phase = Phase.hero_turn
    active_hero = next_alive_hero(0)
    if active_hero < MAX_HEROES {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

fn begin_enemy_phase() {
    phase = Phase.enemy_turn
    enemy_phase_timer = ENEMY_PHASE_TIME
    run_enemy_ai()
}

fn end_hero_turn() {
    active_hero = next_alive_hero(active_hero + 1)
    if active_hero >= MAX_HEROES {
        begin_enemy_phase()
    } else {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

fn check_outcomes() {
    if enemies_alive <= 0 {
        phase = Phase.victory
        return
    }
    if not any_hero_alive() {
        phase = Phase.defeat
        return
    }
}

-- ============================================================
-- Hero actions
-- ============================================================
-- Y rotation that makes a model authored facing -Z look along (dx, dy).
fn facing_from_delta(dx: i32, dy: i32) -> f32 {
    if dx > 0 { return FACE_EAST }
    if dx < 0 { return FACE_WEST }
    if dy > 0 { return FACE_SOUTH }
    return FACE_NORTH
}

fn face_toward(from_x: i32, from_y: i32, to_x: i32, to_y: i32) -> f32 {
    let dx: i32 = to_x - from_x
    let dy: i32 = to_y - from_y
    if math.abs_i32(dx) >= math.abs_i32(dy) { return facing_from_delta(dx, 0) }
    return facing_from_delta(0, dy)
}

fn try_move_hero(h: *Hero, dx: i32, dy: i32) {
    if h.move_left <= 0 { return }
    -- turning to look where you are headed is free, even into a wall
    h.facing = facing_from_delta(dx, dy)
    let nx: i32 = h.gx + dx
    let ny: i32 = h.gy + dy
    if not tile_walkable(nx, ny) { return }
    h.gx = nx
    h.gy = ny
    h.move_left -= 1
}

-- returns index of first living enemy adjacent to (gx,gy), or -1
fn adjacent_enemy(gx: i32, gy: i32) -> i32 {
    let e: i32 = enemy_at(gx, gy - 1)
    if e >= 0 { return e }
    e = enemy_at(gx, gy + 1)
    if e >= 0 { return e }
    e = enemy_at(gx - 1, gy)
    if e >= 0 { return e }
    e = enemy_at(gx + 1, gy)
    if e >= 0 { return e }
    return -1
}

fn damage_enemy(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_ENEMIES { return }
    if not enemies[idx].alive { return }
    enemies[idx].hp -= amt
    if enemies[idx].hp <= 0 {
        enemies[idx].hp = 0
        enemies[idx].alive = false
        enemies_alive -= 1
    }
}

fn nearest_enemy_in_line(gx: i32, gy: i32, range: i32) -> i32 {
    let best: i32 = -1
    let best_d: i32 = range + 1
    for i in 0..MAX_ENEMIES {
        if not enemies[i].alive { continue }
        let same_row: bool = enemies[i].gy == gy
        let same_col: bool = enemies[i].gx == gx
        if not (same_row or same_col) { continue }
        let d: i32 = manhattan(gx, gy, enemies[i].gx, enemies[i].gy)
        if d <= range and d < best_d {
            best = i
            best_d = d
        }
    }
    return best
}

fn lowest_hp_ally(gx: i32, gy: i32, radius: i32) -> i32 {
    let best: i32 = -1
    let best_hp: i32 = 999999
    for i in 0..MAX_HEROES {
        if not heroes[i].alive { continue }
        if heroes[i].hp >= heroes[i].hp_max { continue }
        let d: i32 = manhattan(gx, gy, heroes[i].gx, heroes[i].gy)
        if d <= radius and heroes[i].hp < best_hp {
            best = i
            best_hp = heroes[i].hp
        }
    }
    return best
}

fn heal_hero(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_HEROES { return }
    heroes[idx].hp += amt
    if heroes[idx].hp > heroes[idx].hp_max { heroes[idx].hp = heroes[idx].hp_max }
}

-- Primary action (A). Returns true if the turn should end.
fn hero_primary_action(h_idx: i32) -> bool {
    let h: *Hero = &heroes[h_idx]
    match h.role {
        .tank => {
            let e: i32 = adjacent_enemy(h.gx, h.gy)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, TANK_ATK)
            return true
        }
        .melee => {
            let e: i32 = adjacent_enemy(h.gx, h.gy)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, MELEE_ATK)
            return true
        }
        .ranged => {
            let e: i32 = nearest_enemy_in_line(h.gx, h.gy, RANGED_RANGE)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, RANGED_ATK)
            return true
        }
        .healer => {
            let a: i32 = lowest_hp_ally(h.gx, h.gy, HEAL_RADIUS)
            if a < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, heroes[a].gx, heroes[a].gy)
            heal_hero(a, HEAL_AMT)
            return true
        }
    }
    return false
}

-- Role ability (B). Returns true if the turn should end.
fn hero_ability(h_idx: i32) -> bool {
    let h: *Hero = &heroes[h_idx]
    if h.ability_cd > 0 { return false }

    match h.role {
        .tank => {
            h.taunt_turns = TAUNT_TURNS
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .melee => {
            damage_enemy(enemy_at(h.gx, h.gy - 1), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx, h.gy + 1), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx - 1, h.gy), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx + 1, h.gy), MELEE_WHIRL)
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .ranged => {
            for i in 0..MAX_ENEMIES {
                if not enemies[i].alive { continue }
                if enemies[i].gy == h.gy and manhattan(h.gx, h.gy, enemies[i].gx, enemies[i].gy) <= RANGED_RANGE {
                    damage_enemy(i, RANGED_VOLLEY)
                }
            }
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .healer => {
            for i in 0..MAX_HEROES {
                if not heroes[i].alive { continue }
                if manhattan(h.gx, h.gy, heroes[i].gx, heroes[i].gy) <= HEAL_RADIUS {
                    heal_hero(i, HEAL_GROUP)
                }
            }
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
    }
    return false
}

-- ============================================================
-- Enemy AI
-- ============================================================
fn taunting_hero() -> i32 {
    for i in 0..MAX_HEROES {
        if heroes[i].alive and heroes[i].taunt_turns > 0 { return i }
    }
    return -1
}

fn nearest_hero(gx: i32, gy: i32) -> i32 {
    let best: i32 = -1
    let best_d: i32 = 999999
    for i in 0..MAX_HEROES {
        if not heroes[i].alive { continue }
        let d: i32 = manhattan(gx, gy, heroes[i].gx, heroes[i].gy)
        if d < best_d {
            best = i
            best_d = d
        }
    }
    return best
}

fn enemy_atk_for(kind: EnemyKind) -> i32 {
    match kind {
        .skeleton => { return SKEL_ATK }
        .slime    => { return SLIME_ATK }
        .boss     => { return BOSS_ATK }
    }
    return 1
}

fn damage_hero(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_HEROES { return }
    if not heroes[idx].alive { return }
    heroes[idx].hp -= amt
    if heroes[idx].hp <= 0 {
        heroes[idx].hp = 0
        heroes[idx].alive = false
    }
}

fn enemy_step(e: *Enemy) {
    let target: i32 = taunting_hero()
    if target < 0 { target = nearest_hero(e.gx, e.gy) }
    if target < 0 { return }

    let tx: i32 = heroes[target].gx
    let ty: i32 = heroes[target].gy

    -- always turn to face whoever this enemy is hunting
    e.facing = face_toward(e.gx, e.gy, tx, ty)

    if manhattan(e.gx, e.gy, tx, ty) == 1 {
        damage_hero(target, enemy_atk_for(e.kind))
        return
    }

    let dx: i32 = 0
    let dy: i32 = 0
    if tx > e.gx { dx = 1 } elif tx < e.gx { dx = -1 }
    if ty > e.gy { dy = 1 } elif ty < e.gy { dy = -1 }

    let adx: i32 = math.abs_i32(tx - e.gx)
    let ady: i32 = math.abs_i32(ty - e.gy)

    if adx >= ady {
        if dx != 0 and tile_at(e.gx + dx, e.gy) == TILE_FLOOR and hero_at(e.gx + dx, e.gy) < 0 and enemy_at(e.gx + dx, e.gy) < 0 {
            e.gx += dx
            return
        }
        if dy != 0 and tile_at(e.gx, e.gy + dy) == TILE_FLOOR and hero_at(e.gx, e.gy + dy) < 0 and enemy_at(e.gx, e.gy + dy) < 0 {
            e.gy += dy
            return
        }
    } else {
        if dy != 0 and tile_at(e.gx, e.gy + dy) == TILE_FLOOR and hero_at(e.gx, e.gy + dy) < 0 and enemy_at(e.gx, e.gy + dy) < 0 {
            e.gy += dy
            return
        }
        if dx != 0 and tile_at(e.gx + dx, e.gy) == TILE_FLOOR and hero_at(e.gx + dx, e.gy) < 0 and enemy_at(e.gx + dx, e.gy) < 0 {
            e.gx += dx
            return
        }
    }
}

fn run_enemy_ai() {
    for i in 0..MAX_ENEMIES {
        if not enemies[i].alive { continue }
        enemy_step(&enemies[i])
    }
}

-- ============================================================
-- Input handling
-- ============================================================
fn handle_hero_input(dt: f32) {
    let h_idx: i32 = active_hero
    let h: *Hero = &heroes[h_idx]

    controller.poll()
    let pad = controller.read(h_idx)

    let ended: bool = false

    if pad.pressed.up    { try_move_hero(h, 0, -1) }
    elif pad.pressed.down  { try_move_hero(h, 0, 1) }
    elif pad.pressed.left  { try_move_hero(h, -1, 0) }
    elif pad.pressed.right { try_move_hero(h, 1, 0) }
    elif pad.pressed.a { ended = hero_primary_action(h_idx) }
    elif pad.pressed.b { ended = hero_ability(h_idx) }
    elif pad.pressed.start { ended = true }

    if ended {
        end_hero_turn()
        check_outcomes()
    }
}

-- ============================================================
-- Bitmap font (3x5 glyphs, asset-free)
-- Layout: 0-9 = indices 0..9, A-Z = 10..35, space=36, ':'=37,
--         '-'=38, '.'=39, '!'=40, '/'=41
-- ============================================================
const NUM_GLYPHS: i32 = 42

static font: [42]u16 = undefined

fn pack_glyph(r0: i32, r1: i32, r2: i32, r3: i32, r4: i32) -> u16 {
    return (r0 | (r1 << 3) | (r2 << 6) | (r3 << 9) | (r4 << 12)) as u16
}

fn init_font() {
    font[0]  = pack_glyph(7, 5, 5, 5, 7)
    font[1]  = pack_glyph(2, 6, 2, 2, 7)
    font[2]  = pack_glyph(7, 1, 7, 4, 7)
    font[3]  = pack_glyph(7, 1, 7, 1, 7)
    font[4]  = pack_glyph(5, 5, 7, 1, 1)
    font[5]  = pack_glyph(7, 4, 7, 1, 7)
    font[6]  = pack_glyph(7, 4, 7, 5, 7)
    font[7]  = pack_glyph(7, 1, 2, 2, 2)
    font[8]  = pack_glyph(7, 5, 7, 5, 7)
    font[9]  = pack_glyph(7, 5, 7, 1, 7)
    font[10] = pack_glyph(7, 5, 7, 5, 5)
    font[11] = pack_glyph(6, 5, 6, 5, 6)
    font[12] = pack_glyph(7, 4, 4, 4, 7)
    font[13] = pack_glyph(6, 5, 5, 5, 6)
    font[14] = pack_glyph(7, 4, 6, 4, 7)
    font[15] = pack_glyph(7, 4, 6, 4, 4)
    font[16] = pack_glyph(7, 4, 5, 5, 7)
    font[17] = pack_glyph(5, 5, 7, 5, 5)
    font[18] = pack_glyph(7, 2, 2, 2, 7)
    font[19] = pack_glyph(1, 1, 1, 5, 7)
    font[20] = pack_glyph(5, 5, 6, 5, 5)
    font[21] = pack_glyph(4, 4, 4, 4, 7)
    font[22] = pack_glyph(5, 7, 7, 5, 5)
    font[23] = pack_glyph(5, 7, 7, 7, 5)
    font[24] = pack_glyph(7, 5, 5, 5, 7)
    font[25] = pack_glyph(7, 5, 7, 4, 4)
    font[26] = pack_glyph(7, 5, 5, 7, 3)
    font[27] = pack_glyph(6, 5, 6, 5, 5)
    font[28] = pack_glyph(7, 4, 7, 1, 7)
    font[29] = pack_glyph(7, 2, 2, 2, 2)
    font[30] = pack_glyph(5, 5, 5, 5, 7)
    font[31] = pack_glyph(5, 5, 5, 5, 2)
    font[32] = pack_glyph(5, 5, 7, 7, 5)
    font[33] = pack_glyph(5, 5, 2, 5, 5)
    font[34] = pack_glyph(5, 5, 2, 2, 2)
    font[35] = pack_glyph(7, 1, 2, 4, 7)
    font[36] = pack_glyph(0, 0, 0, 0, 0)
    font[37] = pack_glyph(0, 2, 0, 2, 0)
    font[38] = pack_glyph(0, 0, 7, 0, 0)
    font[39] = pack_glyph(0, 0, 0, 0, 2)
    font[40] = pack_glyph(2, 2, 2, 0, 2)
    font[41] = pack_glyph(1, 1, 2, 4, 4)
}

fn char_index(c: i32) -> i32 {
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 65 and c <= 90 { return c - 65 + 10 }
    if c >= 97 and c <= 122 { return c - 97 + 10 }
    if c == 58 { return 37 }
    if c == 45 { return 38 }
    if c == 46 { return 39 }
    if c == 33 { return 40 }
    if c == 47 { return 41 }
    return 36
}

-- Assumes fill mode + fill color are already set by the caller.
fn draw_glyph(gi: i32, x: i32, y: i32, scale: i32) {
    if gi < 0 or gi >= NUM_GLYPHS { return }
    let packed: i32 = font[gi] as i32
    for row in 0..5 {
        let bits: i32 = (packed >> (row * 3)) & 7
        for col in 0..3 {
            if (bits >> (2 - col)) & 1 == 1 {
                let px: i32 = x + col * scale
                let py: i32 = y + row * scale
                rdpq.fill_rectangle(px, py, px + scale, py + scale)
            }
        }
    }
}

fn text_width(s: *c_char, scale: i32) -> i32 {
    let n: i32 = 0
    loop {
        if s[n] as i32 == 0 { break }
        n += 1
    }
    return n * 4 * scale
}

fn draw_text(s: *c_char, x: i32, y: i32, scale: i32, col: u32) {
    rdpq.set_mode_fill(col)
    let i: i32 = 0
    let step: i32 = 4 * scale
    loop {
        let c: i32 = s[i] as i32
        if c == 0 { break }
        draw_glyph(char_index(c), x + i * step, y, scale)
        i += 1
    }
}

fn draw_text_centered(s: *c_char, cx: i32, y: i32, scale: i32, col: u32) {
    draw_text(s, cx - text_width(s, scale) / 2, y, scale, col)
}

fn digit_count(n: i32) -> i32 {
    let d: i32 = 1
    let t: i32 = n
    loop {
        if t < 10 { break }
        t = t / 10
        d += 1
    }
    return d
}

fn draw_number(n: i32, x: i32, y: i32, scale: i32, col: u32) {
    let v: i32 = n
    if v < 0 { v = 0 }
    let digits: i32 = digit_count(v)
    rdpq.set_mode_fill(col)
    let step: i32 = 4 * scale
    let i: i32 = digits - 1
    loop {
        if i < 0 { break }
        draw_glyph(v % 10, x + i * step, y, scale)
        v = v / 10
        i -= 1
    }
}

fn number_width(n: i32, scale: i32) -> i32 {
    return digit_count(n) * 4 * scale
}

-- ============================================================
-- 2D primitive shared by the HUD overlay
-- ============================================================
fn draw_bar(x: i32, y: i32, w: i32, h: i32, pct: f32, fg: u32, bg: u32) {
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(x, y, x + w, y + h)
    let fw: i32 = (w as f32 * math.clamp_f(pct, 0.0, 1.0)) as i32
    if fw > 0 {
        rdpq.set_mode_fill(fg)
        rdpq.fill_rectangle(x, y, x + fw, y + h)
    }
}

-- ============================================================
-- Role palette (shared by the HUD and the title screen)
-- ============================================================
fn role_color(r: Role) -> u32 {
    match r {
        .tank   => { return 0x4C7CE0FF }
        .healer => { return 0x3ED27AFF }
        .melee  => { return 0xE04C4CFF }
        .ranged => { return 0xE0BC38FF }
    }
    return 0xFFFFFFFF
}

fn role_light(r: Role) -> u32 {
    match r {
        .tank   => { return 0x86AEF4FF }
        .healer => { return 0x84E8AEFF }
        .melee  => { return 0xF48E8EFF }
        .ranged => { return 0xF4DC8AFF }
    }
    return 0xFFFFFFFF
}

-- ============================================================
-- 3D state
--
-- The level is one baked mesh; units are separate models drawn with a
-- per-instance matrix. All models are generated by tools/gen_dungeon_models.py
-- and converted .glb -> .t3dm by the build.
-- ============================================================
static vp: T3DViewport = undefined

static mdl_dungeon: *T3DModel = none
static mdl_hero:  [*T3DModel; 4] = undefined   -- indexed by role_index()
static mdl_enemy: [*T3DModel; 3] = undefined   -- indexed by enemy_index()

-- One matrix per potentially-visible unit (4 heroes + 12 enemies).
static unit_fp: [*T3DMat4FP; 16] = undefined

-- Smoothed camera focus point, in world space.
static cam_tx: f32 = 0.0
static cam_tz: f32 = 0.0

fn role_index(r: Role) -> i32 {
    match r {
        .tank   => { return 0 }
        .healer => { return 1 }
        .melee  => { return 2 }
        .ranged => { return 3 }
    }
    return 0
}

fn enemy_index(k: EnemyKind) -> i32 {
    match k {
        .skeleton => { return 0 }
        .slime    => { return 1 }
        .boss     => { return 2 }
    }
    return 0
}

-- ============================================================
-- Grid <-> world
-- ============================================================
fn world_x(gx: i32) -> f32 {
    return gx as f32 - WORLD_OX
}

fn world_z(gy: i32) -> f32 {
    return gy as f32 - WORLD_OZ
}

-- ============================================================
-- Camera: frames the living party, eased so it glides between turns
-- ============================================================
fn update_camera(dt: f32) {
    let sx: f32 = 0.0
    let sz: f32 = 0.0
    let n: i32 = 0
    for i in 0..MAX_HEROES {
        if heroes[i].alive {
            sx = sx + world_x(heroes[i].gx)
            sz = sz + world_z(heroes[i].gy)
            n += 1
        }
    }
    if n > 0 {
        sx = sx / n as f32
        sz = sz / n as f32
    }

    -- keep the focus inside the map so the view never drifts off the level
    sx = math.clamp_f(sx, -CAM_CLAMP_X, CAM_CLAMP_X)
    sz = math.clamp_f(sz, -CAM_CLAMP_Z, CAM_CLAMP_Z)

    let t: f32 = math.clamp_f(CAM_SMOOTH * dt, 0.0, 1.0)
    cam_tx = math.lerp_f(cam_tx, sx, t)
    cam_tz = math.lerp_f(cam_tz, sz, t)

    let eye: T3DVec3 = undefined
    eye.x = cam_tx
    eye.y = CAM_H
    eye.z = cam_tz + CAM_BACK

    let tgt: T3DVec3 = undefined
    tgt.x = cam_tx
    tgt.y = 0.0
    tgt.z = cam_tz

    let up: T3DVec3 = undefined
    up.x = 0.0
    up.y = 1.0
    up.z = 0.0

    t3d.look_at(&vp, &eye, &tgt, &up)
}

fn snap_camera() {
    let sx: f32 = 0.0
    let sz: f32 = 0.0
    let n: i32 = 0
    for i in 0..MAX_HEROES {
        if heroes[i].alive {
            sx = sx + world_x(heroes[i].gx)
            sz = sz + world_z(heroes[i].gy)
            n += 1
        }
    }
    if n > 0 {
        cam_tx = math.clamp_f(sx / n as f32, -CAM_CLAMP_X, CAM_CLAMP_X)
        cam_tz = math.clamp_f(sz / n as f32, -CAM_CLAMP_Z, CAM_CLAMP_Z)
    }
}

-- ============================================================
-- 3D draw
-- ============================================================
fn draw_model_at(model: *T3DModel, fp: *T3DMat4FP, wx: f32, wz: f32,
                 rot: f32, scale: f32) {
    let sc: [3]f32 = undefined
    sc[0] = scale
    sc[1] = scale
    sc[2] = scale

    let eu: [3]f32 = undefined
    eu[0] = 0.0
    eu[1] = rot
    eu[2] = 0.0

    let tr: [3]f32 = undefined
    tr[0] = wx
    tr[1] = 0.0
    tr[2] = wz

    t3d_mat4fp_from_srt_euler(fp, &sc[0], &eu[0], &tr[0])
    t3d_matrix_push(fp)
    t3d.model_draw(model)
    t3d_matrix_pop(1)
}

fn render_world(dt: f32) {
    update_camera(dt)

    t3d.frame_start()
    t3d.viewport_attach(&vp)

    -- torchlit gloom: everything past the next room fades to the void color
    t3d.fog_set_enabled(true)
    t3d.fog_set_range(17.0, 46.0)
    t3d.fog_set_color(0x0C0A10FF)

    -- key light warm from above-left, cool bounce from the opposite side
    t3d.light_set_ambient(90, 86, 108)
    t3d.light_set_directional(0, 255, 236, 200, -0.45, -0.78, -0.44)
    t3d.light_set_directional(1, 110, 120, 165, 0.50, 0.25, -0.75)
    t3d.light_set_count(2)

    if mdl_dungeon != none {
        t3d.model_draw(mdl_dungeon)
    }

    -- Units share one matrix pool, handed out in draw order each frame.
    let slot: i32 = 0

    for i in 0..MAX_ENEMIES {
        if enemies[i].alive and slot < 16 {
            let mi: i32 = enemy_index(enemies[i].kind)
            if mdl_enemy[mi] != none and unit_fp[slot] != none {
                let esc: f32 = UNIT_SCALE
                if enemies[i].kind == EnemyKind.boss { esc = BOSS_SCALE }
                draw_model_at(mdl_enemy[mi], unit_fp[slot],
                              world_x(enemies[i].gx), world_z(enemies[i].gy),
                              enemies[i].facing, esc)
                slot += 1
            }
        }
    }

    for i in 0..MAX_HEROES {
        if heroes[i].alive and slot < 16 {
            let mi: i32 = role_index(heroes[i].role)
            if mdl_hero[mi] != none and unit_fp[slot] != none {
                draw_model_at(mdl_hero[mi], unit_fp[slot],
                              world_x(heroes[i].gx), world_z(heroes[i].gy),
                              heroes[i].facing, UNIT_SCALE)
                slot += 1
            }
        }
    }
}

-- ============================================================
-- HUD
-- ============================================================
fn role_name(r: Role) -> *c_char {
    match r {
        .tank   => { return "TANK" }
        .healer => { return "HEAL" }
        .melee  => { return "MELEE" }
        .ranged => { return "RANGED" }
    }
    return "----"
}

fn draw_hero_panel(slot: i32) {
    let px: i32 = 4 + slot * 78
    let py: i32 = HUD_Y
    let h: *Hero = &heroes[slot]
    let is_turn: bool = phase == Phase.hero_turn and active_hero == slot

    let bg: u32 = 0x16141CFF
    if is_turn { bg = 0x2E2C3EFF }
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(px, py, px + 74, py + 38)

    -- role swatch (greyed out when downed)
    let swatch: u32 = role_color(h.role)
    if not h.alive { swatch = 0x3A3A3AFF }
    rdpq.set_mode_fill(swatch)
    rdpq.fill_rectangle(px + 3, py + 4, px + 15, py + 16)

    -- player number on the swatch
    draw_number(slot + 1, px + 7, py + 8, 1, 0x101018FF)

    let name_col: u32 = 0xF2ECDCFF
    if not h.alive { name_col = 0x6A6A6AFF }
    draw_text(role_name(h.role), px + 19, py + 3, 2, name_col)

    if h.alive {
        let pct: f32 = h.hp as f32 / h.hp_max as f32
        let hp_col: u32 = 0x50E060FF
        if pct <= 0.5 { hp_col = 0xE0C040FF }
        if pct <= 0.25 { hp_col = 0xE04838FF }
        draw_bar(px + 19, py + 16, 50, 5, pct, hp_col, 0x201818FF)

        draw_number(h.hp, px + 19, py + 24, 1, 0xF2ECDCFF)
        let hx: i32 = px + 19 + number_width(h.hp, 1)
        draw_text("/", hx, py + 24, 1, 0x8A8A94FF)
        draw_number(h.hp_max, hx + 4, py + 24, 1, 0x8A8A94FF)
    } else {
        draw_text("DOWN", px + 19, py + 22, 2, 0xE04838FF)
    }

    -- ability cooldown pips: lit = ready
    let cd_max: i32 = role_ability_cd(h.role)
    let px2: i32 = px + 42
    for i in 0..cd_max {
        let pip: u32 = 0x33333CFF
        if i >= h.ability_cd and h.alive { pip = 0xE8C848FF }
        rdpq.set_mode_fill(pip)
        rdpq.fill_rectangle(px2, py + 24, px2 + 5, py + 30)
        px2 += 7
    }

    if is_turn {
        rdpq.set_mode_fill(0xFFF0A0FF)
        rdpq.fill_rectangle(px, py - 3, px + 74, py)
    }
}

fn draw_top_bar() {
    -- turn banner, centered
    if phase == Phase.hero_turn {
        let h: *Hero = &heroes[active_hero]
        let name: *c_char = role_name(h.role)
        let w: i32 = text_width(name, 2) + 4 * 2 * 6
        let sx: i32 = 160 - w / 2
        draw_text(name, sx, 6, 2, role_light(h.role))
        draw_text(" TURN", sx + text_width(name, 2), 6, 2, 0xF2ECDCFF)
        -- remaining movement points
        draw_text("MOVE", 232, 4, 1, 0x8A8A94FF)
        draw_number(h.move_left, 254, 4, 1, 0xF2ECDCFF)
    } elif phase == Phase.enemy_turn {
        draw_text_centered("ENEMY TURN", 160, 6, 2, 0xE07050FF)
    }

    -- enemy counter, top-left
    draw_text("FOES", 6, 4, 1, 0x8A8A94FF)
    draw_number(enemies_alive, 28, 4, 1, 0xE05848FF)

    -- round counter, top-right
    draw_text("RND", 288, 4, 1, 0x8A8A94FF)
    draw_number(round_num, 306, 4, 1, 0xF2ECDCFF)
}

fn draw_hud() {
    draw_top_bar()
    for i in 0..MAX_HEROES {
        draw_hero_panel(i)
    }
}

fn draw_scene(dt: f32) {
    let fb = display.get()
    rdpq.attach_clear(fb)

    -- 3D pass
    render_world(dt)

    -- 2D HUD overlay on top of the rendered scene
    rdpq.sync_pipe()
    draw_hud()

    rdpq.detach_show()
}

-- ============================================================
-- Title / victory / defeat screens
-- ============================================================
fn any_start_pressed() -> bool {
    controller.poll()
    for i in 0..MAX_HEROES {
        let pad = controller.read(i)
        if pad.pressed.start { return true }
    }
    return false
}

fn draw_role_card(x: i32, y: i32, r: Role, label: *c_char, sub: *c_char) {
    rdpq.set_mode_fill(0x1A1822FF)
    rdpq.fill_rectangle(x, y, x + 68, y + 58)
    rdpq.set_mode_fill(role_color(r))
    rdpq.fill_rectangle(x + 2, y + 2, x + 66, y + 26)

    -- a miniature of the in-world figure, centered on the swatch
    let cx: i32 = x + 34
    rdpq.set_mode_fill(role_light(r))
    rdpq.fill_rectangle(cx - 4, y + 8, cx + 4, y + 22)
    rdpq.fill_rectangle(cx - 3, y + 5, cx + 3, y + 9)

    draw_text_centered(label, x + 34, y + 32, 1, 0xF2ECDCFF)
    draw_text_centered(sub,   x + 34, y + 44, 1, 0x8A8A94FF)
}

fn draw_title() {
    let fb = display.get()
    rdpq.attach_clear(fb)

    rdpq.set_mode_fill(0x0C0A10FF)
    rdpq.fill_rectangle(0, 0, 320, 240)

    -- title plate
    rdpq.set_mode_fill(0x1A1822FF)
    rdpq.fill_rectangle(28, 14, 292, 62)
    rdpq.set_mode_fill(0xE0BC38FF)
    rdpq.fill_rectangle(28, 14, 292, 17)
    rdpq.fill_rectangle(28, 59, 292, 62)

    draw_text_centered("DUNGEON", 160, 22, 3, 0xF2ECDCFF)
    draw_text_centered("QUARTET", 160, 42, 3, 0xE0BC38FF)

    draw_text_centered("4 PLAYER TURN BASED CRAWL", 160, 72, 1, 0x8A8A94FF)

    draw_role_card(6,   90, Role.tank,   "TANK",   "P1 GUARD")
    draw_role_card(84,  90, Role.melee,  "MELEE",  "P2 BLADE")
    draw_role_card(162, 90, Role.healer, "HEAL",   "P3 MEND")
    draw_role_card(240, 90, Role.ranged, "RANGED", "P4 BOW")

    draw_text_centered("DPAD MOVE   A ACT   B ABILITY", 160, 166, 1, 0x8A8A94FF)
    draw_text_centered("START ENDS YOUR TURN", 160, 180, 1, 0x8A8A94FF)

    if (frame_counter / 20) % 2 == 0 {
        draw_text_centered("PRESS START", 160, 208, 2, 0xFFF0A0FF)
    }

    rdpq.detach_show()
}

fn draw_end_screen(win: bool) {
    let fb = display.get()
    rdpq.attach_clear(fb)

    let bg: u32 = 0x1A1012FF
    if win { bg = 0x121A10FF }
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(0, 0, 320, 240)

    let accent: u32 = 0xE04838FF
    if win { accent = 0xE8C848FF }

    rdpq.set_mode_fill(0x0E0C12FF)
    rdpq.fill_rectangle(40, 48, 280, 104)
    rdpq.set_mode_fill(accent)
    rdpq.fill_rectangle(40, 48, 280, 52)
    rdpq.fill_rectangle(40, 100, 280, 104)

    if win {
        draw_text_centered("VICTORY", 160, 64, 4, accent)
    } else {
        draw_text_centered("DEFEAT", 160, 64, 4, accent)
    }

    -- party roster with final state
    let i: i32 = 0
    loop {
        if i >= MAX_HEROES { break }
        let ry: i32 = 122 + i * 22
        rdpq.set_mode_fill(0x16141CFF)
        rdpq.fill_rectangle(60, ry, 260, ry + 18)

        let sw: u32 = role_color(heroes[i].role)
        if not heroes[i].alive { sw = 0x3A3A3AFF }
        rdpq.set_mode_fill(sw)
        rdpq.fill_rectangle(64, ry + 3, 76, ry + 15)

        draw_text(role_name(heroes[i].role), 84, ry + 6, 1, 0xF2ECDCFF)

        if heroes[i].alive {
            draw_text("ALIVE", 178, ry + 6, 1, 0x50E060FF)
            draw_number(heroes[i].hp, 224, ry + 6, 1, 0xF2ECDCFF)
            let hx: i32 = 224 + number_width(heroes[i].hp, 1)
            draw_text("/", hx, ry + 6, 1, 0x8A8A94FF)
            draw_number(heroes[i].hp_max, hx + 4, ry + 6, 1, 0x8A8A94FF)
        } else {
            draw_text("DOWN", 178, ry + 6, 1, 0xE04838FF)
        }
        i += 1
    }

    draw_text("ROUNDS", 60, 216, 1, 0x8A8A94FF)
    draw_number(round_num, 92, 216, 1, 0xF2ECDCFF)

    if (frame_counter / 20) % 2 == 0 {
        draw_text("PRESS START", 176, 216, 1, 0xFFF0A0FF)
    }

    rdpq.detach_show()
}

-- ============================================================
-- Entry point
-- ============================================================
entry {
    display.init(0, 2, 3, 0, 1)
    rdpq.init()
    controller.init()
    timer.init()
    t3d.init()

    -- 60-degree vertical FOV; far plane past the longest sightline in the map
    vp = t3d.viewport_create()
    t3d.viewport_set_projection(&vp, 60.0, 1.0, 60.0)

    mdl_dungeon   = t3d.model_load("rom:/models/dungeon.t3dm")
    mdl_hero[0]   = t3d.model_load("rom:/models/hero_tank.t3dm")
    mdl_hero[1]   = t3d.model_load("rom:/models/hero_healer.t3dm")
    mdl_hero[2]   = t3d.model_load("rom:/models/hero_melee.t3dm")
    mdl_hero[3]   = t3d.model_load("rom:/models/hero_ranged.t3dm")
    mdl_enemy[0]  = t3d.model_load("rom:/models/enemy_skeleton.t3dm")
    mdl_enemy[1]  = t3d.model_load("rom:/models/enemy_slime.t3dm")
    mdl_enemy[2]  = t3d.model_load("rom:/models/enemy_boss.t3dm")

    -- per-instance matrices (16-byte aligned, uncached for RSP DMA)
    let mi: i32 = 0
    loop {
        if mi >= 16 { break }
        unit_fp[mi] = Mat4Fp.create()
        mi += 1
    }

    init_font()
    phase = Phase.title

    loop {
        let dt: f32 = timer.delta()
        if dt > 0.05 { dt = 0.05 }
        frame_counter += 1

        match phase {
            .title => {
                if any_start_pressed() {
                    start_level()
                    snap_camera()
                }
                draw_title()
            }
            .hero_turn => {
                handle_hero_input(dt)
                draw_scene(dt)
            }
            .enemy_turn => {
                enemy_phase_timer -= dt
                if enemy_phase_timer <= 0.0 {
                    check_outcomes()
                    if phase == Phase.enemy_turn { begin_hero_phase() }
                }
                draw_scene(dt)
            }
            .victory => {
                if any_start_pressed() { phase = Phase.title }
                draw_end_screen(true)
            }
            .defeat => {
                if any_start_pressed() { phase = Phase.title }
                draw_end_screen(false)
            }
        }
    }
}
