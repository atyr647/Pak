-- demos/dungeon_quartet/src/main.pk64
-- Dungeon Quartet
--
-- A 4-player local co-op, turn-based dungeon crawler rendered in 3D.
-- Each player controls one fixed role -- Tank, Healer, Melee DPS, Ranged DPS
-- -- sharing a single screen. Turn order is P1 -> P2 -> P3 -> P4 -> Enemies,
-- repeating until the party wipes or every enemy in the dungeon is dead.
--
-- Controls (each hero acts on their own turn, using their own controller port):
--   D-pad      -- move one tile (movement points vary by role)
--   A          -- primary action (melee attack / ranged shot / heal)
--   B          -- role ability (limited by a per-round cooldown)
--   Start      -- end turn early / advance title & end screens
--
-- Rendering: the world is real 3D geometry drawn through Tiny3D with a
-- chase camera that frames the living party; the HUD is a 2D RDP overlay
-- using an in-code 3x5 bitmap font (no font asset needed).
--
-- Models come from tools/gen_dungeon_models.py, which writes .glb files into
-- assets/models/. The build converts them to .t3dm via $(T3D_GLTF), so
-- pak.toml must set  [dependencies] tiny3d = true.

use n64.display
use n64.controller
use n64.rdpq
use n64.timer
use n64.math
use n64.surface
use t3d

-- libdragon tex_format_t value used for the depth buffer.
extern const FMT_RGBA16: i32

extern "C" {
    fn t3d_matrix_push(mat: *T3DMat4FP)
    fn t3d_matrix_pop(count: i32)
    fn t3d_mat4fp_from_srt_euler(mat: *T3DMat4FP, scale: *f32, rot: *f32, translate: *f32)
}

-- ============================================================
-- Constants
-- ============================================================
-- 640x480 is the N64's maximum resolution. It is interlaced and expensive to
-- fill, so we run double-buffered (a third 614 KB framebuffer plus the depth
-- buffer would not leave enough of the 4 MB for game data).
const SCREEN_W: i32 = 640
const SCREEN_H: i32 = 480

const GRID_W: i32 = 32
const GRID_H: i32 = 24
const GRID_CELLS: i32 = 768        -- GRID_W * GRID_H

-- The level ships as a 3x3 grid of chunk models; only chunks near the camera
-- are drawn, which keeps the per-frame triangle count down at 640x480.
const CHUNK_COLS: i32 = 3
const CHUNK_ROWS: i32 = 3
const CHUNK_W:    i32 = 11
const CHUNK_H:    i32 = 8
const NUM_CHUNKS: i32 = 9
const CHUNK_DRAW_DIST: f32 = 21.0

const TILE_WALL:  u8 = 0
const TILE_FLOOR: u8 = 1

const MAX_HEROES:  i32 = 4
const MAX_ENEMIES: i32 = 24

const HUD_Y: i32 = 400

-- role tuning
const TANK_HP:     i32 = 30
const TANK_ATK:    i32 = 3
const TANK_MOVE:   i32 = 3
const TANK_CD:     i32 = 3
const TAUNT_TURNS: i32 = 2

const HEAL_HP:      i32 = 14
const HEAL_AMT:     i32 = 6
const HEAL_GROUP:   i32 = 4
const HEAL_RADIUS:  i32 = 6
const HEAL_MOVE:    i32 = 4
const HEAL_CD:      i32 = 4

const MELEE_HP:    i32 = 20
const MELEE_ATK:   i32 = 6
const MELEE_WHIRL: i32 = 4
const MELEE_MOVE:  i32 = 5
const MELEE_CD:    i32 = 3

const RANGED_HP:     i32 = 16
const RANGED_ATK:    i32 = 4
const RANGED_VOLLEY: i32 = 3
const RANGED_RANGE:  i32 = 6
const RANGED_MOVE:   i32 = 4
const RANGED_CD:     i32 = 3

-- enemy tuning: hp / attack / tiles moved per enemy phase
const SLIME_HP:  i32 = 6    const SLIME_ATK:  i32 = 2   const SLIME_MOVE:  i32 = 1
const GOB_HP:    i32 = 8    const GOB_ATK:    i32 = 3   const GOB_MOVE:    i32 = 2
const SKEL_HP:   i32 = 10   const SKEL_ATK:   i32 = 3   const SKEL_MOVE:   i32 = 1
const BAT_HP:    i32 = 5    const BAT_ATK:    i32 = 2   const BAT_MOVE:    i32 = 3
const SPIDER_HP: i32 = 7    const SPIDER_ATK: i32 = 4   const SPIDER_MOVE: i32 = 2
const ZOMB_HP:   i32 = 14   const ZOMB_ATK:   i32 = 3   const ZOMB_MOVE:   i32 = 1
const ORC_HP:    i32 = 18   const ORC_ATK:    i32 = 5   const ORC_MOVE:    i32 = 1
const WRAITH_HP: i32 = 12   const WRAITH_ATK: i32 = 4   const WRAITH_MOVE: i32 = 2
const BOSS_HP:   i32 = 40   const BOSS_ATK:   i32 = 5   const BOSS_MOVE:   i32 = 1

const ENEMY_PHASE_TIME: f32 = 0.7

-- 3D world layout: one grid tile = one world unit, grid centered on origin.
--   world x = gx - (GRID_W-1)/2      world z = gy - (GRID_H-1)/2
const WORLD_OX: f32 = 15.5
const WORLD_OZ: f32 = 11.5

-- Models are authored facing -Z, so a Y rotation of 0 looks "north" (gy-1).
const FACE_NORTH: f32 =  0.0
const FACE_SOUTH: f32 =  3.14159265
const FACE_EAST:  f32 = -1.57079633
const FACE_WEST:  f32 =  1.57079633

-- Camera framing
const CAM_H:      f32 = 7.0     -- height above the focus point
const CAM_BACK:   f32 = 8.5     -- distance behind (+Z of) the focus point
const CAM_SMOOTH: f32 = 4.0     -- exponential follow rate
const CAM_CLAMP_X: f32 = 12.0
const CAM_CLAMP_Z: f32 = 8.0

-- Units are drawn oversized relative to a 1-unit tile so they stay readable
-- at N64 resolution -- the usual trick in grid tactics games.
const UNIT_SCALE: f32 = 1.5
const BOSS_SCALE: f32 = 1.45

-- ============================================================
-- Types
-- ============================================================
enum Role: u8 { tank, healer, melee, ranged }
enum EnemyKind: u8 { slime, goblin, skeleton, bat, spider, zombie, orc, wraith, boss }
enum Phase: u8 { title, hero_turn, enemy_turn, victory, defeat }

struct Hero {
    gx:          i32
    gy:          i32
    hp:          i32
    hp_max:      i32
    role:        Role
    move_left:   i32
    alive:       bool
    ability_cd:  i32
    taunt_turns: i32
    facing:      f32   -- Y rotation of the model, radians
}

struct Enemy {
    gx:    i32
    gy:    i32
    hp:    i32
    hp_max: i32
    kind:  EnemyKind
    alive: bool
    facing: f32
}

-- ============================================================
-- Globals
-- ============================================================
static level: [768]u8 = undefined   -- GRID_W * GRID_H, row-major (gy * GRID_W + gx)

static heroes:  [4]Hero    = undefined
static enemies: [24]Enemy  = undefined
static enemies_alive: i32  = 0

static phase:             Phase = Phase.title
static active_hero:       i32   = 0
static enemy_phase_timer: f32   = 0.0
static frame_counter:     i32   = 0
static round_num:         i32   = 0

-- ============================================================
-- Dungeon layout
-- ============================================================
fn tile_index(gx: i32, gy: i32) -> i32 {
    return gy * GRID_W + gx
}

fn tile_at(gx: i32, gy: i32) -> u8 {
    if gx < 0 or gx >= GRID_W or gy < 0 or gy >= GRID_H {
        return TILE_WALL
    }
    return level[tile_index(gx, gy)]
}

fn carve(x0: i32, y0: i32, x1: i32, y1: i32) {
    for gy in y0..(y1 + 1) {
        for gx in x0..(x1 + 1) {
            level[tile_index(gx, gy)] = TILE_FLOOR
        }
    }
}

-- 3x3 grid of rooms, every neighbour joined by a 2-tile-wide corridor so two
-- units can pass each other anywhere in the dungeon.
-- Layout must stay in sync with tools/gen_dungeon_models.py.
fn build_level() {
    for i in 0..GRID_CELLS {
        level[i] = TILE_WALL
    }

    -- rooms, north row / middle row / south row
    carve(2,  2,  8,  6)     -- A  start
    carve(12, 2,  19, 6)     -- B
    carve(23, 2,  29, 6)     -- C
    carve(2,  10, 8,  15)    -- D
    carve(12, 10, 19, 15)    -- E  central hub
    carve(23, 10, 29, 15)    -- F
    carve(2,  18, 8,  22)    -- G
    carve(12, 18, 19, 22)    -- H
    carve(23, 18, 29, 22)    -- I  boss

    -- horizontal corridors (2 tiles tall)
    carve(8,  3,  12, 4)
    carve(19, 3,  23, 4)
    carve(8,  12, 12, 13)
    carve(19, 12, 23, 13)
    carve(8,  19, 12, 20)
    carve(19, 19, 23, 20)

    -- vertical corridors (2 tiles wide)
    carve(4,  6,  5,  10)
    carve(15, 6,  16, 10)
    carve(26, 6,  27, 10)
    carve(4,  15, 5,  18)
    carve(15, 15, 16, 18)
    carve(26, 15, 27, 18)
}

-- ============================================================
-- Occupancy queries
-- ============================================================
fn hero_at(gx: i32, gy: i32) -> i32 {
    for i in 0..MAX_HEROES {
        if heroes[i].alive and heroes[i].gx == gx and heroes[i].gy == gy {
            return i
        }
    }
    return -1
}

fn enemy_at(gx: i32, gy: i32) -> i32 {
    for i in 0..MAX_ENEMIES {
        if enemies[i].alive and enemies[i].gx == gx and enemies[i].gy == gy {
            return i
        }
    }
    return -1
}

fn tile_walkable(gx: i32, gy: i32) -> bool {
    if tile_at(gx, gy) != TILE_FLOOR { return false }
    if hero_at(gx, gy) >= 0 { return false }
    if enemy_at(gx, gy) >= 0 { return false }
    return true
}

fn manhattan(ax: i32, ay: i32, bx: i32, by: i32) -> i32 {
    return math.abs_i32(ax - bx) + math.abs_i32(ay - by)
}

-- ============================================================
-- Role tuning lookups
-- ============================================================
fn role_move_points(r: Role) -> i32 {
    match r {
        .tank   => { return TANK_MOVE }
        .healer => { return HEAL_MOVE }
        .melee  => { return MELEE_MOVE }
        .ranged => { return RANGED_MOVE }
    }
    return 1
}

fn role_ability_cd(r: Role) -> i32 {
    match r {
        .tank   => { return TANK_CD }
        .healer => { return HEAL_CD }
        .melee  => { return MELEE_CD }
        .ranged => { return RANGED_CD }
    }
    return 1
}

-- ============================================================
-- Setup
-- ============================================================
fn init_hero(h: *Hero, gx: i32, gy: i32, role: Role, hp: i32) {
    h.gx = gx
    h.gy = gy
    h.hp = hp
    h.hp_max = hp
    h.role = role
    h.move_left = 0
    h.alive = true
    h.ability_cd = 0
    h.taunt_turns = 0
    h.facing = FACE_SOUTH
}

fn init_enemy(e: *Enemy, gx: i32, gy: i32, kind: EnemyKind) {
    e.gx = gx
    e.gy = gy
    let hp: i32 = enemy_hp_for(kind)
    e.hp = hp
    e.hp_max = hp
    e.kind = kind
    e.alive = true
    e.facing = FACE_NORTH
}

-- Encounters are themed per room and escalate as the party pushes east and
-- south toward the boss wing: vermin near the entrance, brutes and undead deep in.
fn spawn_enemies() {
    for i in 0..MAX_ENEMIES {
        enemies[i].alive = false
    }

    -- Room B (north-centre): vermin
    init_enemy(&enemies[0],  14, 3,  EnemyKind.bat)
    init_enemy(&enemies[1],  17, 4,  EnemyKind.goblin)
    init_enemy(&enemies[2],  15, 5,  EnemyKind.slime)
    -- Room C (north-east): goblin camp
    init_enemy(&enemies[3],  25, 3,  EnemyKind.goblin)
    init_enemy(&enemies[4],  27, 5,  EnemyKind.goblin)
    init_enemy(&enemies[5],  24, 5,  EnemyKind.spider)
    -- Room D (west): nest
    init_enemy(&enemies[6],  3,  12, EnemyKind.spider)
    init_enemy(&enemies[7],  6,  14, EnemyKind.slime)
    init_enemy(&enemies[8],  4,  15, EnemyKind.bat)
    -- Room E (central hub): the midpoint fight, mixed
    init_enemy(&enemies[9],  14, 11, EnemyKind.skeleton)
    init_enemy(&enemies[10], 17, 12, EnemyKind.skeleton)
    init_enemy(&enemies[11], 15, 14, EnemyKind.goblin)
    init_enemy(&enemies[12], 18, 14, EnemyKind.orc)
    -- Room F (east): crypt
    init_enemy(&enemies[13], 25, 11, EnemyKind.skeleton)
    init_enemy(&enemies[14], 28, 13, EnemyKind.zombie)
    init_enemy(&enemies[15], 26, 15, EnemyKind.zombie)
    -- Room G (south-west): brute den
    init_enemy(&enemies[16], 4,  20, EnemyKind.orc)
    init_enemy(&enemies[17], 7,  21, EnemyKind.goblin)
    -- Room H (south-centre): haunt
    init_enemy(&enemies[18], 14, 20, EnemyKind.wraith)
    init_enemy(&enemies[19], 17, 21, EnemyKind.zombie)
    init_enemy(&enemies[20], 16, 19, EnemyKind.skeleton)
    -- Room I (boss room): the demon lord and his guard
    init_enemy(&enemies[21], 24, 19, EnemyKind.wraith)
    init_enemy(&enemies[22], 28, 21, EnemyKind.orc)
    init_enemy(&enemies[23], 26, 20, EnemyKind.boss)
    enemies_alive = 24
}

fn start_level() {
    build_level()

    init_hero(&heroes[0], 4, 4, Role.tank,   TANK_HP)
    init_hero(&heroes[1], 5, 4, Role.melee,  MELEE_HP)
    init_hero(&heroes[2], 4, 5, Role.healer, HEAL_HP)
    init_hero(&heroes[3], 5, 5, Role.ranged, RANGED_HP)

    spawn_enemies()

    round_num = 0
    phase = Phase.hero_turn
    active_hero = next_alive_hero(0)
    if active_hero < MAX_HEROES {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

-- ============================================================
-- Turn sequencing
-- ============================================================
fn next_alive_hero(start: i32) -> i32 {
    let i: i32 = start
    loop {
        if i >= MAX_HEROES { break }
        if heroes[i].alive { break }
        i = i + 1
    }
    return i
}

fn any_hero_alive() -> bool {
    for i in 0..MAX_HEROES {
        if heroes[i].alive { return true }
    }
    return false
}

fn begin_hero_phase() {
    round_num = round_num + 1
    -- tick cooldowns / taunt once per round
    for i in 0..MAX_HEROES {
        if heroes[i].ability_cd > 0 { heroes[i].ability_cd -= 1 }
        if heroes[i].taunt_turns > 0 { heroes[i].taunt_turns -= 1 }
    }
    phase = Phase.hero_turn
    active_hero = next_alive_hero(0)
    if active_hero < MAX_HEROES {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

fn begin_enemy_phase() {
    phase = Phase.enemy_turn
    enemy_phase_timer = ENEMY_PHASE_TIME
    run_enemy_ai()
}

fn end_hero_turn() {
    active_hero = next_alive_hero(active_hero + 1)
    if active_hero >= MAX_HEROES {
        begin_enemy_phase()
    } else {
        heroes[active_hero].move_left = role_move_points(heroes[active_hero].role)
    }
}

fn check_outcomes() {
    if enemies_alive <= 0 {
        phase = Phase.victory
        return
    }
    if not any_hero_alive() {
        phase = Phase.defeat
        return
    }
}

-- ============================================================
-- Hero actions
-- ============================================================
-- Y rotation that makes a model authored facing -Z look along (dx, dy).
fn facing_from_delta(dx: i32, dy: i32) -> f32 {
    if dx > 0 { return FACE_EAST }
    if dx < 0 { return FACE_WEST }
    if dy > 0 { return FACE_SOUTH }
    return FACE_NORTH
}

fn face_toward(from_x: i32, from_y: i32, to_x: i32, to_y: i32) -> f32 {
    let dx: i32 = to_x - from_x
    let dy: i32 = to_y - from_y
    if math.abs_i32(dx) >= math.abs_i32(dy) { return facing_from_delta(dx, 0) }
    return facing_from_delta(0, dy)
}

fn try_move_hero(h: *Hero, dx: i32, dy: i32) {
    if h.move_left <= 0 { return }
    -- turning to look where you are headed is free, even into a wall
    h.facing = facing_from_delta(dx, dy)
    let nx: i32 = h.gx + dx
    let ny: i32 = h.gy + dy
    if not tile_walkable(nx, ny) { return }
    h.gx = nx
    h.gy = ny
    h.move_left -= 1
}

-- returns index of first living enemy adjacent to (gx,gy), or -1
fn adjacent_enemy(gx: i32, gy: i32) -> i32 {
    let e: i32 = enemy_at(gx, gy - 1)
    if e >= 0 { return e }
    e = enemy_at(gx, gy + 1)
    if e >= 0 { return e }
    e = enemy_at(gx - 1, gy)
    if e >= 0 { return e }
    e = enemy_at(gx + 1, gy)
    if e >= 0 { return e }
    return -1
}

fn damage_enemy(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_ENEMIES { return }
    if not enemies[idx].alive { return }
    enemies[idx].hp -= amt
    if enemies[idx].hp <= 0 {
        enemies[idx].hp = 0
        enemies[idx].alive = false
        enemies_alive -= 1
    }
}

fn nearest_enemy_in_line(gx: i32, gy: i32, range: i32) -> i32 {
    let best: i32 = -1
    let best_d: i32 = range + 1
    for i in 0..MAX_ENEMIES {
        if not enemies[i].alive { continue }
        let same_row: bool = enemies[i].gy == gy
        let same_col: bool = enemies[i].gx == gx
        if not (same_row or same_col) { continue }
        let d: i32 = manhattan(gx, gy, enemies[i].gx, enemies[i].gy)
        if d <= range and d < best_d {
            best = i
            best_d = d
        }
    }
    return best
}

fn lowest_hp_ally(gx: i32, gy: i32, radius: i32) -> i32 {
    let best: i32 = -1
    let best_hp: i32 = 999999
    for i in 0..MAX_HEROES {
        if not heroes[i].alive { continue }
        if heroes[i].hp >= heroes[i].hp_max { continue }
        let d: i32 = manhattan(gx, gy, heroes[i].gx, heroes[i].gy)
        if d <= radius and heroes[i].hp < best_hp {
            best = i
            best_hp = heroes[i].hp
        }
    }
    return best
}

fn heal_hero(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_HEROES { return }
    heroes[idx].hp += amt
    if heroes[idx].hp > heroes[idx].hp_max { heroes[idx].hp = heroes[idx].hp_max }
}

-- Primary action (A). Returns true if the turn should end.
fn hero_primary_action(h_idx: i32) -> bool {
    let h: *Hero = &heroes[h_idx]
    match h.role {
        .tank => {
            let e: i32 = adjacent_enemy(h.gx, h.gy)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, TANK_ATK)
            return true
        }
        .melee => {
            let e: i32 = adjacent_enemy(h.gx, h.gy)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, MELEE_ATK)
            return true
        }
        .ranged => {
            let e: i32 = nearest_enemy_in_line(h.gx, h.gy, RANGED_RANGE)
            if e < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, enemies[e].gx, enemies[e].gy)
            damage_enemy(e, RANGED_ATK)
            return true
        }
        .healer => {
            let a: i32 = lowest_hp_ally(h.gx, h.gy, HEAL_RADIUS)
            if a < 0 { return false }
            h.facing = face_toward(h.gx, h.gy, heroes[a].gx, heroes[a].gy)
            heal_hero(a, HEAL_AMT)
            return true
        }
    }
    return false
}

-- Role ability (B). Returns true if the turn should end.
fn hero_ability(h_idx: i32) -> bool {
    let h: *Hero = &heroes[h_idx]
    if h.ability_cd > 0 { return false }

    match h.role {
        .tank => {
            h.taunt_turns = TAUNT_TURNS
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .melee => {
            damage_enemy(enemy_at(h.gx, h.gy - 1), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx, h.gy + 1), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx - 1, h.gy), MELEE_WHIRL)
            damage_enemy(enemy_at(h.gx + 1, h.gy), MELEE_WHIRL)
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .ranged => {
            for i in 0..MAX_ENEMIES {
                if not enemies[i].alive { continue }
                if enemies[i].gy == h.gy and manhattan(h.gx, h.gy, enemies[i].gx, enemies[i].gy) <= RANGED_RANGE {
                    damage_enemy(i, RANGED_VOLLEY)
                }
            }
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
        .healer => {
            for i in 0..MAX_HEROES {
                if not heroes[i].alive { continue }
                if manhattan(h.gx, h.gy, heroes[i].gx, heroes[i].gy) <= HEAL_RADIUS {
                    heal_hero(i, HEAL_GROUP)
                }
            }
            h.ability_cd = role_ability_cd(h.role)
            return true
        }
    }
    return false
}

-- ============================================================
-- Enemy AI
-- ============================================================
fn taunting_hero() -> i32 {
    for i in 0..MAX_HEROES {
        if heroes[i].alive and heroes[i].taunt_turns > 0 { return i }
    }
    return -1
}

fn nearest_hero(gx: i32, gy: i32) -> i32 {
    let best: i32 = -1
    let best_d: i32 = 999999
    for i in 0..MAX_HEROES {
        if not heroes[i].alive { continue }
        let d: i32 = manhattan(gx, gy, heroes[i].gx, heroes[i].gy)
        if d < best_d {
            best = i
            best_d = d
        }
    }
    return best
}

fn enemy_atk_for(kind: EnemyKind) -> i32 {
    match kind {
        .slime    => { return SLIME_ATK }
        .goblin   => { return GOB_ATK }
        .skeleton => { return SKEL_ATK }
        .bat      => { return BAT_ATK }
        .spider   => { return SPIDER_ATK }
        .zombie   => { return ZOMB_ATK }
        .orc      => { return ORC_ATK }
        .wraith   => { return WRAITH_ATK }
        .boss     => { return BOSS_ATK }
    }
    return 1
}

fn enemy_hp_for(kind: EnemyKind) -> i32 {
    match kind {
        .slime    => { return SLIME_HP }
        .goblin   => { return GOB_HP }
        .skeleton => { return SKEL_HP }
        .bat      => { return BAT_HP }
        .spider   => { return SPIDER_HP }
        .zombie   => { return ZOMB_HP }
        .orc      => { return ORC_HP }
        .wraith   => { return WRAITH_HP }
        .boss     => { return BOSS_HP }
    }
    return 1
}

-- How many tiles this kind covers in one enemy phase. Bats close fast,
-- brutes and slimes lumber.
fn enemy_move_for(kind: EnemyKind) -> i32 {
    match kind {
        .slime    => { return SLIME_MOVE }
        .goblin   => { return GOB_MOVE }
        .skeleton => { return SKEL_MOVE }
        .bat      => { return BAT_MOVE }
        .spider   => { return SPIDER_MOVE }
        .zombie   => { return ZOMB_MOVE }
        .orc      => { return ORC_MOVE }
        .wraith   => { return WRAITH_MOVE }
        .boss     => { return BOSS_MOVE }
    }
    return 1
}

fn damage_hero(idx: i32, amt: i32) {
    if idx < 0 or idx >= MAX_HEROES { return }
    if not heroes[idx].alive { return }
    heroes[idx].hp -= amt
    if heroes[idx].hp <= 0 {
        heroes[idx].hp = 0
        heroes[idx].alive = false
    }
}

-- One step of an enemy's turn. Returns true when its turn is over -- it
-- either attacked, or has nowhere left to go.
fn enemy_step(e: *Enemy) -> bool {
    let target: i32 = taunting_hero()
    if target < 0 { target = nearest_hero(e.gx, e.gy) }
    if target < 0 { return true }

    let tx: i32 = heroes[target].gx
    let ty: i32 = heroes[target].gy

    -- always turn to face whoever this enemy is hunting
    e.facing = face_toward(e.gx, e.gy, tx, ty)

    if manhattan(e.gx, e.gy, tx, ty) == 1 {
        damage_hero(target, enemy_atk_for(e.kind))
        return true
    }

    let dx: i32 = 0
    let dy: i32 = 0
    if tx > e.gx { dx = 1 } elif tx < e.gx { dx = -1 }
    if ty > e.gy { dy = 1 } elif ty < e.gy { dy = -1 }

    let adx: i32 = math.abs_i32(tx - e.gx)
    let ady: i32 = math.abs_i32(ty - e.gy)

    if adx >= ady {
        if dx != 0 and tile_at(e.gx + dx, e.gy) == TILE_FLOOR and hero_at(e.gx + dx, e.gy) < 0 and enemy_at(e.gx + dx, e.gy) < 0 {
            e.gx += dx
            return false
        }
        if dy != 0 and tile_at(e.gx, e.gy + dy) == TILE_FLOOR and hero_at(e.gx, e.gy + dy) < 0 and enemy_at(e.gx, e.gy + dy) < 0 {
            e.gy += dy
            return false
        }
    } else {
        if dy != 0 and tile_at(e.gx, e.gy + dy) == TILE_FLOOR and hero_at(e.gx, e.gy + dy) < 0 and enemy_at(e.gx, e.gy + dy) < 0 {
            e.gy += dy
            return false
        }
        if dx != 0 and tile_at(e.gx + dx, e.gy) == TILE_FLOOR and hero_at(e.gx + dx, e.gy) < 0 and enemy_at(e.gx + dx, e.gy) < 0 {
            e.gx += dx
            return false
        }
    }
    return true
}

-- Each kind covers a different number of tiles per phase.
fn enemy_take_turn(e: *Enemy) {
    let steps: i32 = enemy_move_for(e.kind)
    let i: i32 = 0
    loop {
        if i >= steps { break }
        if enemy_step(e) { break }
        i += 1
    }
}

fn run_enemy_ai() {
    for i in 0..MAX_ENEMIES {
        if not enemies[i].alive { continue }
        enemy_take_turn(&enemies[i])
    }
}

-- ============================================================
-- Input handling
-- ============================================================
fn handle_hero_input(dt: f32) {
    let h_idx: i32 = active_hero
    let h: *Hero = &heroes[h_idx]

    controller.poll()
    let pad = controller.read(h_idx)

    let ended: bool = false

    if pad.pressed.up    { try_move_hero(h, 0, -1) }
    elif pad.pressed.down  { try_move_hero(h, 0, 1) }
    elif pad.pressed.left  { try_move_hero(h, -1, 0) }
    elif pad.pressed.right { try_move_hero(h, 1, 0) }
    elif pad.pressed.a { ended = hero_primary_action(h_idx) }
    elif pad.pressed.b { ended = hero_ability(h_idx) }
    elif pad.pressed.start { ended = true }

    if ended {
        end_hero_turn()
        check_outcomes()
    }
}

-- ============================================================
-- Bitmap font -- 5x7 glyphs, asset-free
--
-- A 3x5 font has no detail left to reveal when scaled up, so glyphs are
-- stored as 7 rows of 5 bits (bit 4 = leftmost column), one byte per row.
-- Layout: 0-9 = 0..9, A-Z = 10..35, space=36, ':'=37, '-'=38, '.'=39,
--         '!'=40, '/'=41
-- ============================================================
const NUM_GLYPHS: i32 = 42
const GLYPH_W:    i32 = 5
const GLYPH_H:    i32 = 7
const GLYPH_ADV:  i32 = 6    -- glyph width + 1 column of spacing

static font: [294]u8 = undefined    -- NUM_GLYPHS * GLYPH_H

fn set_glyph(gi: i32, r0: i32, r1: i32, r2: i32, r3: i32,
             r4: i32, r5: i32, r6: i32) {
    font[gi * 7 + 0] = r0 as u8
    font[gi * 7 + 1] = r1 as u8
    font[gi * 7 + 2] = r2 as u8
    font[gi * 7 + 3] = r3 as u8
    font[gi * 7 + 4] = r4 as u8
    font[gi * 7 + 5] = r5 as u8
    font[gi * 7 + 6] = r6 as u8
}

fn init_font() {
    set_glyph(0,  14, 17, 19, 21, 25, 17, 14)   -- 0
    set_glyph(1,   4, 12,  4,  4,  4,  4, 14)   -- 1
    set_glyph(2,  14, 17,  1,  2,  4,  8, 31)   -- 2
    set_glyph(3,  31,  2,  4,  2,  1, 17, 14)   -- 3
    set_glyph(4,   2,  6, 10, 18, 31,  2,  2)   -- 4
    set_glyph(5,  31, 16, 30,  1,  1, 17, 14)   -- 5
    set_glyph(6,   6,  8, 16, 30, 17, 17, 14)   -- 6
    set_glyph(7,  31,  1,  2,  4,  8,  8,  8)   -- 7
    set_glyph(8,  14, 17, 17, 14, 17, 17, 14)   -- 8
    set_glyph(9,  14, 17, 17, 15,  1,  2, 12)   -- 9
    set_glyph(10, 14, 17, 17, 31, 17, 17, 17)   -- A
    set_glyph(11, 30, 17, 17, 30, 17, 17, 30)   -- B
    set_glyph(12, 14, 17, 16, 16, 16, 17, 14)   -- C
    set_glyph(13, 28, 18, 17, 17, 17, 18, 28)   -- D
    set_glyph(14, 31, 16, 16, 30, 16, 16, 31)   -- E
    set_glyph(15, 31, 16, 16, 30, 16, 16, 16)   -- F
    set_glyph(16, 14, 17, 16, 23, 17, 17, 15)   -- G
    set_glyph(17, 17, 17, 17, 31, 17, 17, 17)   -- H
    set_glyph(18, 14,  4,  4,  4,  4,  4, 14)   -- I
    set_glyph(19,  7,  2,  2,  2,  2, 18, 12)   -- J
    set_glyph(20, 17, 18, 20, 24, 20, 18, 17)   -- K
    set_glyph(21, 16, 16, 16, 16, 16, 16, 31)   -- L
    set_glyph(22, 17, 27, 21, 21, 17, 17, 17)   -- M
    set_glyph(23, 17, 17, 25, 21, 19, 17, 17)   -- N
    set_glyph(24, 14, 17, 17, 17, 17, 17, 14)   -- O
    set_glyph(25, 30, 17, 17, 30, 16, 16, 16)   -- P
    set_glyph(26, 14, 17, 17, 17, 21, 18, 13)   -- Q
    set_glyph(27, 30, 17, 17, 30, 20, 18, 17)   -- R
    set_glyph(28, 15, 16, 16, 14,  1,  1, 30)   -- S
    set_glyph(29, 31,  4,  4,  4,  4,  4,  4)   -- T
    set_glyph(30, 17, 17, 17, 17, 17, 17, 14)   -- U
    set_glyph(31, 17, 17, 17, 17, 17, 10,  4)   -- V
    set_glyph(32, 17, 17, 17, 21, 21, 27, 17)   -- W
    set_glyph(33, 17, 17, 10,  4, 10, 17, 17)   -- X
    set_glyph(34, 17, 17, 10,  4,  4,  4,  4)   -- Y
    set_glyph(35, 31,  1,  2,  4,  8, 16, 31)   -- Z
    set_glyph(36,  0,  0,  0,  0,  0,  0,  0)   -- space
    set_glyph(37,  0,  4,  4,  0,  4,  4,  0)   -- :
    set_glyph(38,  0,  0,  0, 14,  0,  0,  0)   -- -
    set_glyph(39,  0,  0,  0,  0,  0,  0,  4)   -- .
    set_glyph(40,  4,  4,  4,  4,  4,  0,  4)   -- !
    set_glyph(41,  1,  1,  2,  4,  8, 16, 16)   -- /
}

fn char_index(c: i32) -> i32 {
    if c >= 48 and c <= 57 { return c - 48 }
    if c >= 65 and c <= 90 { return c - 65 + 10 }
    if c >= 97 and c <= 122 { return c - 97 + 10 }
    if c == 58 { return 37 }
    if c == 45 { return 38 }
    if c == 46 { return 39 }
    if c == 33 { return 40 }
    if c == 47 { return 41 }
    return 36
}

-- Assumes fill mode + fill color are already set by the caller.
fn draw_glyph(gi: i32, x: i32, y: i32, scale: i32) {
    if gi < 0 or gi >= NUM_GLYPHS { return }
    for row in 0..GLYPH_H {
        let bits: i32 = font[gi * 7 + row] as i32
        for col in 0..GLYPH_W {
            if (bits >> (GLYPH_W - 1 - col)) & 1 == 1 {
                let px: i32 = x + col * scale
                let py: i32 = y + row * scale
                rdpq.fill_rectangle(px, py, px + scale, py + scale)
            }
        }
    }
}

fn text_width(s: *c_char, scale: i32) -> i32 {
    let n: i32 = 0
    loop {
        if s[n] as i32 == 0 { break }
        n += 1
    }
    return n * GLYPH_ADV * scale
}

fn draw_text(s: *c_char, x: i32, y: i32, scale: i32, col: u32) {
    rdpq.set_mode_fill(col)
    let i: i32 = 0
    let step: i32 = GLYPH_ADV * scale
    loop {
        let c: i32 = s[i] as i32
        if c == 0 { break }
        draw_glyph(char_index(c), x + i * step, y, scale)
        i += 1
    }
}

fn draw_text_centered(s: *c_char, cx: i32, y: i32, scale: i32, col: u32) {
    draw_text(s, cx - text_width(s, scale) / 2, y, scale, col)
}

fn digit_count(n: i32) -> i32 {
    let d: i32 = 1
    let t: i32 = n
    loop {
        if t < 10 { break }
        t = t / 10
        d += 1
    }
    return d
}

fn draw_number(n: i32, x: i32, y: i32, scale: i32, col: u32) {
    let v: i32 = n
    if v < 0 { v = 0 }
    let digits: i32 = digit_count(v)
    rdpq.set_mode_fill(col)
    let step: i32 = GLYPH_ADV * scale
    let i: i32 = digits - 1
    loop {
        if i < 0 { break }
        draw_glyph(v % 10, x + i * step, y, scale)
        v = v / 10
        i -= 1
    }
}

fn number_width(n: i32, scale: i32) -> i32 {
    return digit_count(n) * GLYPH_ADV * scale
}

-- ============================================================
-- 2D primitive shared by the HUD overlay
-- ============================================================
fn draw_bar(x: i32, y: i32, w: i32, h: i32, pct: f32, fg: u32, bg: u32) {
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(x, y, x + w, y + h)
    let fw: i32 = (w as f32 * math.clamp_f(pct, 0.0, 1.0)) as i32
    if fw > 0 {
        rdpq.set_mode_fill(fg)
        rdpq.fill_rectangle(x, y, x + fw, y + h)
    }
}

-- ============================================================
-- Role palette (shared by the HUD and the title screen)
-- ============================================================
fn role_color(r: Role) -> u32 {
    match r {
        .tank   => { return 0x4C7CE0FF }
        .healer => { return 0x3ED27AFF }
        .melee  => { return 0xE04C4CFF }
        .ranged => { return 0xE0BC38FF }
    }
    return 0xFFFFFFFF
}

fn role_light(r: Role) -> u32 {
    match r {
        .tank   => { return 0x86AEF4FF }
        .healer => { return 0x84E8AEFF }
        .melee  => { return 0xF48E8EFF }
        .ranged => { return 0xF4DC8AFF }
    }
    return 0xFFFFFFFF
}

-- ============================================================
-- 3D state
--
-- The level is one baked mesh; units are separate models drawn with a
-- per-instance matrix. All models are generated by tools/gen_dungeon_models.py
-- and converted .glb -> .t3dm by the build.
-- ============================================================
static vp: T3DViewport = undefined

static mdl_chunk: [*T3DModel; 9] = undefined   -- level, 3x3 chunks
static depth_buf: surface_t = undefined
static mdl_hero:  [*T3DModel; 4] = undefined   -- indexed by role_index()
static mdl_enemy: [*T3DModel; 9] = undefined   -- indexed by enemy_index()

-- One matrix per potentially-visible unit (4 heroes + 24 enemies).
static unit_fp: [*T3DMat4FP; 28] = undefined

-- Smoothed camera focus point, in world space.
static cam_tx: f32 = 0.0
static cam_tz: f32 = 0.0

fn role_index(r: Role) -> i32 {
    match r {
        .tank   => { return 0 }
        .healer => { return 1 }
        .melee  => { return 2 }
        .ranged => { return 3 }
    }
    return 0
}

fn enemy_index(k: EnemyKind) -> i32 {
    match k {
        .slime    => { return 0 }
        .goblin   => { return 1 }
        .skeleton => { return 2 }
        .bat      => { return 3 }
        .spider   => { return 4 }
        .zombie   => { return 5 }
        .orc      => { return 6 }
        .wraith   => { return 7 }
        .boss     => { return 8 }
    }
    return 0
}

-- ============================================================
-- Grid <-> world
-- ============================================================
fn world_x(gx: i32) -> f32 {
    return gx as f32 - WORLD_OX
}

fn world_z(gy: i32) -> f32 {
    return gy as f32 - WORLD_OZ
}

-- ============================================================
-- Camera: frames the living party, eased so it glides between turns
-- ============================================================
fn update_camera(dt: f32) {
    let sx: f32 = 0.0
    let sz: f32 = 0.0
    let n: i32 = 0
    for i in 0..MAX_HEROES {
        if heroes[i].alive {
            sx = sx + world_x(heroes[i].gx)
            sz = sz + world_z(heroes[i].gy)
            n += 1
        }
    }
    if n > 0 {
        sx = sx / n as f32
        sz = sz / n as f32
    }

    -- keep the focus inside the map so the view never drifts off the level
    sx = math.clamp_f(sx, -CAM_CLAMP_X, CAM_CLAMP_X)
    sz = math.clamp_f(sz, -CAM_CLAMP_Z, CAM_CLAMP_Z)

    let t: f32 = math.clamp_f(CAM_SMOOTH * dt, 0.0, 1.0)
    cam_tx = math.lerp_f(cam_tx, sx, t)
    cam_tz = math.lerp_f(cam_tz, sz, t)

    let eye: T3DVec3 = undefined
    eye.x = cam_tx
    eye.y = CAM_H
    eye.z = cam_tz + CAM_BACK

    let tgt: T3DVec3 = undefined
    tgt.x = cam_tx
    tgt.y = 0.0
    tgt.z = cam_tz

    let up: T3DVec3 = undefined
    up.x = 0.0
    up.y = 1.0
    up.z = 0.0

    t3d.look_at(&vp, &eye, &tgt, &up)
}

fn snap_camera() {
    let sx: f32 = 0.0
    let sz: f32 = 0.0
    let n: i32 = 0
    for i in 0..MAX_HEROES {
        if heroes[i].alive {
            sx = sx + world_x(heroes[i].gx)
            sz = sz + world_z(heroes[i].gy)
            n += 1
        }
    }
    if n > 0 {
        cam_tx = math.clamp_f(sx / n as f32, -CAM_CLAMP_X, CAM_CLAMP_X)
        cam_tz = math.clamp_f(sz / n as f32, -CAM_CLAMP_Z, CAM_CLAMP_Z)
    }
}

-- ============================================================
-- 3D draw
-- ============================================================
fn draw_model_at(model: *T3DModel, fp: *T3DMat4FP, wx: f32, wz: f32,
                 rot: f32, scale: f32) {
    let sc: [3]f32 = undefined
    sc[0] = scale
    sc[1] = scale
    sc[2] = scale

    let eu: [3]f32 = undefined
    eu[0] = 0.0
    eu[1] = rot
    eu[2] = 0.0

    let tr: [3]f32 = undefined
    tr[0] = wx
    tr[1] = 0.0
    tr[2] = wz

    t3d_mat4fp_from_srt_euler(fp, &sc[0], &eu[0], &tr[0])
    t3d_matrix_push(fp)
    t3d.model_draw(model)
    t3d_matrix_pop(1)
}

-- World-space centre of a chunk, used for distance culling.
fn chunk_center_x(ci: i32) -> f32 {
    let cx: i32 = ci % CHUNK_COLS
    return (cx * CHUNK_W) as f32 + (CHUNK_W as f32) * 0.5 - WORLD_OX
}

fn chunk_center_z(ci: i32) -> f32 {
    let cy: i32 = ci / CHUNK_COLS
    return (cy * CHUNK_H) as f32 + (CHUNK_H as f32) * 0.5 - WORLD_OZ
}

fn render_world(dt: f32) {
    update_camera(dt)

    t3d.frame_start()
    t3d.viewport_attach(&vp)

    -- torchlit gloom: everything past the next room fades to the void color
    t3d.fog_set_enabled(true)
    t3d.fog_set_range(17.0, 46.0)
    t3d.fog_set_color(0x0C0A10FF)

    -- key light warm from above-left, cool bounce from the opposite side
    t3d.light_set_ambient(90, 86, 108)
    t3d.light_set_directional(0, 255, 236, 200, -0.45, -0.78, -0.44)
    t3d.light_set_directional(1, 110, 120, 165, 0.50, 0.25, -0.75)
    t3d.light_set_count(2)

    -- Draw only the level chunks near the camera. The rest is beyond the fog
    -- anyway, and skipping it keeps the triangle count sane at 640x480.
    for ci in 0..NUM_CHUNKS {
        if mdl_chunk[ci] != none {
            let ddx: f32 = chunk_center_x(ci) - cam_tx
            let ddz: f32 = chunk_center_z(ci) - cam_tz
            if math.sqrt_f(ddx * ddx + ddz * ddz) <= CHUNK_DRAW_DIST {
                t3d.model_draw(mdl_chunk[ci])
            }
        }
    }

    -- Units share one matrix pool, handed out in draw order each frame.
    let slot: i32 = 0

    for i in 0..MAX_ENEMIES {
        if enemies[i].alive and slot < 28 {
            let mi: i32 = enemy_index(enemies[i].kind)
            if mdl_enemy[mi] != none and unit_fp[slot] != none {
                let esc: f32 = UNIT_SCALE
                if enemies[i].kind == EnemyKind.boss { esc = BOSS_SCALE }
                draw_model_at(mdl_enemy[mi], unit_fp[slot],
                              world_x(enemies[i].gx), world_z(enemies[i].gy),
                              enemies[i].facing, esc)
                slot += 1
            }
        }
    }

    for i in 0..MAX_HEROES {
        if heroes[i].alive and slot < 28 {
            let mi: i32 = role_index(heroes[i].role)
            if mdl_hero[mi] != none and unit_fp[slot] != none {
                draw_model_at(mdl_hero[mi], unit_fp[slot],
                              world_x(heroes[i].gx), world_z(heroes[i].gy),
                              heroes[i].facing, UNIT_SCALE)
                slot += 1
            }
        }
    }
}

-- ============================================================
-- HUD
-- ============================================================
fn role_name(r: Role) -> *c_char {
    match r {
        .tank   => { return "TANK" }
        .healer => { return "HEAL" }
        .melee  => { return "MELEE" }
        .ranged => { return "RANGED" }
    }
    return "----"
}

fn draw_hero_panel(slot: i32) {
    let px: i32 = 8 + slot * 156
    let py: i32 = HUD_Y
    let h: *Hero = &heroes[slot]
    let is_turn: bool = phase == Phase.hero_turn and active_hero == slot

    let bg: u32 = 0x16141CFF
    if is_turn { bg = 0x2E2C3EFF }
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(px, py, px + 148, py + 72)

    -- role swatch, greyed out when downed
    let swatch: u32 = role_color(h.role)
    if not h.alive { swatch = 0x3A3A3AFF }
    rdpq.set_mode_fill(swatch)
    rdpq.fill_rectangle(px + 6, py + 8, px + 32, py + 34)
    draw_number(slot + 1, px + 14, py + 14, 2, 0x101018FF)

    let name_col: u32 = 0xF2ECDCFF
    if not h.alive { name_col = 0x6A6A6AFF }
    draw_text(role_name(h.role), px + 40, py + 10, 2, name_col)

    if h.alive {
        let pct: f32 = h.hp as f32 / h.hp_max as f32
        let hp_col: u32 = 0x50E060FF
        if pct <= 0.5 { hp_col = 0xE0C040FF }
        if pct <= 0.25 { hp_col = 0xE04838FF }
        draw_bar(px + 8, py + 40, 132, 10, pct, hp_col, 0x201818FF)

        draw_number(h.hp, px + 8, py + 54, 2, 0xF2ECDCFF)
        let hx: i32 = px + 8 + number_width(h.hp, 2)
        draw_text("/", hx, py + 54, 2, 0x8A8A94FF)
        draw_number(h.hp_max, hx + 12, py + 54, 2, 0x8A8A94FF)
    } else {
        draw_text("DOWN", px + 8, py + 50, 2, 0xE04838FF)
    }

    -- ability cooldown pips: lit = ready
    let cd_max: i32 = role_ability_cd(h.role)
    let px2: i32 = px + 148 - 10 - cd_max * 14
    for i in 0..cd_max {
        let pip: u32 = 0x33333CFF
        if i >= h.ability_cd and h.alive { pip = 0xE8C848FF }
        rdpq.set_mode_fill(pip)
        rdpq.fill_rectangle(px2, py + 54, px2 + 11, py + 66)
        px2 += 14
    }

    if is_turn {
        rdpq.set_mode_fill(0xFFF0A0FF)
        rdpq.fill_rectangle(px, py - 5, px + 148, py)
    }
}

fn draw_top_bar() {
    if phase == Phase.hero_turn {
        let h: *Hero = &heroes[active_hero]
        let name: *c_char = role_name(h.role)
        let w: i32 = text_width(name, 3) + GLYPH_ADV * 3 * 5
        let sx: i32 = SCREEN_W / 2 - w / 2
        draw_text(name, sx, 12, 3, role_light(h.role))
        draw_text(" TURN", sx + text_width(name, 3), 12, 3, 0xF2ECDCFF)

        draw_text("MOVE", SCREEN_W - 150, 14, 2, 0x8A8A94FF)
        draw_number(h.move_left, SCREEN_W - 90, 14, 2, 0xF2ECDCFF)
    } elif phase == Phase.enemy_turn {
        draw_text_centered("ENEMY TURN", SCREEN_W / 2, 12, 3, 0xE07050FF)
    }

    draw_text("FOES", 12, 14, 2, 0x8A8A94FF)
    draw_number(enemies_alive, 72, 14, 2, 0xE05848FF)

    draw_text("RND", SCREEN_W - 150, 40, 2, 0x8A8A94FF)
    draw_number(round_num, SCREEN_W - 90, 40, 2, 0xF2ECDCFF)
}

fn draw_hud() {
    draw_top_bar()
    for i in 0..MAX_HEROES {
        draw_hero_panel(i)
    }
}

fn draw_scene(dt: f32) {
    let fb = display.get()
    rdpq.attach_clear(fb, &depth_buf)

    -- 3D pass
    render_world(dt)

    -- 2D HUD overlay on top of the rendered scene
    rdpq.sync_pipe()
    draw_hud()

    rdpq.detach_show()
}

-- ============================================================
-- Title / victory / defeat screens
-- ============================================================
fn any_start_pressed() -> bool {
    controller.poll()
    for i in 0..MAX_HEROES {
        let pad = controller.read(i)
        if pad.pressed.start { return true }
    }
    return false
}

fn draw_role_card(x: i32, y: i32, r: Role, label: *c_char, sub: *c_char) {
    rdpq.set_mode_fill(0x1A1822FF)
    rdpq.fill_rectangle(x, y, x + 140, y + 118)
    rdpq.set_mode_fill(role_color(r))
    rdpq.fill_rectangle(x + 5, y + 5, x + 135, y + 58)

    -- miniature of the in-world figure, centred on the swatch
    let cx: i32 = x + 70
    rdpq.set_mode_fill(role_light(r))
    rdpq.fill_rectangle(cx - 9, y + 18, cx + 9, y + 50)
    rdpq.fill_rectangle(cx - 7, y + 10, cx + 7, y + 20)

    draw_text_centered(label, x + 70, y + 68, 2, 0xF2ECDCFF)
    draw_text_centered(sub,   x + 70, y + 92, 2, 0x8A8A94FF)
}

fn draw_title() {
    let fb = display.get()
    rdpq.attach_clear(fb, &depth_buf)

    rdpq.set_mode_fill(0x0C0A10FF)
    rdpq.fill_rectangle(0, 0, SCREEN_W, SCREEN_H)

    -- title plate
    rdpq.set_mode_fill(0x1A1822FF)
    rdpq.fill_rectangle(60, 28, SCREEN_W - 60, 132)
    rdpq.set_mode_fill(0xE0BC38FF)
    rdpq.fill_rectangle(60, 28, SCREEN_W - 60, 34)
    rdpq.fill_rectangle(60, 126, SCREEN_W - 60, 132)

    draw_text_centered("DUNGEON", SCREEN_W / 2, 46, 5, 0xF2ECDCFF)
    draw_text_centered("QUARTET", SCREEN_W / 2, 88, 5, 0xE0BC38FF)

    draw_text_centered("4 PLAYER TURN BASED CRAWL", SCREEN_W / 2, 148, 2, 0x8A8A94FF)

    draw_role_card(16,  186, Role.tank,   "TANK",   "P1 GUARD")
    draw_role_card(168, 186, Role.melee,  "MELEE",  "P2 BLADE")
    draw_role_card(320, 186, Role.healer, "HEAL",   "P3 MEND")
    draw_role_card(472, 186, Role.ranged, "RANGED", "P4 BOW")

    draw_text_centered("DPAD MOVE    A ACT    B ABILITY", SCREEN_W / 2, 330, 2, 0x8A8A94FF)
    draw_text_centered("START ENDS YOUR TURN", SCREEN_W / 2, 358, 2, 0x8A8A94FF)

    if (frame_counter / 20) % 2 == 0 {
        draw_text_centered("PRESS START", SCREEN_W / 2, 408, 4, 0xFFF0A0FF)
    }

    rdpq.detach_show()
}

fn draw_end_screen(win: bool) {
    let fb = display.get()
    rdpq.attach_clear(fb, &depth_buf)

    let bg: u32 = 0x1A1012FF
    if win { bg = 0x121A10FF }
    rdpq.set_mode_fill(bg)
    rdpq.fill_rectangle(0, 0, SCREEN_W, SCREEN_H)

    let accent: u32 = 0xE04838FF
    if win { accent = 0xE8C848FF }

    rdpq.set_mode_fill(0x0E0C12FF)
    rdpq.fill_rectangle(90, 60, SCREEN_W - 90, 172)
    rdpq.set_mode_fill(accent)
    rdpq.fill_rectangle(90, 60, SCREEN_W - 90, 68)
    rdpq.fill_rectangle(90, 164, SCREEN_W - 90, 172)

    if win {
        draw_text_centered("VICTORY", SCREEN_W / 2, 90, 6, accent)
    } else {
        draw_text_centered("DEFEAT", SCREEN_W / 2, 90, 6, accent)
    }

    -- party roster with final state
    let i: i32 = 0
    loop {
        if i >= MAX_HEROES { break }
        let ry: i32 = 206 + i * 44
        rdpq.set_mode_fill(0x16141CFF)
        rdpq.fill_rectangle(120, ry, SCREEN_W - 120, ry + 36)

        let sw: u32 = role_color(heroes[i].role)
        if not heroes[i].alive { sw = 0x3A3A3AFF }
        rdpq.set_mode_fill(sw)
        rdpq.fill_rectangle(128, ry + 6, 152, ry + 30)

        draw_text(role_name(heroes[i].role), 168, ry + 10, 2, 0xF2ECDCFF)

        if heroes[i].alive {
            draw_text("ALIVE", 360, ry + 10, 2, 0x50E060FF)
            draw_number(heroes[i].hp, 456, ry + 10, 2, 0xF2ECDCFF)
            let hx: i32 = 456 + number_width(heroes[i].hp, 2)
            draw_text("/", hx, ry + 10, 2, 0x8A8A94FF)
            draw_number(heroes[i].hp_max, hx + 12, ry + 10, 2, 0x8A8A94FF)
        } else {
            draw_text("DOWN", 360, ry + 10, 2, 0xE04838FF)
        }
        i += 1
    }

    draw_text("ROUNDS", 120, 400, 2, 0x8A8A94FF)
    draw_number(round_num, 216, 400, 2, 0xF2ECDCFF)

    if (frame_counter / 20) % 2 == 0 {
        draw_text("PRESS START", 380, 400, 2, 0xFFF0A0FF)
    }

    rdpq.detach_show()
}

-- ============================================================
-- Entry point
-- ============================================================
entry {
    -- 640x480, 16bpp, double-buffered, no gamma, bilinear resample
    display.init(1, 2, 2, 0, 1)
    rdpq.init()
    controller.init()
    timer.init()
    t3d.init()

    -- 3D needs a depth buffer; without one, occlusion falls back to draw order
    depth_buf = surface.alloc(FMT_RGBA16, SCREEN_W, SCREEN_H)

    -- 60-degree vertical FOV; far plane past the longest sightline in the map
    vp = t3d.viewport_create()
    t3d.viewport_set_projection(&vp, 60.0, 1.0, 60.0)

    mdl_chunk[0]  = t3d.model_load("rom:/models/dungeon_c0.t3dm")
    mdl_chunk[1]  = t3d.model_load("rom:/models/dungeon_c1.t3dm")
    mdl_chunk[2]  = t3d.model_load("rom:/models/dungeon_c2.t3dm")
    mdl_chunk[3]  = t3d.model_load("rom:/models/dungeon_c3.t3dm")
    mdl_chunk[4]  = t3d.model_load("rom:/models/dungeon_c4.t3dm")
    mdl_chunk[5]  = t3d.model_load("rom:/models/dungeon_c5.t3dm")
    mdl_chunk[6]  = t3d.model_load("rom:/models/dungeon_c6.t3dm")
    mdl_chunk[7]  = t3d.model_load("rom:/models/dungeon_c7.t3dm")
    mdl_chunk[8]  = t3d.model_load("rom:/models/dungeon_c8.t3dm")
    mdl_hero[0]   = t3d.model_load("rom:/models/hero_tank.t3dm")
    mdl_hero[1]   = t3d.model_load("rom:/models/hero_healer.t3dm")
    mdl_hero[2]   = t3d.model_load("rom:/models/hero_melee.t3dm")
    mdl_hero[3]   = t3d.model_load("rom:/models/hero_ranged.t3dm")
    mdl_enemy[0]  = t3d.model_load("rom:/models/enemy_slime.t3dm")
    mdl_enemy[1]  = t3d.model_load("rom:/models/enemy_goblin.t3dm")
    mdl_enemy[2]  = t3d.model_load("rom:/models/enemy_skeleton.t3dm")
    mdl_enemy[3]  = t3d.model_load("rom:/models/enemy_bat.t3dm")
    mdl_enemy[4]  = t3d.model_load("rom:/models/enemy_spider.t3dm")
    mdl_enemy[5]  = t3d.model_load("rom:/models/enemy_zombie.t3dm")
    mdl_enemy[6]  = t3d.model_load("rom:/models/enemy_orc.t3dm")
    mdl_enemy[7]  = t3d.model_load("rom:/models/enemy_wraith.t3dm")
    mdl_enemy[8]  = t3d.model_load("rom:/models/enemy_boss.t3dm")

    -- per-instance matrices (16-byte aligned, uncached for RSP DMA)
    let mi: i32 = 0
    loop {
        if mi >= 28 { break }
        unit_fp[mi] = Mat4Fp.create()
        mi += 1
    }

    init_font()
    phase = Phase.title

    loop {
        let dt: f32 = timer.delta()
        if dt > 0.05 { dt = 0.05 }
        frame_counter += 1

        match phase {
            .title => {
                if any_start_pressed() {
                    start_level()
                    snap_camera()
                }
                draw_title()
            }
            .hero_turn => {
                handle_hero_input(dt)
                draw_scene(dt)
            }
            .enemy_turn => {
                enemy_phase_timer -= dt
                if enemy_phase_timer <= 0.0 {
                    check_outcomes()
                    if phase == Phase.enemy_turn { begin_hero_phase() }
                }
                draw_scene(dt)
            }
            .victory => {
                if any_start_pressed() { phase = Phase.title }
                draw_end_screen(true)
            }
            .defeat => {
                if any_start_pressed() { phase = Phase.title }
                draw_end_screen(false)
            }
        }
    }
}
