# ── World system ──────────────────────────────────────────────────────────────

proc codegen::topdown::_world_block {} {
    return {-- ── World System ──────────────────────────────────────────────────────────────

fn draw_world() {
    -- Camera: center on player
    let cam_x: i32 = world.x * TILE_SZ - SCREEN_W / 2 + TILE_SZ / 2
    let cam_y: i32 = world.y * TILE_SZ - SCREEN_H / 2 + TILE_SZ / 2
    -- Clamp camera to map bounds
    let max_cx: i32 = MAP_W * TILE_SZ - SCREEN_W
    let max_cy: i32 = MAP_H * TILE_SZ - SCREEN_H
    if cam_x < 0 { cam_x = 0 }
    if cam_y < 0 { cam_y = 0 }
    if cam_x > max_cx { cam_x = max_cx }
    if cam_y > max_cy { cam_y = max_cy }

    -- Draw visible tiles
    let tx0: i32 = cam_x / TILE_SZ
    let ty0: i32 = cam_y / TILE_SZ
    let tx1: i32 = (cam_x + SCREEN_W) / TILE_SZ + 1
    let ty1: i32 = (cam_y + SCREEN_H) / TILE_SZ + 1
    for ty in ty0..(ty1+1) {
        for tx in tx0..(tx1+1) {
            let t: u8 = tile_at(tx, ty)
            let col: u32 = tile_color(t)
            let sx: i32 = tx * TILE_SZ - cam_x
            let sy: i32 = ty * TILE_SZ - cam_y
            fill_rect(sx, sy, TILE_SZ, TILE_SZ, col)
        }
    }

    -- Draw player (simple colored square with direction indicator)
    let px: i32 = world.x * TILE_SZ - cam_x
    let py: i32 = world.y * TILE_SZ - cam_y
    fill_rect(px+2, py+2, TILE_SZ-4, TILE_SZ-4, 0xE8D060FF)
    -- Direction pip
    let pip_col: u32 = 0x303030FF
    match world.dir {
        0 => fill_rect(px + TILE_SZ/2 - 1, py + TILE_SZ - 5, 3, 3, pip_col)  -- down
        1 => fill_rect(px + TILE_SZ/2 - 1, py + 2,           3, 3, pip_col)  -- up
        2 => fill_rect(px + 2,             py + TILE_SZ/2-1, 3, 3, pip_col)  -- left
        3 => fill_rect(px + TILE_SZ - 5,  py + TILE_SZ/2-1, 3, 3, pip_col)  -- right
    }
}

fn world_update(pad: joypad_buttons_t) {
    if world.move_cool > 0 {
        world.move_cool = world.move_cool - 1
        return
    }

    let dx: i32 = 0
    let dy: i32 = 0
    if pad.d_left  { dx = -1; world.dir = 2 }
    elif pad.d_right { dx = 1; world.dir = 3 }
    elif pad.d_up    { dy = -1; world.dir = 1 }
    elif pad.d_down  { dy = 1; world.dir = 0 }

    if dx == 0 and dy == 0 { return }

    let nx: i32 = world.x + dx
    let ny: i32 = world.y + dy
    let nt: u8 = tile_at(nx, ny)

    if not tile_solid(nt) {
        world.x = nx
        world.y = ny
        world.step = world.step + 1
        world.move_cool = 8

        -- Random encounter check on encounter tiles
        if tile_encounter(nt) {
            world.steps_til_encounter = world.steps_til_encounter - 1
            if world.steps_til_encounter <= 0 {
                world.steps_til_encounter = rand_range(10, 20)
                start_encounter()
            }
        }
    }
}

fn start_encounter() {
    -- Pick random enemy group: 1-3 enemies of a random type
    let etype: i32 = rand_range(0, NUM_ENEMIES)
    let n: i32 = rand_range(1, 4)
    if n > 4 { n = 4 }
    b_n_enemies = n
    for i in 0..4 {
        if i < n {
            b_enemies[i] = BattleEnemy {
                def_idx: etype,
                hp: ENEMIES[etype].max_hp,
                alive: true
            }
        } else {
            b_enemies[i].alive = false
        }
    }
    b_turn    = 0
    b_menu    = MENU_ATTACK
    b_target  = 0
    b_exp_gain  = 0
    b_gold_gain = 0
    b_anim    = 0
    b_actor_turn = 0
    phase     = PHASE_BATTLE
}
}
}

# ── Battle system ─────────────────────────────────────────────────────────────

proc codegen::topdown::_battle_block {} {
    return {-- ── Battle System ─────────────────────────────────────────────────────────────

fn first_alive_actor() -> i32 {
    for i in 0..PARTY_SIZE {
        if party[i].alive and party[i].hp > 0 { return i }
    }
    return -1
}

fn first_alive_enemy() -> i32 {
    for i in 0..b_n_enemies {
        if b_enemies[i].alive { return i }
    }
    return -1
}

fn party_all_dead() -> bool {
    for i in 0..PARTY_SIZE {
        if party[i].alive and party[i].hp > 0 { return false }
    }
    return true
}

fn enemies_all_dead() -> bool {
    for i in 0..b_n_enemies {
        if b_enemies[i].alive { return false }
    }
    return true
}

fn apply_item_effect(actor_idx: i32, item_idx: i32) {
    if item_idx < 0 or item_idx >= NUM_ITEMS { return }
    let it: *ItemDef = &ITEMS[item_idx]
    let a: *Actor    = &party[actor_idx]
    let base: *ActorBase = &ACTOR_BASE[a.base_idx]
    let max_hp_eff: i32 = base.max_hp + a.level * 5
    let max_mp_eff: i32 = base.max_mp + a.level * 2
    match it.effect {
        FX_HEAL_HP => a.hp = clamp(a.hp + it.power, 0, max_hp_eff)
        FX_HEAL_MP => a.mp = clamp(a.mp + it.power, 0, max_mp_eff)
        FX_REVIVE  => {
            if not a.alive {
                a.alive = true
                a.hp    = it.power
            }
        }
        _ => {}
    }
}

fn battle_do_attack(actor_idx: i32, enemy_idx: i32) {
    let a:   *Actor     = &party[actor_idx]
    let e:   *BattleEnemy = &b_enemies[enemy_idx]
    let edef: *EnemyDef  = &ENEMIES[e.def_idx]
    let dmg: i32 = calc_damage(a.atk, edef.def, 100)
    e.hp = e.hp - dmg
    if e.hp <= 0 {
        e.hp    = 0
        e.alive = false
        b_exp_gain  = b_exp_gain  + edef.exp
        b_gold_gain = b_gold_gain + edef.gold
        -- Item drop
        if edef.drop_item >= 0 and edef.drop_rate > 0 {
            if rand_range(0, 100) < edef.drop_rate {
                let drop_slot: i32 = edef.drop_item
                if drop_slot < INV_SIZE {
                    inventory[drop_slot] = inventory[drop_slot] + 1
                }
            }
        }
    }
    b_anim = BATTLE_ANIM_FRAMES
}

fn battle_do_skill(actor_idx: i32, skill_idx: i32, target: i32) {
    if skill_idx < 0 or skill_idx >= NUM_SKILLS { return }
    let sk: *SkillDef = &SKILLS[skill_idx]
    let a:  *Actor    = &party[actor_idx]
    if a.mp < sk.mp_cost { return }
    a.mp = a.mp - sk.mp_cost
    -- Apply to target(s)
    let power: i32 = sk.power
    match sk.target {
        0 => {
            -- one_enemy
            if target >= 0 and target < b_n_enemies and b_enemies[target].alive {
                let edef: *EnemyDef = &ENEMIES[b_enemies[target].def_idx]
                let mag_atk: i32 = a.mag * 2
                let dmg: i32 = calc_damage(mag_atk, edef.def / 2, power)
                b_enemies[target].hp = b_enemies[target].hp - dmg
                if b_enemies[target].hp <= 0 {
                    b_enemies[target].hp    = 0
                    b_enemies[target].alive = false
                    b_exp_gain  = b_exp_gain  + edef.exp
                    b_gold_gain = b_gold_gain + edef.gold
                }
            }
        }
        1 => {
            -- all_enemies
            for i in 0..b_n_enemies {
                if b_enemies[i].alive {
                    let edef: *EnemyDef = &ENEMIES[b_enemies[i].def_idx]
                    let mag_atk: i32 = a.mag * 2
                    let dmg: i32 = calc_damage(mag_atk, edef.def / 2, power)
                    b_enemies[i].hp = b_enemies[i].hp - dmg
                    if b_enemies[i].hp <= 0 {
                        b_enemies[i].hp    = 0
                        b_enemies[i].alive = false
                        b_exp_gain  = b_exp_gain  + edef.exp
                        b_gold_gain = b_gold_gain + edef.gold
                    }
                }
            }
        }
        2 => {
            -- one_ally: heal
            let ally: *Actor = &party[target % PARTY_SIZE]
            let base: *ActorBase = &ACTOR_BASE[ally.base_idx]
            let max_hp_e: i32 = base.max_hp + ally.level * 5
            ally.hp = clamp(ally.hp + power, 0, max_hp_e)
        }
        3 => {
            -- all_allies: heal all
            for i in 0..PARTY_SIZE {
                if party[i].alive {
                    let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
                    let max_hp_e: i32 = base.max_hp + party[i].level * 5
                    party[i].hp = clamp(party[i].hp + power, 0, max_hp_e)
                }
            }
        }
        4 => {
            -- self
            let base: *ActorBase = &ACTOR_BASE[a.base_idx]
            let max_hp_e: i32 = base.max_hp + a.level * 5
            a.hp = clamp(a.hp + power, 0, max_hp_e)
        }
        _ => {}
    }
    b_anim = BATTLE_ANIM_FRAMES
}

fn enemy_take_turn() {
    -- Find a living enemy
    let eidx: i32 = first_alive_enemy()
    if eidx < 0 { b_turn = 0; return }
    let e:    *BattleEnemy = &b_enemies[eidx]
    let edef: *EnemyDef    = &ENEMIES[e.def_idx]

    -- Find a living party target
    let aidx: i32 = first_alive_actor()
    if aidx < 0 { return }

    -- Check if enemy uses a skill
    let used_skill: bool = false
    if edef.n_skills > 0 and edef.max_mp > 0 {
        let sk_idx: i32 = edef.skills[rand_range(0, edef.n_skills)]
        if sk_idx >= 0 and sk_idx < NUM_SKILLS {
            let sk: *SkillDef = &SKILLS[sk_idx]
            -- Enemy uses skill against player party
            let mag: i32 = edef.mag
            let dmg: i32 = calc_damage(mag * 2, party[aidx].def / 2, sk.power)
            party[aidx].hp = party[aidx].hp - dmg
            if party[aidx].hp <= 0 {
                party[aidx].hp    = 0
                party[aidx].alive = false
            }
            used_skill = true
        }
    }

    if not used_skill {
        -- Basic attack
        let dmg: i32 = calc_damage(edef.atk, party[aidx].def, 100)
        party[aidx].hp = party[aidx].hp - dmg
        if party[aidx].hp <= 0 {
            party[aidx].hp    = 0
            party[aidx].alive = false
        }
    }
    b_turn = 0
    b_anim = BATTLE_ANIM_FRAMES / 2
}

fn battle_end_check() {
    if enemies_all_dead() {
        -- Distribute exp + gold
        gold = gold + b_gold_gain
        for i in 0..PARTY_SIZE {
            if party[i].alive {
                gain_exp(i, b_exp_gain)
            }
        }
        b_msg_timer = 90
        phase = PHASE_WORLD
        return
    }
    if party_all_dead() {
        phase = PHASE_GAMEOVER
    }
}

fn battle_update(pad: joypad_buttons_t) {
    if b_anim > 0 { b_anim = b_anim - 1; return }

    if b_turn == 2 {
        -- Enemy phase
        enemy_take_turn()
        battle_end_check()
        return
    }

    -- Player menu navigation
    if pad.d_up   { b_menu = (b_menu + MENU_RUN) % (MENU_RUN + 1) }
    if pad.d_down { b_menu = (b_menu + 1)        % (MENU_RUN + 1) }

    match b_menu {
        MENU_ATTACK => {
            -- Target selection with left/right
            if pad.d_left  { b_target = clamp(b_target - 1, 0, b_n_enemies - 1) }
            if pad.d_right { b_target = clamp(b_target + 1, 0, b_n_enemies - 1) }
            -- Find next alive target if current is dead
            if not b_enemies[b_target].alive {
                b_target = 0
                for i in 0..b_n_enemies {
                    if b_enemies[i].alive { b_target = i; break }
                }
            }
            if pad.a {
                let actor: i32 = first_alive_actor()
                if actor >= 0 {
                    battle_do_attack(actor, b_target)
                    b_turn = 2
                    battle_end_check()
                }
            }
        }
        MENU_SKILL => {
            if pad.d_left  { b_skill_sel = clamp(b_skill_sel - 1, 0, NUM_SKILLS - 1) }
            if pad.d_right { b_skill_sel = clamp(b_skill_sel + 1, 0, NUM_SKILLS - 1) }
            if pad.a {
                let actor: i32 = first_alive_actor()
                if actor >= 0 {
                    battle_do_skill(actor, b_skill_sel, b_target)
                    b_turn = 2
                    battle_end_check()
                }
            }
        }
        MENU_ITEM => {
            if pad.d_left  { b_item_sel = clamp(b_item_sel - 1, 0, INV_SIZE - 1) }
            if pad.d_right { b_item_sel = clamp(b_item_sel + 1, 0, INV_SIZE - 1) }
            if pad.a {
                if inventory[b_item_sel] > 0 {
                    let actor: i32 = first_alive_actor()
                    if actor >= 0 {
                        apply_item_effect(actor, b_item_sel)
                        inventory[b_item_sel] = inventory[b_item_sel] - 1
                        b_turn = 2
                        battle_end_check()
                    }
                }
            }
        }
        MENU_RUN => {
            if pad.a {
                let chance: i32 = FLEE_CHANCE + world.step % 20
                if rand_range(0, 100) < chance {
                    phase = PHASE_WORLD
                } else {
                    b_turn = 2
                }
            }
        }
        _ => {}
    }
}

fn draw_battle() {
    -- Sky gradient (simple fill)
    fill_rect(0, 0, SCREEN_W, 120, 0x0A1830FF)
    fill_rect(0, 120, SCREEN_W, 60, 0x183010FF)
    fill_rect(0, 180, SCREEN_W, SCREEN_H - 180, 0x0A0A1AFF)

    -- Draw enemies
    for i in 0..b_n_enemies {
        if b_enemies[i].alive {
            let ex: i32 = 60 + i * 60
            let ey: i32 = 80
            -- Body
            let ecol: u32 = 0x60A040FF
            if i == b_target and b_turn == 0 { ecol = 0x80C060FF }
            fill_rect(ex, ey, 28, 36, ecol)
            -- Eyes
            fill_rect(ex+6, ey+8, 4, 4, 0xFF4040FF)
            fill_rect(ex+18, ey+8, 4, 4, 0xFF4040FF)
            -- HP bar
            let edef: *EnemyDef = &ENEMIES[b_enemies[i].def_idx]
            draw_bar(ex, ey+38, 28, 4, b_enemies[i].hp, edef.max_hp, 0xCC2020FF)
        }
    }

    -- Draw party
    for i in 0..PARTY_SIZE {
        if party[i].alive {
            let px: i32 = 30 + i * 90
            let py: i32 = 135
            fill_rect(px, py, 22, 30, 0xD0A040FF)
            fill_rect(px+5, py+5, 5, 5, 0x303030FF)
            fill_rect(px+12, py+5, 5, 5, 0x303030FF)
        }
    }

    -- Battle UI panel
    draw_panel(0, 178, SCREEN_W, SCREEN_H - 178)

    -- Enemy HP text
    for i in 0..b_n_enemies {
        if b_enemies[i].alive {
            let edef: *EnemyDef = &ENEMIES[b_enemies[i].def_idx]
            draw_int(4 + i * 80, 183, b_enemies[i].hp, 0xFF6060FF)
        }
    }

    -- Party bars
    for i in 0..PARTY_SIZE {
        if party[i].alive {
            let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
            let max_hp_e: i32 = base.max_hp + party[i].level * 5
            let max_mp_e: i32 = base.max_mp + party[i].level * 2
            let bx: i32 = 4 + i * 100
            draw_bar(bx, 192, 90, 5, party[i].hp, max_hp_e, 0x20CC20FF)
            draw_bar(bx, 200, 90, 5, party[i].mp, max_mp_e, 0x2060FFFF)
            draw_int(bx, 208, party[i].level, 0xCCCC40FF)
        }
    }

    -- Command menu
    let menu_labels: [4][7]u8 = [
        [65,84,84,65,67,75,0],  -- ATTACK
        [83,75,73,76,76,0,0],   -- SKILL
        [73,84,69,77,0,0,0],    -- ITEM
        [82,85,78,0,0,0,0],     -- RUN
    ]
    for i in 0..4 {
        let mx: i32 = 200 + (i % 2) * 58
        let my: i32 = 182 + (i / 2) * 14
        let tcol: u32 = 0x8888CCFF
        if i == b_menu { tcol = 0xFFFF60FF; fill_rect(mx-2, my-1, 56, 12, 0x1A1A3AFF) }
        draw_str(mx, my, menu_labels[i][0..7], tcol)
    }
}
}
}

# ── Crafting system ───────────────────────────────────────────────────────────

proc codegen::topdown::_craft_block {} {
    return {-- ── Crafting System ────────────────────────────────────────────────────────────

fn can_craft(recipe_idx: i32) -> bool {
    if recipe_idx < 0 or recipe_idx >= NUM_RECIPES { return false }
    let r: *RecipeDef = &RECIPES[recipe_idx]
    for i in 0..r.n_inputs {
        let item_id: i32 = r.in_item[i]
        let qty_needed: i32 = r.in_qty[i]
        if item_id < 0 or item_id >= INV_SIZE { return false }
        if inventory[item_id] < qty_needed { return false }
    }
    return true
}

fn do_craft(recipe_idx: i32) {
    if not can_craft(recipe_idx) { return }
    let r: *RecipeDef = &RECIPES[recipe_idx]
    -- Consume ingredients
    for i in 0..r.n_inputs {
        let item_id: i32 = r.in_item[i]
        inventory[item_id] = inventory[item_id] - r.in_qty[i]
    }
    -- Produce output
    let out_id: i32 = r.out_item
    if out_id >= 0 and out_id < INV_SIZE {
        inventory[out_id] = inventory[out_id] + r.out_qty
    }
    craft_timer = 60
}

fn craft_update(pad: joypad_buttons_t) {
    if craft_timer > 0 { craft_timer = craft_timer - 1 }
    if pad.d_up   { craft_sel = clamp(craft_sel - 1, 0, NUM_RECIPES - 1) }
    if pad.d_down { craft_sel = clamp(craft_sel + 1, 0, NUM_RECIPES - 1) }
    if pad.a      { do_craft(craft_sel) }
    if pad.b      { phase = PHASE_MENU }
}

fn draw_crafting() {
    draw_panel(0, 0, SCREEN_W, SCREEN_H)
    -- Title
    let title_str: [9]u8 = [67,82,65,70,84,73,78,71,0]  -- CRAFTING
    draw_str(8, 8, title_str[0..9], 0xFFDD60FF)

    for i in 0..NUM_RECIPES {
        let r: *RecipeDef = &RECIPES[i]
        let ry: i32 = 24 + i * 20
        let selcol: u32 = 0x6688BBFF
        if i == craft_sel { selcol = 0xFFFF80FF; fill_rect(4, ry-2, SCREEN_W-8, 18, 0x1A2040FF) }
        -- Ingredients
        let ok: bool = can_craft(i)
        let ic: u32 = 0xCC4444FF
        if ok { ic = 0x44CC44FF }
        fill_rect(SCREEN_W - 10, ry + 2, 6, 6, ic)
        -- Output item id
        draw_int(8, ry, r.out_item, selcol)
        draw_int(30, ry, r.out_qty, selcol)
        -- n inputs
        draw_int(60, ry, r.n_inputs, 0x8888CCFF)
    }

    -- Gold
    let gold_lbl: [5]u8 = [71,79,76,68,0]  -- GOLD
    draw_str(8, SCREEN_H - 16, gold_lbl[0..5], 0xFFDD40FF)
    draw_int(40, SCREEN_H - 16, gold, 0xFFDD40FF)
}
}
}

# ── UI block ──────────────────────────────────────────────────────────────────

proc codegen::topdown::_ui_block {} {
    return {-- ── UI ────────────────────────────────────────────────────────────────────────

fn draw_hud() {
    -- Mini HP bars bottom-left
    for i in 0..PARTY_SIZE {
        if party[i].alive {
            let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
            let max_hp_hud: i32 = base.max_hp + party[i].level * 5
            draw_bar(2, SCREEN_H - 12 - i * 10, 50, 5,
                     party[i].hp, max_hp_hud, 0x20DD20FF)
        }
    }
    -- Gold top-right
    draw_int(SCREEN_W - 36, 2, gold, 0xFFDD40FF)
}

fn draw_title() {
    fill_rect(0, 0, SCREEN_W, SCREEN_H, 0x05081AFF)
    -- Stars
    let star_xs: [12]i32 = [20,80,140,200,260,50,120,180,240,30,100,220]
    let star_ys: [12]i32 = [10,25,15,30,8,50,40,55,20,70,60,45]
    for i in 0..12 {
        let blink: i32 = (frame / 20 + i) % 4
        if blink < 3 {
            fill_rect(star_xs[i], star_ys[i], 2, 2, 0xCCCCFFFF)
        }
    }
    -- Title text (drawn as colored rectangle + label)
    fill_rect(40, 80, SCREEN_W - 80, 30, 0x1A1040FF)
    fill_rect(40, 80, SCREEN_W - 80, 2, 0x8060FFFF)
    fill_rect(40, 108, SCREEN_W - 80, 2, 0x8060FFFF)

    -- Menu items: NEW GAME, CONTINUE
    let sel_items: [2]bool = [title_sel == 0, title_sel == 1]
    let ny: [2]i32 = [140, 160]
    for i in 0..2 {
        let tc: u32 = 0x6688CCFF
        if sel_items[i] { tc = 0xFFFF60FF; fill_rect(60, ny[i]-2, SCREEN_W-120, 14, 0x1A1A3AFF) }
        if i == 0 {
            let ng: [9]u8 = [78,69,87,32,71,65,77,69,0]  -- NEW GAME
            draw_str(SCREEN_W/2 - 30, ny[i], ng[0..9], tc)
        } else {
            let ct: [9]u8 = [67,79,78,84,73,78,85,69,0]  -- CONTINUE
            draw_str(SCREEN_W/2 - 30, ny[i], ct[0..9], tc)
        }
    }
}

fn draw_gameover() {
    fill_rect(0, 0, SCREEN_W, SCREEN_H, 0x100808FF)
    let go: [10]u8 = [71,65,77,69,32,79,86,69,82,0]  -- GAME OVER
    draw_str(SCREEN_W/2 - 20, SCREEN_H/2 - 6, go[0..10], 0xFF4040FF)
}

fn title_update(pad: joypad_buttons_t) {
    if pad.d_up   { title_sel = (title_sel + 1) % 2 }
    if pad.d_down { title_sel = (title_sel + 1) % 2 }
    if pad.a {
        -- init party stats from base table
        for i in 0..PARTY_SIZE {
            if party[i].alive {
                let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
                party[i].atk = base.atk
                party[i].def = base.def
                party[i].mag = base.mag
                party[i].spd = base.spd
            }
        }
        phase = PHASE_WORLD
    }
}

fn menu_update(pad: joypad_buttons_t) {
    if pad.a { phase = PHASE_CRAFT }
    if pad.b { phase = PHASE_WORLD }
}

fn draw_menu() {
    draw_panel(40, 40, SCREEN_W - 80, SCREEN_H - 80)
    -- Basic party status
    for i in 0..PARTY_SIZE {
        if party[i].alive {
            let ay: i32 = 55 + i * 40
            let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
            let max_hp_m: i32 = base.max_hp + party[i].level * 5
            let max_mp_m: i32 = base.max_mp + party[i].level * 2
            draw_bar(50, ay, 100, 7, party[i].hp, max_hp_m, 0x20CC20FF)
            draw_bar(50, ay+10, 100, 7, party[i].mp, max_mp_m, 0x2060FFFF)
            draw_int(160, ay, party[i].level, 0xFFFF60FF)
            draw_int(160, ay+10, party[i].exp, 0xCC8840FF)
        }
    }
    -- Gold
    draw_int(50, SCREEN_H - 55, gold, 0xFFDD40FF)
}
}
}

# ── Entry block ───────────────────────────────────────────────────────────────

proc codegen::topdown::_entry_block {doc} {
    return {-- ── Entry point ────────────────────────────────────────────────────────────────
entry {
    display.init(RESOLUTION_320x240, DEPTH_16_BPP, 2, GAMMA_NONE, FILTERS_RESAMPLE)
    controller.init()
    rdpq.init()
    rdpq.debug_start()

    -- Seed RNG with a simple value
    rng_state = 0xDEAD1234

    -- Init party stats from base table
    for i in 0..PARTY_SIZE {
        if party[i].alive {
            let base: *ActorBase = &ACTOR_BASE[party[i].base_idx]
            party[i].atk = base.atk
            party[i].def = base.def
            party[i].mag = base.mag
            party[i].spd = base.spd
        }
    }

    loop {
        controller.poll()
        let pad: joypad_buttons_t = controller.read(0).held

        let surface: *surface_t = display.get()
        rdpq.attach(surface, none)
        rdpq.clear(0x050810FF)

        match phase {
            PHASE_TITLE => {
                title_update(pad)
                draw_title()
            }
            PHASE_WORLD => {
                world_update(pad)
                draw_world()
                draw_hud()
                -- Open menu with Start
                if pad.start { phase = PHASE_MENU }
            }
            PHASE_BATTLE => {
                battle_update(pad)
                draw_battle()
            }
            PHASE_MENU => {
                menu_update(pad)
                draw_menu()
            }
            PHASE_CRAFT => {
                craft_update(pad)
                draw_crafting()
            }
            PHASE_GAMEOVER => {
                draw_gameover()
                if pad.start { phase = PHASE_TITLE }
            }
            _ => { phase = PHASE_TITLE }
        }

        rdpq.detach_show()
        frame = frame + 1
    }
}
}
}
