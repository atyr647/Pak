    fill_rect(x,     y,     1, h, 0x444444FF)
    fill_rect(x+w-1, y,     1, h, 0x444444FF)
}

fn draw_panel(x: i32, y: i32, w: i32, h: i32) {
    fill_rect(x, y, w, h, 0x0A0A1AFF)
    fill_rect(x,     y,     w, 1, 0x4466AAFF)
    fill_rect(x,     y+h-1, w, 1, 0x4466AAFF)
    fill_rect(x,     y,     1, h, 0x4466AAFF)
