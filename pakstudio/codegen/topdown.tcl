fn draw_char(x: i32, y: i32, c: u8, col: u32) {
    let idx: i32 = 0
    if c >= 65 and c <= 90 { idx = (c as i32 - 65) * 5 }
    elif c >= 97 and c <= 122 { idx = (c as i32 - 97) * 5 }
    elif c >= 48 and c <= 57  { idx = (c as i32 - 48 + 26) * 5 }
    else { return }
    for row in 0..5 {
        let bits: u8 = FONT[idx + row]
        for bit in 0..4 {
            if (bits >> (3 - bit)) & 1 == 1 {
                rdpq.set_prim_color(col)
                rdpq.fill_rectangle(
                    (x + bit) as f32, (y + row) as f32,
                    (x + bit + 1) as f32, (y + row + 1) as f32)
            }
        }
    }
}

fn draw_str(x: i32, y: i32, s: []u8, col: u32) {
    let cx: i32 = x
    for i in 0..s.len {
        let c: u8 = s[i]
        if c == 0 { break }
        if c == 32 { cx = cx + FONT_W + 1; continue }
        draw_char(cx, y, c, col)
        cx = cx + FONT_W + 1
    }
}

fn draw_int(x: i32, y: i32, v: i32, col: u32) {
    let buf: [8]u8 = [0; 8]
    let n: i32 = v
    if n < 0 { n = 0 }
    let i: i32 = 7
    if n == 0 {
        buf[7] = 48
    } else {
        while n > 0 {
            buf[i] = (48 + n % 10) as u8
            n = n / 10
            i = i - 1
        }
        i = i + 1
    }
    draw_str(x, y, buf[i..8], col)
}
}
}

# ── Math helpers ──────────────────────────────────────────────────────────────

proc codegen::topdown::_math_block {} {
    return {-- ── Math helpers ──────────────────────────────────────────────────────────────

-- Fast pseudo-random (xorshift32)
static rng_state: u32 = 12345

fn rand_next() -> u32 {
    rng_state = rng_state ^ (rng_state << 13)
    rng_state = rng_state ^ (rng_state >> 17)
    rng_state = rng_state ^ (rng_state << 5)
    return rng_state
}

fn rand_range(lo: i32, hi: i32) -> i32 {
    if hi <= lo { return lo }
    return lo + (rand_next() as i32 % (hi - lo))
}

fn clamp(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

-- EXP threshold for the next level (100 * level^1.5 approximated)
fn exp_for_level(lv: i32) -> i32 {
    -- approx lv * lv * 10 + lv * EXP_BASE
    return lv * lv * 10 + lv * EXP_BASE
}

-- Damage formula: (atk * power / 100) - (def / 2) + small random variance
fn calc_damage(atk: i32, def: i32, power: i32) -> i32 {
    let base: i32 = atk * power / 100
    let reduction: i32 = def / 2
    let raw: i32 = base - reduction
    if raw < 1 { raw = 1 }
    -- ±20% variance
    let spread: i32 = raw / 5
    if spread < 1 { spread = 1 }
    raw = raw + rand_range(-spread, spread)
    return clamp(raw, 1, 9999)
}

-- Apply stat growth on level-up (grow values are *10, applied /10)
fn level_up_stats(idx: i32) {
    let base: *ActorBase = &ACTOR_BASE[party[idx].base_idx]
    party[idx].level = party[idx].level + 1
    party[idx].atk = party[idx].atk + base.at_grow / 10 + 1
    party[idx].def = party[idx].def + base.df_grow / 10 + 1
    party[idx].mag = party[idx].mag + base.mg_grow / 10 + 1
    party[idx].spd = party[idx].spd + base.sp_grow / 10 + 1
    -- also increase current HP/MP caps
    let hp_gain: i32 = base.hp_grow / 10 + 2
    let mp_gain: i32 = base.mp_grow / 10 + 1
    let base_ptr: *ActorBase = &ACTOR_BASE[party[idx].base_idx]
    -- heal a portion on level-up (bonus HP)
    party[idx].hp = clamp(party[idx].hp + hp_gain, 0, base_ptr.max_hp + party[idx].level * 5)
    party[idx].mp = clamp(party[idx].mp + mp_gain, 0, base_ptr.max_mp + party[idx].level * 2)
}

fn gain_exp(idx: i32, amount: i32) {
    if not party[idx].alive { return }
    party[idx].exp = party[idx].exp + amount
    while party[idx].exp >= exp_for_level(party[idx].level)
          and party[idx].level < MAX_LEVEL {
        party[idx].exp = party[idx].exp - exp_for_level(party[idx].level)
        level_up_stats(idx)
        b_msg_timer = 90    -- show level-up notice
    }
}
}
}

