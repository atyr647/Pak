fn draw_bar(x: i32, y: i32, w: i32, h: i32,
            cur: i32, max_val: i32, fillcol: u32) {
    fill_rect(x, y, w, h, 0x111111FF)
    if max_val > 0 {
        let fw: i32 = w * cur / max_val
