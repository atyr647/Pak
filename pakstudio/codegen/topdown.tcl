# codegen/topdown.tcl — .pakstudio (topdown genre) → .pk64 + pak.toml
#
# Generates a complete top-down RPG with:
#   • Tile-based world map with 4-dir player movement
#   • Turn-based battle system (encounter on contact / random step)
#   • Full stat engine: HP/MP/ATK/DEF/MAG/SPD
#   • EXP accumulation and level-up with per-stat growth
#   • Mob drops: gold + item drops (configurable rate)
#   • Skills with MP cost, elemental power, targeting
#   • Item system: consumables (heal HP/MP), key items
#   • Crafting system: station-based recipes, ingredient check + consume
#   • Party of up to 3 actors, 1-6 enemy types per encounter
#
# Architecture: a large static Pak engine is assembled from fixed blocks
# (structs, AI, render, battle loop) plus data-driven tables generated from
# the editor's database, quest, craft, and level records.

namespace eval codegen::topdown {}

# ── Entry point ───────────────────────────────────────────────────────────────

proc codegen::topdown::generate {doc} {
    return [dict create \
        "pak.toml"      [_pak_toml $doc] \
        "src/main.pk64" [_main_pk64 $doc] \
    ]
}

# ── pak.toml ──────────────────────────────────────────────────────────────────

proc codegen::topdown::_pak_toml {doc} {
    set m     [dict get $doc meta]
    set s     [dict get $doc settings]
    set name  [string tolower [regsub -all {\s+} [dict get $m name] "_"]]
    set title [dict get $m rom_title]
    set save  [dict get $s save_type]
    return "\[project\]
name = \"$name\"
rom_title = \"$title\"
save_type = \"$save\"

\[display\]
resolution = \"320x240\"
bit_depth = 16
framebuffers = 2

\[build\]
optimization = \"release\"
"
}

# ── Helpers: database access ──────────────────────────────────────────────────

proc codegen::topdown::_actors  {doc} { _db_list $doc actors  }
proc codegen::topdown::_enemies {doc} { _db_list $doc enemies }
proc codegen::topdown::_skills  {doc} { _db_list $doc skills  }
proc codegen::topdown::_items   {doc} { _db_list $doc items   }
proc codegen::topdown::_recipes {doc} {
    if {[dict exists $doc recipes]} { return [dict get $doc recipes] }
    return {}
}

proc codegen::topdown::_db_list {doc key} {
    if {[dict exists $doc database $key]} { return [dict get $doc database $key] }
    return {}
}

proc codegen::topdown::_df {rec key default} {
    if {[dict exists $rec $key] && [dict get $rec $key] ne ""} {
        return [dict get $rec $key]
    }
    return $default
}

# Convert a doc identifier to a safe Pak identifier
proc codegen::topdown::_id {s} {
    regsub -all {[^a-zA-Z0-9_]} [string tolower $s] "_"
}

# Clamp an integer field to a range
proc codegen::topdown::_int {rec key lo hi default} {
    set v [_df $rec $key $default]
    if {![string is integer -strict $v]} { set v $default }
    if {$v < $lo} { set v $lo }
    if {$v > $hi} { set v $hi }
    return $v
}

# ── Main source assembly ──────────────────────────────────────────────────────

proc codegen::topdown::_main_pk64 {doc} {
    set out {}
    lappend out [_header $doc]
    lappend out [_use_block]
    lappend out [_constants $doc]
    lappend out [_asset_decls $doc]
    lappend out [_type_defs]
    lappend out [_data_tables $doc]
    lappend out [_static_state $doc]
    lappend out [_map_data $doc]
    lappend out [_font_block]
    lappend out [_math_block]
    lappend out [_draw_block]
    lappend out [_world_block]
    lappend out [_battle_block]
    lappend out [_craft_block]
    lappend out [_ui_block]
    lappend out [_entry_block $doc]
    return [join $out "\n"]
}

# ── Header ────────────────────────────────────────────────────────────────────

proc codegen::topdown::_header {doc} {
    set name [dict get $doc meta name]
    return "-- $name — generated by PakStudio (top-down RPG)
-- Edit in PakStudio; re-generate to update.
"
}

proc codegen::topdown::_use_block {} {
    return {use n64.display
use n64.controller
use n64.rdpq
use n64.audio
}
}

# ── Constants ─────────────────────────────────────────────────────────────────

proc codegen::topdown::_constants {doc} {
    set actors  [_actors  $doc]
    set enemies [_enemies $doc]
    set skills  [_skills  $doc]
    set items   [_items   $doc]
    set recipes [_recipes $doc]

    set na [llength $actors];  if {$na < 1} { set na 1 }
    set ne [llength $enemies]; if {$ne < 1} { set ne 1 }
    set ns [llength $skills];  if {$ns < 1} { set ns 1 }
    set ni [llength $items];   if {$ni < 1} { set ni 1 }
    set nr [llength $recipes]; if {$nr < 1} { set nr 1 }

    # Count enemy skills
    set max_eskills 4

    # Levels from levels list
    set levels [dict get $doc levels]
    set nlev [llength $levels]; if {$nlev < 1} { set nlev 1 }

    # Map dimensions from first level
    set lev0 [lindex $levels 0]
    set mw 16; set mh 12
    if {[dict exists $lev0 width]}  { set mw [dict get $lev0 width]  }
    if {[dict exists $lev0 height]} { set mh [dict get $lev0 height] }
    if {$mw < 1} { set mw 16 }; if {$mh < 1} { set mh 12 }

    return "-- ── Constants ───────────────────────────────────────────────────────────────
const NUM_ACTORS:   i32 = $na
const NUM_ENEMIES:  i32 = $ne
const NUM_SKILLS:   i32 = $ns
const NUM_ITEMS:    i32 = $ni
const NUM_RECIPES:  i32 = $nr
const MAX_ESKILLS:  i32 = $max_eskills
const PARTY_SIZE:   i32 = 3
const INV_SIZE:     i32 = 64
const MAP_W:        i32 = $mw
const MAP_H:        i32 = $mh
const TILE_SZ:      i32 = 16
const SCREEN_W:     i32 = 320
const SCREEN_H:     i32 = 240
const MAX_LEVEL:    i32 = 99

-- EXP needed for next level: base * level^1.5 (approximated with integers)
const EXP_BASE:     i32 = 100

-- Battle constants
const BATTLE_ANIM_FRAMES: i32 = 20
const CRIT_MULT:    i32 = 15   -- critical multiplier / 10
const FLEE_CHANCE:  i32 = 40   -- % base flee chance

-- Phase enum indices (used as i32)
const PHASE_TITLE:    i32 = 0
const PHASE_WORLD:    i32 = 1
const PHASE_BATTLE:   i32 = 2
const PHASE_MENU:     i32 = 3
const PHASE_CRAFT:    i32 = 4
const PHASE_GAMEOVER: i32 = 5
const PHASE_WIN:      i32 = 6

-- Menu cursor ids
const MENU_ATTACK: i32 = 0
const MENU_SKILL:  i32 = 1
const MENU_ITEM:   i32 = 2
const MENU_RUN:    i32 = 3

-- Element ids
const ELEM_NONE:  i32 = 0
const ELEM_FIRE:  i32 = 1
const ELEM_ICE:   i32 = 2
const ELEM_BOLT:  i32 = 3
const ELEM_LIGHT: i32 = 4
const ELEM_DARK:  i32 = 5

-- Item kind ids
const ITEM_CONSUMABLE: i32 = 0
const ITEM_WEAPON:     i32 = 1
const ITEM_ARMOR:      i32 = 2
const ITEM_MATERIAL:   i32 = 3
const ITEM_KEY:        i32 = 4

-- Item effect ids
const FX_NONE:    i32 = 0
const FX_HEAL_HP: i32 = 1
const FX_HEAL_MP: i32 = 2
const FX_REVIVE:  i32 = 3
"
}

# ── Asset declarations ────────────────────────────────────────────────────────

proc codegen::topdown::_asset_decls {doc} {
    set lines {"-- ── Assets ──────────────────────────────────────────────────────────────────"}
    foreach role {player_walk enemy_idle npc_idle battle_bg title_bg} {
        if {[dict exists $doc assets sprites $role]
            && [dict get $doc assets sprites $role] ne ""} {
            lappend lines "asset spr_${role}: Sprite from \"sprites/${role}.png\""
        }
    }
    if {[dict exists $doc assets audio music]
        && [dict get $doc assets audio music] ne ""} {
        lappend lines "asset bgm: XMPlayer from \"audio/music.xm\""
    }
    foreach role {battle_start battle_win battle_lose cursor step} {
        if {[dict exists $doc assets audio $role]
            && [dict get $doc assets audio $role] ne ""} {
            lappend lines "asset sfx_$role: Wav from \"audio/${role}.wav\""
        }
    }
    lappend lines ""
    return [join $lines "\n"]
}

# ── Type definitions ──────────────────────────────────────────────────────────

proc codegen::topdown::_type_defs {} {
    return {-- ── Type Definitions ─────────────────────────────────────────────────────────

struct ActorBase {
    max_hp:  i32
    max_mp:  i32
    atk:     i32
    def:     i32
    mag:     i32
    spd:     i32
    -- stat growth per level (scaled *10, applied /10 at level-up)
    hp_grow: i32
    mp_grow: i32
    at_grow: i32
    df_grow: i32
    mg_grow: i32
    sp_grow: i32
}

struct EnemyDef {
    max_hp:    i32
    max_mp:    i32
    atk:       i32
    def:       i32
    mag:       i32
    spd:       i32
    exp:       i32
    gold:      i32
    drop_item: i32   -- -1 = none
    drop_rate: i32   -- 0-100 percent
    ai:        i32   -- 0=chase 1=erratic 2=ranged 3=boss 4=static
    touch_dmg: i32
    n_skills:  i32
    skills:    [4]i32
}

struct SkillDef {
    mp_cost: i32
    power:   i32
    element: i32
    target:  i32   -- 0=one_enemy 1=all_enemies 2=one_ally 3=all_allies 4=self
}

struct ItemDef {
    kind:   i32
    effect: i32
    power:  i32
    price:  i32
}

struct RecipeDef {
    station:    i32   -- 0=alchemy 1=forge 2=cooking 3=tailor 4=any
    n_inputs:   i32
    in_item:    [4]i32
    in_qty:     [4]i32
    out_item:   i32
    out_qty:    i32
}

-- Runtime actor (party member)
struct Actor {
    base_idx: i32    -- index into ACTOR_BASE
    level:    i32
    exp:      i32
    hp:       i32
    mp:       i32
    atk:      i32
    def:      i32
    mag:      i32
    spd:      i32
    alive:    bool
}

-- Live battle enemy slot
struct BattleEnemy {
    def_idx: i32
    hp:      i32
    alive:   bool
}

-- Player world position
struct WorldState {
    x:         i32
    y:         i32
    dir:       i32    -- 0=down 1=up 2=left 3=right
    step:      i32
    move_cool: i32
    steps_til_encounter: i32
}
}
}

# ── Data tables ───────────────────────────────────────────────────────────────

proc codegen::topdown::_data_tables {doc} {
    set out {}
    lappend out "-- ── Data Tables (generated from Database editor) ───────────────────────────"
    lappend out ""
    lappend out [_actor_table  $doc]
    lappend out [_enemy_table  $doc]
    lappend out [_skill_table  $doc]
    lappend out [_item_table   $doc]
    lappend out [_recipe_table $doc]
    return [join $out "\n"]
}

proc codegen::topdown::_actor_table {doc} {
    set actors [_actors $doc]
    if {[llength $actors] == 0} {
        # default hero
        set actors [list [dict create id hero name "Hero" level 1 hp 100 mp 30 \
                               atk 12 def 8 mag 6 spd 10 skills ""]]
    }
    set lines {}
    lappend lines "const ACTOR_BASE: \[[llength $actors]\]ActorBase = \["
    foreach a $actors {
        set hp  [_int $a hp  1 9999 100]
        set mp  [_int $a mp  0 9999  30]
        set atk [_int $a atk 0  999  12]
        set def [_int $a def 0  999   8]
        set mag [_int $a mag 0  999   6]
        set spd [_int $a spd 0  999  10]
        # growth: roughly 10% per level (stored *10, applied /10)
        lappend lines "    ActorBase \{ max_hp: $hp, max_mp: $mp, atk: $atk, def: $def, mag: $mag, spd: $spd,"
        lappend lines "               hp_grow: [expr {$hp/10+3}], mp_grow: [expr {$mp/10+1}],"
        lappend lines "               at_grow: 2, df_grow: 2, mg_grow: 2, sp_grow: 1 \},"
    }
    lappend lines "\]"
    return [join $lines "\n"]
}

proc codegen::topdown::_enemy_table {doc} {
    set enemies [_enemies $doc]
    if {[llength $enemies] == 0} {
        set enemies [list [dict create id goblin name "Goblin" hp 40 mp 0 \
                                atk 8 def 4 mag 0 spd 8 exp 20 gold 10 \
                                ai chase touch 2 skills ""]]
    }
    # build item id → index map for drop references
    set items [_items $doc]
    set item_idx {}
    set i 0
    foreach it $items { dict set item_idx [_df $it id ""] $i; incr i }

    set lines {}
    lappend lines "const ENEMIES: \[[llength $enemies]\]EnemyDef = \["
    foreach e $enemies {
        set hp  [_int $e hp  1 99999  40]
        set mp  [_int $e mp  0  9999   0]
        set atk [_int $e atk 0   999   8]
        set def [_int $e def 0   999   4]
        set mag [_int $e mag 0   999   0]
        set spd [_int $e spd 0   999   8]
        set exp [_int $e exp 0 99999  20]
        set gold [_int $e gold 0 99999 10]
        set tdmg [_int $e touch 0 999 2]

        # drop item
        set drop_id [_df $e drop_item ""]
        set drop_idx -1
        set drop_rate 0
        if {$drop_id ne "" && [dict exists $item_idx $drop_id]} {
            set drop_idx [dict get $item_idx $drop_id]
            set drop_rate [_int $e drop_rate 0 100 20]
        }

        # AI
        set ai_s [string tolower [_df $e ai "chase"]]
        set ai 0
        switch $ai_s {
            erratic { set ai 1 }
            ranged  { set ai 2 }
            boss    { set ai 3 }
            static  { set ai 4 }
        }

        # skills
        set skill_ids [split [_df $e skills ""] " "]
        set skill_ids [lsearch -all -inline -not $skill_ids ""]
        set nskills 0
        set sk_arr {-1, -1, -1, -1}

        # build skill name → index map
        set slist [_skills $doc]
        set skmap {}
        set si 0
        foreach sk $slist { dict set skmap [_df $sk id ""] $si; incr si }

        set sk_entries {}
        foreach sid $skill_ids {
            if {$nskills >= 4} break
            if {[dict exists $skmap $sid]} {
                lappend sk_entries [dict get $skmap $sid]
                incr nskills
            }
        }
        while {[llength $sk_entries] < 4} { lappend sk_entries -1 }
        set sk_arr [join $sk_entries ", "]

        lappend lines "    EnemyDef \{ max_hp: $hp, max_mp: $mp, atk: $atk, def: $def,"
        lappend lines "              mag: $mag, spd: $spd, exp: $exp, gold: $gold,"
        lappend lines "              drop_item: $drop_idx, drop_rate: $drop_rate,"
        lappend lines "              ai: $ai, touch_dmg: $tdmg,"
        lappend lines "              n_skills: $nskills, skills: \[$sk_arr\] \},"
    }
    lappend lines "\]"
    return [join $lines "\n"]
}

proc codegen::topdown::_skill_table {doc} {
    set skills [_skills $doc]
    if {[llength $skills] == 0} {
        set skills [list [dict create id fire name "Fire" mp 8 power 40 element fire target one_enemy]]
    }
    set elem_map {none 0 fire 1 ice 2 bolt 3 light 4 dark 5}
    set tgt_map  {one_enemy 0 all_enemies 1 one_ally 2 all_allies 3 self 4}
    set lines {}
    lappend lines "const SKILLS: \[[llength $skills]\]SkillDef = \["
    foreach sk $skills {
        set mp  [_int $sk mp    0 999  8]
        set pow [_int $sk power 0 9999 40]
        set el_s [string tolower [_df $sk element "none"]]
        set el [expr {[dict exists $elem_map $el_s] ? [dict get $elem_map $el_s] : 0}]
        set tg_s [string tolower [_df $sk target "one_enemy"]]
        set tg [expr {[dict exists $tgt_map $tg_s] ? [dict get $tgt_map $tg_s] : 0}]
        lappend lines "    SkillDef \{ mp_cost: $mp, power: $pow, element: $el, target: $tg \},"
    }
    lappend lines "\]"
    return [join $lines "\n"]
}

proc codegen::topdown::_item_table {doc} {
    set items [_items $doc]
    if {[llength $items] == 0} {
        set items [list \
            [dict create id potion name "Potion" kind consumable effect heal_hp power 50 price 50] \
            [dict create id ether  name "Ether"  kind consumable effect heal_mp power 20 price 80]]
    }
    set kind_map  {consumable 0 weapon 1 armor 2 material 3 key 4}
    set fx_map    {none 0 heal_hp 1 heal_mp 2 atk 0 def 0 revive 3}
    set lines {}
    lappend lines "const ITEMS: \[[llength $items]\]ItemDef = \["
    foreach it $items {
        set kd_s [string tolower [_df $it kind "consumable"]]
        set kd [expr {[dict exists $kind_map $kd_s] ? [dict get $kind_map $kd_s] : 0}]
        set fx_s [string tolower [_df $it effect "none"]]
        set fx [expr {[dict exists $fx_map $fx_s] ? [dict get $fx_map $fx_s] : 0}]
        set pow   [_int $it power 0 9999 50]
        set price [_int $it price 0 99999 50]
        lappend lines "    ItemDef \{ kind: $kd, effect: $fx, power: $pow, price: $price \},"
    }
    lappend lines "\]"
    return [join $lines "\n"]
}

proc codegen::topdown::_recipe_table {doc} {
    set recipes [_recipes $doc]
    if {[llength $recipes] == 0} {
        return "const RECIPES: \[1\]RecipeDef = \[
    RecipeDef \{ station: 4, n_inputs: 0, in_item: \[0,0,0,0\], in_qty: \[0,0,0,0\], out_item: 0, out_qty: 0 \},
\]"
    }
    # build item id → index map
    set items [_items $doc]
    set item_idx {}
    set i 0
    foreach it $items { dict set item_idx [_df $it id ""] $i; incr i }

    set stn_map {alchemy 0 forge 1 cooking 2 tailor 3 any 4}
    set lines {}
    lappend lines "const RECIPES: \[[llength $recipes]\]RecipeDef = \["
    foreach r $recipes {
        set stn_s [string tolower [_df $r station "any"]]
        set stn [expr {[dict exists $stn_map $stn_s] ? [dict get $stn_map $stn_s] : 4}]

        # parse inputs: list of {item qty} dicts
        set inputs [_df $r inputs ""]
        set in_items {0 0 0 0}; set in_qtys {0 0 0 0}; set nin 0
        if {[llength $inputs] > 0 && [dict exists [lindex $inputs 0] item]} {
            # structured list from save_to_doc
            foreach inp $inputs {
                if {$nin >= 4} break
                set iid [_df $inp item ""]
                set qty [_df $inp qty 1]
                set idx [expr {[dict exists $item_idx $iid] ? [dict get $item_idx $iid] : 0}]
                lset in_items $nin $idx
                lset in_qtys  $nin $qty
                incr nin
            }
        } elseif {[string is list $inputs]} {
            # fallback: plain list of item ids
            foreach iid $inputs {
                if {$nin >= 4} break
                if {[dict exists $item_idx $iid]} {
                    lset in_items $nin [dict get $item_idx $iid]
                    lset in_qtys  $nin 1
                    incr nin
                }
            }
        }

        # output
        set output [_df $r output ""]
        set out_item 0; set out_qty 1
        if {[dict size $output] > 0 && [dict exists $output item]} {
            set oid [dict get $output item]
            set out_qty [_df $output qty 1]
            if {[dict exists $item_idx $oid]} { set out_item [dict get $item_idx $oid] }
        }

        lappend lines "    RecipeDef \{ station: $stn, n_inputs: $nin,"
        lappend lines "              in_item: \[[join $in_items ,]\], in_qty: \[[join $in_qtys ,]\],"
        lappend lines "              out_item: $out_item, out_qty: $out_qty \},"
    }
    lappend lines "\]"
    return [join $lines "\n"]
}

# ── Static state ──────────────────────────────────────────────────────────────

proc codegen::topdown::_static_state {doc} {
    set actors [_actors $doc]
    set na [llength $actors]; if {$na < 1} { set na 1 }
    set party_sz [expr {$na < 3 ? $na : 3}]

    # Build initial party HP/MP/level arrays
    set hp_init {}; set mp_init {}; set lv_init {}
    for {set i 0} {$i < $party_sz} {incr i} {
        set a [lindex $actors $i]
        lappend hp_init [_int $a hp 1 9999 100]
        lappend mp_init [_int $a mp 0 9999  30]
        lappend lv_init [_int $a level 1 99 1]
    }
    while {[llength $hp_init] < 3} { lappend hp_init 0 }
    while {[llength $mp_init] < 3} { lappend mp_init 0 }
    while {[llength $lv_init] < 3} { lappend lv_init 1 }

    return "-- ── Runtime State ───────────────────────────────────────────────────────────

-- Game phase
static phase: i32 = PHASE_TITLE

-- Party
static party: \[3\]Actor = \[
    Actor \{ base_idx: 0, level: [lindex $lv_init 0], exp: 0,
           hp: [lindex $hp_init 0], mp: [lindex $mp_init 0],
           atk: 0, def: 0, mag: 0, spd: 0, alive: true \},
    Actor \{ base_idx: [expr {$party_sz > 1 ? 1 : 0}], level: [lindex $lv_init 1], exp: 0,
           hp: [lindex $hp_init 1], mp: [lindex $mp_init 1],
           atk: 0, def: 0, mag: 0, spd: 0, alive: [expr {$party_sz > 1 ? "true" : "false"}] \},
    Actor \{ base_idx: [expr {$party_sz > 2 ? 2 : 0}], level: [lindex $lv_init 2], exp: 0,
           hp: [lindex $hp_init 2], mp: [lindex $mp_init 2],
           atk: 0, def: 0, mag: 0, spd: 0, alive: [expr {$party_sz > 2 ? "true" : "false"}] \},
\]

-- Inventory: item counts indexed by item id
static inventory: \[INV_SIZE\]i32 = \[0; INV_SIZE\]

-- Gold
static gold: i32 = 50

-- World
static world: WorldState = WorldState \{
    x: 4, y: 4, dir: 0, step: 0, move_cool: 0,
    steps_til_encounter: 15
\}

-- Battle state
static b_enemies:   \[4\]BattleEnemy = undefined
static b_n_enemies: i32 = 0
static b_turn:      i32 = 0    -- 0=player choose, 1=player anim, 2=enemy turn
static b_menu:      i32 = MENU_ATTACK
static b_target:    i32 = 0
static b_skill_sel: i32 = 0
static b_item_sel:  i32 = 0
static b_msg:       \[48\]u8 = \[0; 48\]
static b_msg_timer: i32 = 0
static b_exp_gain:  i32 = 0
static b_gold_gain: i32 = 0
static b_anim:      i32 = 0
static b_actor_turn: i32 = 0   -- which party member acts next

-- Crafting state
static craft_sel:    i32 = 0
static craft_result: \[32\]u8 = \[0; 32\]
static craft_timer:  i32 = 0

-- Title / menu
static title_sel: i32 = 0
static frame:     i32 = 0
"
}

# ── Map data ──────────────────────────────────────────────────────────────────

proc codegen::topdown::_map_data {doc} {
    set levels [dict get $doc levels]
    set lev0 [lindex $levels 0]
    set mw 16; set mh 12
    if {[dict exists $lev0 width]}  { set mw [dict get $lev0 width]  }
    if {[dict exists $lev0 height]} { set mh [dict get $lev0 height] }
    if {$mw < 1} { set mw 16 }; if {$mh < 1} { set mh 12 }

    # Build flat tile array from level data
    set tiles {}
    if {[dict exists $lev0 tiles]} {
        set tiles [dict get $lev0 tiles]
    }
    set ncells [expr {$mw * $mh}]
    set arr {}
    for {set i 0} {$i < $ncells} {incr i} {
        if {$i < [llength $tiles]} {
            lappend arr [lindex $tiles $i]
        } else {
            lappend arr 0
        }
    }

    # Format as rows
    set lines {}
    lappend lines "-- ── Map Data ────────────────────────────────────────────────────────────────"
    lappend lines "const MAP: \[$ncells\]u8 = \["
    for {set row 0} {$row < $mh} {incr row} {
        set rowdata {}
        for {set col 0} {$col < $mw} {incr col} {
            lappend rowdata [lindex $arr [expr {$row*$mw+$col}]]
        }
        lappend lines "    [join $rowdata {, }],"
    }
    lappend lines "\]"
    lappend lines ""

    lappend lines {fn tile_at(tx: i32, ty: i32) -> u8 {
    if tx < 0 or ty < 0 or tx >= MAP_W or ty >= MAP_H { return 1 }
    return MAP[ty * MAP_W + tx] as u8
}

fn tile_solid(t: u8) -> bool {
    return t == 1 or t == 2 or t == 5
}

fn tile_encounter(t: u8) -> bool {
    -- grass and floor tiles can have random encounters
    return t == 0 or t == 3
}
}
    return [join $lines "\n"]
}

