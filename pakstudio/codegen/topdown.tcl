}

-- Tile color lookup
fn tile_color(t: u8) -> u32 {
    match t as i32 {
        0 => return 0x4A7A30FF   -- grass
        1 => return 0x606060FF   -- wall
        2 => return 0x808080FF   -- stone
        3 => return 0x7A6040FF   -- dirt/floor
        4 => return 0x2060B0FF   -- water
        5 => return 0x505060FF   -- road
        6 => return 0x604020FF   -- chest/item tile
        _ => return 0x303030FF
