# tcl/headergen.tcl — generate C header files from Pak module declarations.
# Reuses pak::Codegen's gen_struct /
# gen_enum / gen_variant / gen_type / gen_array_decl, exactly as the Python
# headergen reuses the Python Codegen.

set _hghere [file dirname [file normalize [info script]]]
source [file join $_hghere codegen.tcl]

namespace eval pak {}
if {[info exists ::pak::_headergen_loaded]} { return }
set ::pak::_headergen_loaded 1

proc pak::module_to_guard {module_path} {
    # PAKMOD_ prefix avoids colliding with C stdlib header guards.
    return "PAKMOD_[string toupper [string map {. _} $module_path]]_H"
}
proc pak::module_to_filename {module_path} {
    # pakmod_ prefix keeps generated headers from shadowing C stdlib headers
    # (module math -> pakmod_math.h, not math.h) and the runtime's pak_*.h.
    return "pakmod_[string map {. _} $module_path].h"
}

proc pak::generate_header {program module_path} {
    set guard [pak::module_to_guard $module_path]
    set cg [pak::Codegen new]
    $cg seed_enums $program

    set lines [list \
        "/* Generated by Pak Compiler - $module_path */" \
        "#ifndef $guard" \
        "#define $guard" \
        "" \
        "#include <stdint.h>" \
        "#include <stdbool.h>" \
        "" \
    ]

    # Type declarations (structs, enums, variants)
    foreach decl [pak::items [pak::nfield $program decls]] {
        switch -- [pak::kindof $decl] {
            StructDecl  { lappend lines [$cg gen_struct $decl] ""  }
            EnumDecl    { lappend lines [$cg gen_enum $decl] ""    }
            VariantDecl { lappend lines [$cg gen_variant $decl] "" }
        }
    }

    # Function forward declarations
    foreach decl [pak::items [pak::nfield $program decls]] {
        if {[pak::kindof $decl] eq "FnDecl"} {
            lappend lines [pak::_fn_forward_decl $cg $decl $module_path]
        }
    }

    lappend lines "" "#endif /* $guard */"
    set out [join $lines "\n"]
    $cg destroy
    return $out
}

proc pak::_fn_forward_decl {cg fn module_path} {
    set ret [$cg gen_type [pak::nfield $fn ret_type]]
    set params {}
    foreach p [pak::items [pak::nfield $fn params]] {
        set pt [pak::nfield $p type]
        if {[pak::kindof $pt] eq "TypeArray"} {
            lappend params [$cg gen_array_decl [pak::fval $p name] $pt]
        } else {
            lappend params "[$cg gen_type $pt] [pak::fval $p name]"
        }
    }
    set param_str [expr {[llength $params] > 0 ? [join $params ", "] : "void"}]
    return "$ret [pak::fval $fn name]($param_str);"
}

proc pak::collect_module_includes {program all_modules} {
    set includes {}
    foreach decl [pak::items [pak::nfield $program decls]] {
        if {[pak::kindof $decl] eq "UseDecl"} {
            set path [pak::fval $decl path]
            if {[dict exists $all_modules $path]} {
                lappend includes "#include \"[dict get $all_modules $path]\""
            }
        }
    }
    return $includes
}
