-- Driver for tcl/tools/rdp_test.tcl. Every call here has its resulting RDP
-- command words asserted against the hardware encoding, by running the
-- runtime's own MIPS code in the simulator and reading back the display list.
entry {
    rdpq.init()
    rdpq.attach(0xA0200000)
    rdpq.set_mode_fill(0xFF0000FF)
    rdpq.fill_rectangle(0, 0, 320, 240)
    rdpq.fill_rectangle(16, 32, 48, 64)
    rdpq.set_scissor(8, 8, 312, 232)
    rdpq.set_mode_copy()
    rdpq.set_texture_image(0xA0300000, 0, 2, 32)
    rdpq.set_tile(0, 0, 2, 8, 0, 0)
    rdpq.load_tile(0, 0, 0, 32, 32)
    rdpq.set_tile_size(0, 0, 0, 32, 32)
    rdpq.load_block(0, 0, 0, 512, 0x100)
    rdpq.load_tlut(0, 0, 16)
    rdpq.texture_rectangle(0, 100, 50, 132, 82, 0, 0)
    rdpq.texture_rectangle_flip(0, 100, 50, 132, 82, 0, 0)
    rdpq.set_mode_standard()
    rdpq.set_prim_color(0x1122_33FF)
    rdpq.set_blend_color(0x4455_66FF)
    rdpq.set_fog_color(0x7788_99AA)
    rdpq.set_env_color(0xBBCC_DDFF)
    rdpq.set_prim_depth(0x7FFF, 0)
    rdpq.triangle(10, 10, 100, 20, 40, 90)
    rdpq.triangle_z(10, 10, 0, 100, 20, 1000, 40, 90, 8000)
    rdpq.set_tile_mask(0, 0, 2, 8, 0, 0, 2, 2, 5, 5)
    rdpq.triangle_tex(0, 16, 16, 0, 0, 48, 16, 32, 0, 16, 48, 0, 32)
    rdpq.clear_z()
    rdpq.set_mode_standard_z()
    rdpq.triangle_shade(10, 10, 0xFF0000FF, 100, 20, 0x00FF00FF, 40, 90, 0x0000FFFF)
    rdpq.triangle_shade_z(10, 10, 0xFFFFFFFF, 0, 100, 20, 0xFFFFFFFF, 1000, 40, 90, 0xFFFFFFFF, 8000)
    rdpq.triangle_shade_tex(0, 16, 16, 0xFF0000FF, 0, 0, 48, 16, 0x00FF00FF, 32, 0, 16, 48, 0x0000FFFF, 0, 32)
    rdpq.set_tri_z(0, 1000, 8000)
    rdpq.triangle_shade_tex_z(0, 16, 16, 0xFFFFFFFF, 0, 0, 48, 16, 0xFFFFFFFF, 32, 0, 16, 48, 0xFFFFFFFF, 0, 32)
    rdpq.triangle_tex_z(0, 16, 16, 0, 0, 48, 16, 32, 0, 16, 48, 0, 32)
    rdpq.sync_pipe()
    rdpq.sync_tile()
    rdpq.sync_load()
    rdpq.detach_show()
}
