-- Runs a MULTIPLY-ACCUMULATE task on the RSP and checks the answer.
--
-- The microcode is tcl/tests/ares/rsp_vecmac.S, assembled by tcl/n64enc.tcl:
-- VMUDN starts the 48-bit accumulator, VMADH adds into its top 32 bits, and
-- VSAR reads the mid slice back out -- the two-instruction shape every real
-- transform/lighting microcode chains across a whole matrix.
-- tcl/tools/ares_test.tcl re-assembles the .S and refuses to run if these
-- words have drifted from it, same contract rsp.pk64 and rsp_vecadd.pk64
-- have for their own microcode.
--
-- Green means VMUDN, VMADH and VSAR all did the right thing across all 8
-- lanes. If it never starts, sp.wait() never returns and the screen stays
-- black.

use n64.sp

const FB_PIXELS: i32 = 76800
const GREEN: u16 = 0x07C1
const RED: u16 = 0xF801

@aligned(16)
static ucode: [8]u32 = [
    0xC8012000, 0xC8022001, 0x4A0208C6, 0x4A0208CF, 0x4B24211D, 0xE8042002,
    0x0000000D, 0x00000000
]

-- v1 = {2,3,4,5,6,7,8,9}.
@aligned(16)
static v1: [8]u16 = [2, 3, 4, 5, 6, 7, 8, 9]

-- v2 = {3,3,3,3,3,3,3,3}.
@aligned(16)
static v2: [8]u16 = [3, 3, 3, 3, 3, 3, 3, 3]

-- Expected ACCM after VMUDN then VMADH. VMUDN's own product (2*3=6, ...) is
-- small enough to land entirely in the LOW slice (ACCM is 0 going into
-- VMADH), so VMADH's product becomes the whole of ACCM -- not double it:
-- v1[n] * v2[n], once.
@aligned(16)
static want: [8]u16 = [6, 9, 12, 15, 18, 21, 24, 27]

@aligned(16)
static got: [8]u16 = [0, 0, 0, 0, 0, 0, 0, 0]

fn fill(fb: u32, px: u16) {
    let mut i: i32 = 0
    while i < FB_PIXELS {
        let p: *volatile u16 = (fb + (i * 2) as u32) as *volatile u16
        *p = px
        i = i + 1
    }
}

entry {
    display.init(0, 2, 3, 0, 1)

    sp.init()
    sp.load_ucode(&ucode[0] as u32, 32)
    sp.load_data(&v1[0] as u32, 0, 16)
    sp.load_data(&v2[0] as u32, 16, 16)
    sp.run(0)
    sp.wait()
    sp.read_data(&got[0] as u32, 32, 16)

    let fb: u32 = display.get()
    let mut all_ok: bool = true
    let mut i: i32 = 0
    while i < 8 {
        if got[i] != want[i] {
            all_ok = false
        }
        i = i + 1
    }
    if all_ok {
        fill(fb, GREEN)
    } else {
        fill(fb, RED)
    }
    loop {
        display.show(fb)
    }
}
