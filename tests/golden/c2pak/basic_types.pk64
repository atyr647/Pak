struct Vec2 { x: f32, y: f32 }

struct Vec3 { x: f32, y: f32, z: f32 }

enum Direction {
    up,
    down,
    left,
    right,
}

enum State {
    idle,
    active,
    dead,
}

struct Player {
    pos: Vec2,
    hp: i32,
    level: u8,
    facing: Direction,
    state: State,
}

fn vec2_add(a: Vec2, b: Vec2) -> Vec2 {
    let result: Vec2 = undefined
    result.x = a.x + b.x
    result.y = a.y + b.y
    return result
}

entry {
