-- Transpiled from C by pak convert

struct Vec2 { x: f32, y: f32 }

struct Player {
    pos: Vec2,
    vel: Vec2,
    hp: i32,
    score: i32,
}

impl Vec2 {
    fn init(self: *mut Vec2, x: f32, y: f32) {
        self.x = x
        self.y = y
    }

    fn add(self: *mut Vec2, other: Vec2) -> Vec2 {
        let result: Vec2 = undefined
        result.x = self.x + other.x
        result.y = self.y + other.y
        return result
    }

    fn length(self: *mut Vec2) -> f32 {
        return self.x * self.x + self.y * self.y
    }

    fn scale(self: *mut Vec2, s: f32) {
        self.x *= s
        self.y *= s
    }
}

impl Player {
    fn init(self: *mut Player, x: f32, y: f32) {
        self.pos.init(x, y)
        self.vel.init(0.0, 0.0)
        self.hp = 100
        self.score = 0
    }

    fn take_damage(self: *mut Player, dmg: i32) {
        self.hp -= dmg
        if self.hp < 0 {
            self.hp = 0
        }
    }

    fn is_alive(self: *mut Player) -> i32 {
        return self.hp > 0
    }

    fn add_score(self: *mut Player, pts: i32) {
        self.score += pts
    }
}
