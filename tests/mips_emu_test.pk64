-- Minimal MIPS emulator test: pure arithmetic, no N64 hardware
-- Tests that the MIPS backend generates correct executable code.

fn add(a: i32, b: i32) -> i32 {
    return a + b
}

fn sub(a: i32, b: i32) -> i32 {
    return a - b
}

fn mul_by_two(x: i32) -> i32 {
    return x + x
}

fn factorial(n: i32) -> i32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn gcd(a: i32, b: i32) -> i32 {
    loop {
        if b == 0 { break }
        let t: i32 = b
        b = a - (a / b) * b
        a = t
    }
    return a
}

entry {
    -- Expected: 7, 297, 14, 120, 12
    let r0: i32 = add(3, 4)
    let r1: i32 = add(100, 197)
    let r2: i32 = mul_by_two(7)
    let r3: i32 = factorial(5)
    let r4: i32 = gcd(48, 36)
}
