-- A float with no integer part. The lexer set is_float on the leading '.'
-- and then skipped the loop that reads the digits, so `.14` lexed as FLOAT
-- "." followed by INT "14". `pak check` accepted it and codegen died turning
-- "." into bits. Found by tcl/tools/fuzz_test.tcl.
static sink: f32 = 0.0

entry {
    let a: f32 = .14
    let b: f32 = .5f
    let c: f32 = 0.25
    sink = a + b + c
}
